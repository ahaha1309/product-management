mixin table-tree(items, level=1, urlPrefix="category-product")
  if items && items.length
    each Item in items
      - const prefix = Array(level + 1).join('— ')
      tr(class="hover:bg-surface-50 transition-colors group")
        td(class="px-4 py-3 text-center")
          input(type="checkbox" name="id" value=Item.id multi-status class="rounded border-surface-300 text-brand-500 focus:ring-brand-500/20")

        td(class="px-4 py-3 text-surface-500 font-medium") #{Item.count}

        td(class="px-4 py-3")
          img(src=Item.thumbnail alt=Item.title class="w-12 h-12 rounded-lg object-cover border border-surface-200 shadow-sm")

        td(class="px-4 py-3")
          div(class=`font-semibold text-surface-900 ${level > 1 ? 'text-surface-600' : ''}`)
            span(class="text-surface-300 font-mono mr-1") #{prefix}
            | #{Item.title}

        td(class="px-4 py-3 text-center")
          input(type="number" name="position" value=Item.position min="1" class="w-16 px-2 py-1 text-center bg-white border border-surface-200 rounded-lg text-sm focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 outline-none transition-all")

        td(class="px-4 py-3 text-center")
          a(
            href="javascript:;"
            button-change-status
            data-status=Item.status
            button-id=Item.id
            class=`px-3 py-1 text-xs font-semibold rounded-full border transition-colors inline-block ${Item.status=="active" ? "bg-emerald-50 text-emerald-600 border-emerald-200 hover:bg-emerald-100" : "bg-rose-50 text-rose-600 border-rose-200 hover:bg-rose-100"}`
          ) #{Item.status=="active" ? "Hoạt động" : "Tạm dừng"}

        td(class="px-4 py-3 text-right")
          div(class="flex items-center justify-end gap-1 opacity-0 group-hover:opacity-100 transition-opacity")
            a(href=`${prefixAdmin}/${urlPrefix}/detail/${Item.id}` class="w-8 h-8 flex items-center justify-center rounded-lg bg-surface-100 text-surface-600 hover:bg-surface-200 hover:text-brand-600 transition-colors" title="Chi tiết")
              i.bi.bi-eye
            if(role.permission.includes('products-category_edit') || role.permission.includes('articles-category_edit'))
              a(href=`${prefixAdmin}/${urlPrefix}/edit/${Item.id}` class="w-8 h-8 flex items-center justify-center rounded-lg bg-surface-100 text-surface-600 hover:bg-amber-100 hover:text-amber-600 transition-colors" title="Sửa")
                i.bi.bi-pencil-square
            if(role.permission.includes('products-category_delete') || role.permission.includes('articles-category_delete'))
              button(button-change-activity="delete" btn-id=Item.id class="w-8 h-8 flex items-center justify-center rounded-lg bg-surface-100 text-surface-600 hover:bg-rose-100 hover:text-rose-600 transition-colors" title="Xóa")
                i.bi.bi-trash

      if Item.children && Item.children.length > 0
        +table-tree(Item.children, level + 1, urlPrefix)