mixin select-tree(categories, level=1,parent_id='')
  each item in categories
    - const prefix= Array(level+1).join('--')
    if(item.children && item.children.length > 0)
      option(value="" disabled style="color:#aaa;font-style:italic") #{prefix} #{item.title} [Nhóm]
      +select-tree(item.children, level + 1,parent_id)
    else
      option(value=item._id selected=(item._id == parent_id ? true :false)) #{prefix} #{item.title}