mixin pagination(pagination)
  nav
    ul.pagination.justify-content-center
      if pagination.currentPage > 1
        li.page-item
          a.page-link(href='#' button-pagination=`1`) &laquo;
      li.page-item
        a.page-link(href='#' button-pagination=`${pagination.currentPage > 1 ? pagination.currentPage - 1 : pagination.totalPage}`) &lt;
      
      - var startPage = Math.max(1, pagination.currentPage - 2)
      - var endPage = Math.min(pagination.totalPage, startPage + 4)
      - if (endPage - startPage < 4) startPage = Math.max(1, endPage - 4)
      
      - for(var i = startPage; i <= endPage; i++)
        li(class=`page-item ${pagination.currentPage == i ? "active" : ""}`)
          a.page-link(href='#' button-pagination=`${i}`) #{i}
          
      li.page-item
        a.page-link(href='#' button-pagination=`${pagination.currentPage < pagination.totalPage ? pagination.currentPage + 1 : 1}`) &gt;
      if pagination.currentPage < pagination.totalPage
        li.page-item
          a.page-link(href='#' button-pagination=`${pagination.totalPage}`) &raquo;