extends ../../layout/default.pug
include ../../mixins/select-tree.pug

block main
  include ../../mixins/alert.pug
  +alert-error(messages.error)
  
  if(roles.length === 0)
    div(class="bg-amber-50 border border-amber-200 text-amber-700 p-4 rounded-xl flex items-center gap-3 mb-6 max-w-3xl mx-auto")
      i.bi.bi-exclamation-triangle-fill.text-xl
      div
        p(class="font-bold") Cảnh báo
        p(class="text-sm") Chưa có vai trò nào trong hệ thống. Bạn nên tạo nhóm quyền trước khi thêm tài khoản.
        
  if(role.permission.includes('accounts_create'))
    div(class="max-w-3xl mx-auto")
      //- Header
      div(class="flex items-center justify-between mb-6")
        div(class="flex items-center gap-3")
          a(href=`${prefixAdmin}/accounts` class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-surface-200 text-surface-600 hover:bg-surface-50 hover:text-brand-600 transition-colors shadow-sm")
            i.bi.bi-arrow-left.text-lg
          h1(class="text-2xl font-bold text-surface-900 tracking-tight") Thêm mới tài khoản
        
        button(type="submit" form="create-account-form" class="px-5 py-2.5 bg-brand-500 hover:bg-brand-600 text-white text-sm font-semibold rounded-xl shadow-lg shadow-brand-500/30 transition-all active:scale-95 flex items-center gap-2")
          i.bi.bi-check2-circle.text-lg
          | Tạo tài khoản

      form(id="create-account-form" action=`${prefixAdmin}/accounts/create` method="POST" enctype='multipart/form-data' class="space-y-6")
        
        //- General Info
        div(class="bg-white rounded-2xl border border-surface-200 shadow-sm p-6")
          h2(class="text-base font-bold text-surface-900 mb-5 pb-3 border-b border-surface-100 flex items-center gap-2")
            i.bi.bi-person-vcard.text-brand-500
            | Thông tin cá nhân
            
          div(class="grid grid-cols-1 md:grid-cols-2 gap-5")
            div(class="md:col-span-2")
              label(class="block text-sm font-semibold text-surface-700 mb-1.5") Họ và tên <span class="text-rose-500">*</span>
              input(type="text" name="fullname" placeholder="Nhập họ tên đầy đủ" required class="w-full bg-surface-50 border border-surface-200 text-surface-900 text-sm rounded-xl focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 block px-4 py-3 transition-all outline-none")
            
            div
              label(class="block text-sm font-semibold text-surface-700 mb-1.5") Email <span class="text-rose-500">*</span>
              input(type="email" name="email" placeholder="Nhập địa chỉ email" required class="w-full bg-surface-50 border border-surface-200 text-surface-900 text-sm rounded-xl focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 block px-4 py-3 transition-all outline-none")
              
            div
              label(class="block text-sm font-semibold text-surface-700 mb-1.5") Số điện thoại <span class="text-rose-500">*</span>
              input(type="text" name="phone" placeholder="Nhập số điện thoại" required class="w-full bg-surface-50 border border-surface-200 text-surface-900 text-sm rounded-xl focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 block px-4 py-3 transition-all outline-none")

        //- Security & Permissions
        div(class="bg-white rounded-2xl border border-surface-200 shadow-sm p-6")
          h2(class="text-base font-bold text-surface-900 mb-5 pb-3 border-b border-surface-100 flex items-center gap-2")
            i.bi.bi-shield-lock.text-brand-500
            | Bảo mật & Phân quyền
            
          div(class="space-y-5")
            div
              label(class="block text-sm font-semibold text-surface-700 mb-1.5") Mật khẩu <span class="text-rose-500">*</span>
              div(class="relative")
                input(type="password" name="password" placeholder="Tạo mật khẩu an toàn" required class="w-full bg-surface-50 border border-surface-200 text-surface-900 text-sm rounded-xl focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 block px-4 py-3 transition-all outline-none")
                i.bi.bi-key.absolute.right-4.top-1.translate-y-2.text-surface-400
                
            div
              label(class="block text-sm font-semibold text-surface-700 mb-1.5") Nhóm quyền
              div(class="relative")
                select(name="roleId" id="roleId" class="w-full appearance-none bg-surface-50 border border-surface-200 text-surface-900 text-sm rounded-xl focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 block px-4 py-3 transition-all outline-none cursor-pointer")
                  option(value="") -- Chọn vai trò quản trị --
                  each roleItem in roles
                    option(value=roleItem._id) #{roleItem.title}
                i.bi.bi-chevron-down.absolute.right-4.top-1.translate-y-2.text-surface-400.pointer-events-none

        //- Avatar & Status
        div(class="grid grid-cols-1 md:grid-cols-2 gap-6")
          div(class="bg-white rounded-2xl border border-surface-200 shadow-sm p-6")
            h2(class="text-base font-bold text-surface-900 mb-5 pb-3 border-b border-surface-100 flex items-center gap-2")
              i.bi.bi-image.text-brand-500
              | Ảnh đại diện
              
            div(class="space-y-4" upload-image)
              div(class="relative border-2 border-dashed border-surface-200 rounded-xl bg-surface-50 p-6 text-center hover:bg-surface-100 transition-colors group cursor-pointer")
                input(type="file" name="thumbnail" accept="image/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" upload-image-input)
                i(class="bi bi-cloud-arrow-up text-4xl text-brand-400 mb-2 group-hover:scale-110 transition-transform inline-block")
                p(class="text-sm font-medium text-surface-700") Click tải ảnh
              
              div(class="relative hidden bg-white border border-surface-200 p-2 rounded-xl" id="image-preview-container")
                img(src="" class="w-full h-32 object-cover rounded-lg" upload-image-preview)
                button(type="button" class="absolute top-4 right-4 w-8 h-8 flex items-center justify-center bg-rose-500 text-white rounded-full hover:bg-rose-600 shadow-md transition-colors" close-image-upload title="Xóa ảnh")
                  i.bi.bi-x-lg.text-sm

          div(class="bg-white rounded-2xl border border-surface-200 shadow-sm p-6")
            h2(class="text-base font-bold text-surface-900 mb-5 pb-3 border-b border-surface-100 flex items-center gap-2")
              i.bi.bi-toggle-on.text-brand-500
              | Trạng thái
              
            div(class="flex flex-col gap-4 mt-6")
              label(class="flex items-center gap-3 cursor-pointer p-3 border border-surface-200 rounded-xl hover:bg-surface-50 transition-colors")
                input(type="radio" name="status" value="active" checked class="w-5 h-5 text-brand-500 bg-white border-surface-300 focus:ring-brand-500")
                div
                  span(class="text-sm text-surface-900 font-bold block") Hoạt động
                  span(class="text-xs text-surface-500") Cho phép đăng nhập hệ thống
                  
              label(class="flex items-center gap-3 cursor-pointer p-3 border border-surface-200 rounded-xl hover:bg-surface-50 transition-colors")
                input(type="radio" name="status" value="inactive" class="w-5 h-5 text-rose-500 bg-white border-surface-300 focus:ring-rose-500")
                div
                  span(class="text-sm text-surface-900 font-bold block") Khóa tài khoản
                  span(class="text-xs text-surface-500") Tạm thời chặn quyền truy cập

  else
    div(class="bg-rose-50 border border-rose-200 text-rose-600 p-6 rounded-2xl flex flex-col items-center justify-center text-center mt-10 max-w-md mx-auto")
      i.bi.bi-shield-lock.text-4xl.mb-3
      h2(class="text-lg font-bold mb-1") Không có quyền truy cập
      p(class="text-sm") Bạn không được cấp quyền để tạo tài khoản mới.

  script(src='/admin/js/product.js')
  script.
    document.querySelector('[upload-image-input]').addEventListener('change', function() {
      const file = this.files[0];
      const previewContainer = document.getElementById('image-preview-container');
      if (file) previewContainer.classList.remove('hidden');
    });
    document.querySelector('[close-image-upload]').addEventListener('click', function() {
      const previewContainer = document.getElementById('image-preview-container');
      previewContainer.classList.add('hidden');
      document.querySelector('[upload-image-preview]').src = '';
      document.querySelector('[upload-image-input]').value = '';
    });