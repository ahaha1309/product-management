extends ../../layout/default.pug 

block main 
  include ../../mixins/alert.pug
  +alert-success(messages.success)
  
  div(class="max-w-7xl mx-auto space-y-6")
    //- Header
    div(class="flex flex-col md:flex-row md:items-center justify-between gap-4")
      div
        h1(class="text-2xl font-bold text-surface-900 tracking-tight") Quản lý Tài khoản Admin
        p(class="text-surface-500 text-sm mt-1") Quản trị viên hệ thống và phân quyền truy cập.
      
      if(role.permission.includes('accounts_create'))
        a(href=`${prefixAdmin}/accounts/create` class="inline-flex items-center gap-2 px-4 py-2.5 bg-brand-500 hover:bg-brand-600 text-white text-sm font-semibold rounded-xl shadow-lg shadow-brand-500/30 transition-all active:scale-95 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-brand-500 focus-visible:ring-offset-2")
          i.bi.bi-person-plus-fill.text-lg
          | Thêm tài khoản mới

    if(role.permission.includes('accounts_view'))
      //- Filter & Search
      div(class="bg-white p-5 rounded-2xl border border-surface-200 shadow-sm space-y-4")
        div(class="grid grid-cols-1 md:grid-cols-12 gap-4")
          div(class="md:col-span-7 lg:col-span-8 flex flex-col justify-center")
            label(class="text-xs font-semibold text-surface-500 uppercase tracking-wider mb-2") Trạng thái
            include ../../mixins/filllter.status.pug 
            +fillterStatus(button)
            
          div(class="md:col-span-5 lg:col-span-4 flex flex-col justify-center")
            label(class="text-xs font-semibold text-surface-500 uppercase tracking-wider mb-2") Tìm kiếm
            include ../../mixins/form.search.pug 
            +formSearch(keyword)
            
      //- Data Table
      div(class="bg-white rounded-2xl border border-surface-200 shadow-sm overflow-hidden")
        div(class="overflow-x-auto")
          table(class="w-full text-left border-collapse whitespace-nowrap")
            thead
              tr(class="bg-surface-50 border-b border-surface-200 text-xs uppercase text-surface-500 font-semibold tracking-wider")
                th(class="px-4 py-3 text-center w-16") STT
                th(class="px-4 py-3") Nhân sự
                th(class="px-4 py-3") Phân quyền
                th(class="px-4 py-3 text-center") Trạng thái
                th(class="px-4 py-3 text-right w-32") Hành động 
            
            tbody(class="divide-y divide-surface-100 text-sm")
              each Item, Index in accounts
                tr(class="hover:bg-surface-50 transition-colors group")
                  td(class="px-4 py-3 text-center text-surface-500 font-medium") #{Index+1}
                  
                  td(class="px-4 py-3")
                    div(class="flex items-center gap-3")
                      img(src=(Item.avatar || 'https://dummyimage.com/100x100/cbd5e1/ffffff') alt=Item.fullname class="w-10 h-10 rounded-full object-cover border border-surface-200 shadow-sm shrink-0" width="40" height="40")
                      div
                        div(class="font-semibold text-surface-900") #{Item.fullname}
                        div(class="text-xs text-surface-500 flex items-center gap-1 mt-0.5")
                          i.bi.bi-envelope
                          | #{Item.email}
                          
                  td(class="px-4 py-3")
                    if(Item.roleId)
                      each roleItem in roles
                        if(roleItem._id.toString() === Item.roleId.toString())
                          span(class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-surface-100 text-surface-700 border border-surface-200")
                            i.bi.bi-shield-check.mr-1.text-brand-500
                            | #{roleItem.title}
                    else
                      span(class="text-xs text-surface-400 italic") Chưa phân quyền

                  td(class="px-4 py-3 text-center")
                    if(role.permission.includes('accounts_edit'))
                      button(
                        button-change-status
                        data-status=Item.status 
                        button-id=Item.id
                        class=`px-3 py-1 text-xs font-semibold rounded-full border transition-colors ${Item.status=="active" ? "bg-emerald-50 text-emerald-600 border-emerald-200 hover:bg-emerald-100" : "bg-rose-50 text-rose-600 border-rose-200 hover:bg-rose-100"}`
                      ) #{Item.status=="active" ? "Hoạt động" : "Tạm dừng"}
                    else 
                      span(class=`px-3 py-1 text-xs font-semibold rounded-full border ${Item.status=="active" ? "bg-emerald-50 text-emerald-600 border-emerald-200" : "bg-rose-50 text-rose-600 border-rose-200"}`) #{Item.status=="active" ? "Hoạt động" : "Tạm dừng"}
                      
                  td(class="px-4 py-3 text-right")
                    div(class="flex items-center justify-end gap-1 opacity-0 group-hover:opacity-100 transition-opacity")
                      a(href=`${prefixAdmin}/accounts/detail/${Item.id}` class="w-8 h-8 flex items-center justify-center rounded-lg bg-surface-100 text-surface-600 hover:bg-surface-200 hover:text-brand-600 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500" title="Chi tiết")
                        i.bi.bi-eye
                      if(role.permission.includes('accounts_edit'))
                        a(href=`${prefixAdmin}/accounts/edit/${Item.id}` class="w-8 h-8 flex items-center justify-center rounded-lg bg-surface-100 text-surface-600 hover:bg-amber-100 hover:text-amber-600 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500" title="Sửa")
                          i.bi.bi-pencil-square
                      if(role.permission.includes('accounts_delete'))
                        button(button-change-activity="delete" btn-id=Item.id class="w-8 h-8 flex items-center justify-center rounded-lg bg-surface-100 text-surface-600 hover:bg-rose-100 hover:text-rose-600 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-500" title="Xóa")
                          i.bi.bi-trash

      form(action="" method="POST" id="form-change-status" data-path=`${prefixAdmin}/accounts/change-status`) 
      form(action="" method="POST" id="form-change-activity" data-path=`${prefixAdmin}/accounts/change-activity`) 

    else 
      div(class="bg-rose-50 border border-rose-200 text-rose-600 p-6 rounded-2xl flex flex-col items-center justify-center text-center mt-10 max-w-md mx-auto")
        i.bi.bi-shield-lock.text-4xl.mb-3
        h2(class="text-lg font-bold mb-1") Không có quyền truy cập
        p(class="text-sm") Bạn không được cấp quyền để xem danh sách tài khoản.

  script(src="/admin/js/product.js") 