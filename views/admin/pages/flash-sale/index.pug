extends ../../layout/default.pug 
include ../../mixins/moment.pug

block main 
  include ../../mixins/alert.pug
  +alert-success(messages.success)
  +alert-error(messages.error)
  
  div(class="max-w-7xl mx-auto space-y-6")
    div(class="flex flex-col md:flex-row md:items-center justify-between gap-4")
      div
        h1(class="text-2xl font-bold text-surface-900 tracking-tight") Quản lý Flash Sale
        p(class="text-surface-500 text-sm mt-1") Quản lý các chương trình Flash Sale.
      
      a(href=`${prefixAdmin}/flash-sales/create` class="inline-flex items-center gap-2 px-4 py-2.5 bg-brand-500 hover:bg-brand-600 text-white text-sm font-semibold rounded-xl shadow-lg shadow-brand-500/30 transition-all active:scale-95")
        i.bi.bi-plus-lg.text-lg
        | Tạo Flash Sale

    div(class="bg-white rounded-2xl border border-surface-200 shadow-sm overflow-hidden")
      div(class="overflow-x-auto")
        table(class="w-full text-left border-collapse whitespace-nowrap")
          thead
            tr(class="bg-surface-50 border-b border-surface-200 text-xs uppercase text-surface-500 font-semibold tracking-wider")
              th(class="px-4 py-3 hidden md:table-cell") STT
              th(class="px-4 py-3") Tên chương trình
              th(class="px-4 py-3") Thời gian
              th(class="px-4 py-3 text-center") Trạng thái
              th(class="px-4 py-3 text-center") Số sản phẩm
              th(class="px-4 py-3 text-right w-32") Hành động 
          
          tbody(class="divide-y divide-surface-100 text-sm")
            each Item, Index in flashSales
              tr(class="hover:bg-surface-50 transition-colors group")
                td(class="px-4 py-3 text-surface-500 font-medium hidden md:table-cell") #{Index+1}
                td(class="px-4 py-3 font-semibold text-surface-900") #{Item.name}
                td(class="px-4 py-3 text-surface-500 text-sm") 
                  div Bắt đầu: 
                    +formatDateTime(Item.startDate)
                  div Kết thúc: 
                    +formatDateTime(Item.endDate)
                td(class="px-4 py-3 text-center")
                  if Item.status == 'upcoming'
                    span(class="px-3 py-1 text-xs font-semibold rounded-full border bg-blue-50 text-blue-600 border-blue-200") Sắp diễn ra
                  else if Item.status == 'running'
                    span(class="px-3 py-1 text-xs font-semibold rounded-full border bg-emerald-50 text-emerald-600 border-emerald-200") Đang diễn ra
                  else 
                    span(class="px-3 py-1 text-xs font-semibold rounded-full border bg-rose-50 text-rose-600 border-rose-200") Đã kết thúc
                td(class="px-4 py-3 text-center font-medium") #{Item.productCount}
                td(class="px-4 py-3 text-right")
                  div(class="flex items-center justify-end gap-1 opacity-100 transition-opacity")
                    a(href=`${prefixAdmin}/flash-sales/edit/${Item._id}` class="w-8 h-8 flex items-center justify-center rounded-lg bg-surface-100 text-surface-600 hover:bg-amber-100 hover:text-amber-600 transition-colors" title="Sửa")
                      i.bi.bi-pencil-square
                    form(action=`${prefixAdmin}/flash-sales/delete/${Item._id}?_method=DELETE` method="POST" class="inline")
                      button(type="button" onclick="if(confirm('Bạn có chắc chắn muốn xóa?')) this.form.submit()" class="w-8 h-8 flex items-center justify-center rounded-lg bg-surface-100 text-surface-600 hover:bg-rose-100 hover:text-rose-600 transition-colors" title="Xóa")
                        i.bi.bi-trash
