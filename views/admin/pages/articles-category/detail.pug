extends ../../layout/default.pug
block main
  div(class="max-w-4xl mx-auto space-y-6")
    //- Header
    div(class="flex items-center justify-between mb-6")
      div(class="flex items-center gap-3")
        a(href=`${prefixAdmin}/category-article` class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-surface-200 text-surface-600 hover:bg-surface-50 hover:text-brand-600 transition-colors shadow-sm")
          i.bi.bi-arrow-left.text-lg
        h1(class="text-2xl font-bold text-surface-900 tracking-tight") Chi tiết Danh mục Bài viết
      
      if(role.permission.includes('articles-category_edit') || role.permission.includes('*'))
        a(href=`${prefixAdmin}/category-article/edit/${category._id}` class="px-5 py-2.5 bg-amber-500 hover:bg-amber-600 text-white text-sm font-semibold rounded-xl shadow-lg shadow-amber-500/30 transition-all active:scale-95 flex items-center gap-2")
          i.bi.bi-pencil-square.text-lg
          | Chỉnh sửa

    if category
      div(class="bg-white rounded-2xl border border-surface-200 shadow-sm overflow-hidden p-6")
        div(class="flex flex-col md:flex-row gap-8 items-start")
          if category.thumbnail
            div(class="w-full md:w-1/3 shrink-0")
              img(src=category.thumbnail alt=category.title class="w-full aspect-[4/3] object-cover rounded-xl border border-surface-200 shadow-sm")
          
          div(class="flex-1 space-y-4 w-full")
            h2(class="text-2xl font-bold text-surface-900") #{category.title}
            
            div(class="flex flex-wrap gap-2")
              span(class=`px-3 py-1 text-xs font-semibold rounded-full border ${category.status=="active" ? "bg-emerald-50 text-emerald-600 border-emerald-200" : "bg-rose-50 text-rose-600 border-rose-200"}`) #{category.status=="active" ? "Hoạt động" : "Dừng hoạt động"}
              span(class="px-3 py-1 text-xs font-semibold rounded-full border bg-surface-50 text-surface-600 border-surface-200") Vị trí: #{category.position}

            if category.description
              div(class="mt-4 pt-4 border-t border-surface-100")
                h3(class="text-sm font-bold text-surface-900 mb-2 uppercase tracking-wider") Mô tả:
                div(class="prose prose-sm max-w-none text-surface-700 bg-surface-50 p-4 rounded-xl border border-surface-100") !{category.description}

    else
      div(class="bg-rose-50 border border-rose-200 text-rose-600 p-8 rounded-2xl flex flex-col items-center justify-center text-center")
        i.bi.bi-exclamation-circle.text-5xl.mb-4
        h2(class="text-xl font-bold mb-2") Không tìm thấy!
        p(class="text-sm") Danh mục này không tồn tại hoặc đã bị xóa.
