extends ../../layout/default.pug
include ../../mixins/filllter.status.pug

block main
  div(class="max-w-7xl mx-auto space-y-6")
    //- Header
    div(class="flex flex-col md:flex-row md:items-center justify-between gap-4")
      div
        h1(class="text-2xl font-bold text-surface-900 tracking-tight") Quản lý Khách hàng
        p(class="text-surface-500 text-sm mt-1") Quản lý thông tin và trạng thái tài khoản khách hàng.

    //- List
    div(class="bg-white rounded-2xl border border-surface-200 shadow-sm overflow-hidden")
      div(class="p-5 border-b border-surface-100 bg-surface-50/50 flex justify-between items-center")
        h2(class="text-lg font-semibold text-surface-900 flex items-center gap-2")
          i.bi.bi-people.text-brand-500
          | Danh sách khách hàng
        div(class="flex items-center gap-3")
          +fillterStatus(filterStatus)
          
      div(class="overflow-x-auto")
        table(class="w-full text-left border-collapse whitespace-nowrap")
          thead
            tr(class="bg-surface-50 border-b border-surface-200 text-xs uppercase text-surface-500 font-semibold tracking-wider")
              th(class="px-4 py-3 text-center w-16 hidden md:table-cell") STT
              th(class="px-4 py-3") Khách hàng
              th(class="px-4 py-3") Trạng thái
              th(class="px-4 py-3 hidden lg:table-cell") Ngày đăng ký
              th(class="px-4 py-3 text-right w-32") Hành động
          tbody(class="divide-y divide-surface-100 text-sm")
            if users.length > 0
              each item, index in users
                tr(class="hover:bg-surface-50 transition-colors group")
                  td(class="px-4 py-3 text-center text-surface-500 font-medium hidden md:table-cell") #{index + 1}
                  td(class="px-4 py-3")
                    div(class="flex items-center gap-3")
                      div(class="w-10 h-10 rounded-full bg-gradient-to-tr from-brand-500 to-blue-500 flex items-center justify-center text-white font-bold text-sm shrink-0 shadow-inner")
                        | #{item.fullName ? item.fullName.charAt(0).toUpperCase() : 'U'}
                      div
                        div(class="font-semibold text-surface-900") #{item.fullName}
                        div(class="text-xs text-surface-500") #{item.email}
                  td(class="px-4 py-3")
                    if item.status == "active"
                      button(class="px-3 py-1 text-xs font-semibold rounded-full border bg-emerald-50 text-emerald-600 border-emerald-200 hover:bg-emerald-100 transition-colors" button-change-status data-status="active" button-id=item._id) Hoạt động
                    else
                      button(class="px-3 py-1 text-xs font-semibold rounded-full border bg-rose-50 text-rose-600 border-rose-200 hover:bg-rose-100 transition-colors" button-change-status data-status="inactive" button-id=item._id) Dừng hoạt động
                  td(class="px-4 py-3 text-surface-500 text-xs hidden lg:table-cell") #{new Date(item.createdAt).toLocaleString('vi-VN')}
                  td(class="px-4 py-3 text-right")
                    a(href=`${prefixAdmin}/users/detail/${item._id}` class="w-8 h-8 inline-flex items-center justify-center rounded-lg bg-surface-100 text-surface-600 hover:bg-brand-50 hover:text-brand-600 transition-colors border border-surface-200 shadow-sm" title="Xem chi tiết")
                      i.bi.bi-eye
            else
              tr
                td(colspan="5" class="px-5 py-8 text-center text-surface-500") Chưa có khách hàng nào trong hệ thống.

    //- Hidden form for changing status
    form(action="" method="POST" id="form-change-status" data-path=`${prefixAdmin}/users/change-status`)

block scripts
  script(src="/admin/js/product.js")
