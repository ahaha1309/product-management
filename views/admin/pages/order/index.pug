extends ../../layout/default.pug

block main
  div(class="max-w-7xl mx-auto space-y-6")
    //- Header
    div(class="flex flex-col md:flex-row md:items-center justify-between gap-4")
      div
        h1(class="text-2xl font-bold text-surface-900 tracking-tight") Quản lý Đơn hàng
        p(class="text-surface-500 text-sm mt-1") Theo dõi, xử lý và cập nhật trạng thái đơn hàng.

    //- List
    div(class="bg-white rounded-2xl border border-surface-200 shadow-sm overflow-hidden")
      div(class="p-5 border-b border-surface-100 bg-surface-50/50 flex justify-between items-center")
        h2(class="text-lg font-semibold text-surface-900 flex items-center gap-2")
          i.bi.bi-receipt.text-brand-500
          | Danh sách đơn hàng
        a(href=`${prefixAdmin}/orders/export-csv` class="px-4 py-2 bg-emerald-50 text-emerald-600 rounded-lg text-sm font-semibold hover:bg-emerald-100 transition-colors flex items-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500")
          i.bi.bi-file-earmark-spreadsheet
          | Xuất CSV
          
      div(class="overflow-x-auto")
        table(class="w-full text-left border-collapse whitespace-nowrap")
          thead
            tr(class="bg-surface-50 border-b border-surface-200 text-xs uppercase text-surface-500 font-semibold tracking-wider")
              th(class="px-4 py-3 text-center hidden md:table-cell") STT
              th(class="px-4 py-3") Mã đơn hàng
              th(class="px-4 py-3") Tổng tiền
              th(class="px-4 py-3 text-center hidden lg:table-cell") Phương thức TT
              th(class="px-4 py-3 hidden md:table-cell") Trạng thái TT
              th(class="px-4 py-3") Trạng thái Đơn
              th(class="px-4 py-3 hidden lg:table-cell") Ngày tạo
              th(class="px-4 py-3 text-right") Hành động
          tbody(class="divide-y divide-surface-100 text-sm")
            if orders.length > 0
              each item, index in orders
                tr(class="hover:bg-surface-50 transition-colors group")
                  td(class="px-4 py-3 text-center text-surface-500 font-medium hidden md:table-cell") #{index + 1}
                  td(class="px-4 py-3")
                    span(class="font-semibold text-brand-600 bg-brand-50 px-2 py-1 rounded-md border border-brand-100") #{item.orderCode}
                    if item.cancelRequest
                      div(class="mt-1.5")
                        span(class="px-2 py-0.5 text-[10px] font-bold uppercase rounded-full bg-amber-100 text-amber-700 border border-amber-200 inline-flex items-center gap-1")
                          i.bi.bi-hourglass-split
                          | Yêu cầu hủy
                  
                  td(class="px-4 py-3 font-bold text-rose-500") #{item.amount.toLocaleString('vi-VN')}₫
                  
                  td(class="px-4 py-3 text-center hidden lg:table-cell")
                    span(class="px-2 py-1 text-xs font-semibold rounded-lg bg-surface-100 text-surface-600 border border-surface-200") #{item.paymentMethod}
                  
                  td(class="px-4 py-3 hidden md:table-cell")
                    select(class="select-payment-status appearance-none bg-white border border-surface-200 text-surface-700 text-xs font-medium rounded-lg focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 block px-3 py-1.5 pr-8 transition-all outline-none cursor-pointer" data-id=item._id)
                      option(value="pending" selected=(item.paymentStatus === 'pending')) ⏳ Chờ thanh toán
                      option(value="success" selected=(item.paymentStatus === 'success')) ✅ Đã thanh toán
                      option(value="failed" selected=(item.paymentStatus === 'failed')) ❌ Thất bại

                  td(class="px-4 py-3")
                    select(class="select-status appearance-none bg-white border border-surface-200 text-surface-700 text-xs font-medium rounded-lg focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 block px-3 py-1.5 pr-8 transition-all outline-none cursor-pointer" data-id=item._id)
                      option(value="pending" selected=(item.status === 'pending' || item.status === '')) Chờ xử lý
                      option(value="confirm" selected=(item.status === 'confirm')) Đã xác nhận
                      option(value="finish" selected=(item.status === 'finish')) Hoàn thành
                      option(value="returned" selected=(item.status === 'returned')) Đã hoàn trả
                      option(value="canceled" selected=(item.status === 'canceled')) Đã hủy

                  td(class="px-4 py-3 text-surface-500 text-xs hidden lg:table-cell") #{new Date(item.createdAt).toLocaleString('vi-VN')}
                  
                  td(class="px-4 py-3 text-right")
                    button(class="btn-detail w-8 h-8 inline-flex items-center justify-center rounded-lg bg-surface-100 text-surface-600 hover:bg-brand-50 hover:text-brand-600 transition-colors border border-surface-200 shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500" data-id=item._id title="Xem chi tiết")
                      i.bi.bi-eye

            else
              tr
                td(colspan="8" class="px-5 py-8 text-center text-surface-500") Chưa có đơn hàng nào.

  //- Modal Chi Tiết Đơn Hàng Tailwind
  div(id="orderDetailModal" class="hidden fixed inset-0 z-[9999] bg-surface-900/60 backdrop-blur-sm flex items-center justify-center p-4 opacity-100 transition-opacity")
    div(class="bg-white rounded-2xl shadow-2xl w-full max-w-4xl max-h-[90vh] flex flex-col overflow-hidden transform scale-100 transition-transform")
      //- Header
      div(class="px-6 py-4 border-b border-surface-100 flex items-center justify-between bg-surface-50")
        h3(class="text-lg font-bold text-surface-900 flex items-center gap-2")
          i.bi.bi-receipt-cutoff.text-brand-500
          | Chi tiết đơn hàng: 
          span(id="modalOrderCode" class="text-brand-600")
        button(type="button" data-bs-dismiss="modal" class="text-surface-400 hover:text-rose-500 transition-colors w-8 h-8 flex items-center justify-center rounded-lg hover:bg-rose-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-500")
          i.bi.bi-x-lg.text-lg
      
      //- Body
      div(class="p-6 overflow-y-auto flex-1 custom-scrollbar")
        div(class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8")
          //- Customer Info
          div(class="bg-surface-50 rounded-xl p-5 border border-surface-100")
            h6(class="text-sm font-bold text-surface-900 mb-4 uppercase tracking-wider flex items-center gap-2")
              i.bi.bi-person-badge.text-blue-500
              | Thông tin khách hàng
            div(class="space-y-2 text-sm")
              p(class="flex justify-between")
                span(class="text-surface-500") Họ tên:
                span(id="modalCustomerName" class="font-medium text-surface-900")
              p(class="flex justify-between")
                span(class="text-surface-500") Điện thoại:
                span(id="modalCustomerPhone" class="font-medium text-surface-900")
              p(class="flex justify-between")
                span(class="text-surface-500") Địa chỉ:
                span(id="modalCustomerAddress" class="font-medium text-surface-900 text-right max-w-[200px] truncate")
                
          //- Payment Info
          div(class="bg-surface-50 rounded-xl p-5 border border-surface-100")
            h6(class="text-sm font-bold text-surface-900 mb-4 uppercase tracking-wider flex items-center gap-2")
              i.bi.bi-credit-card.text-emerald-500
              | Thanh toán & Vận chuyển
            div(class="space-y-2 text-sm")
              p(class="flex justify-between")
                span(class="text-surface-500") Phương thức:
                span(id="modalPaymentMethod" class="font-medium text-surface-900")
              p(class="flex justify-between")
                span(class="text-surface-500") Trạng thái thanh toán:
                span(id="modalPaymentStatus" class="font-medium px-2 py-0.5 rounded bg-emerald-100 text-emerald-700")
                
        //- Products Table
        h6(class="text-sm font-bold text-surface-900 mb-4 uppercase tracking-wider flex items-center gap-2")
          i.bi.bi-box-seam.text-amber-500
          | Danh sách sản phẩm
        div(class="border border-surface-200 rounded-xl overflow-hidden")
          table(class="w-full text-left text-sm whitespace-nowrap")
            thead(class="bg-surface-100 text-surface-600 font-semibold border-b border-surface-200")
              tr
                th(class="px-4 py-3 w-16 text-center") Ảnh
                th(class="px-4 py-3") Sản phẩm
                th(class="px-4 py-3 text-right") Đơn giá
                th(class="px-4 py-3 text-center") SL
                th(class="px-4 py-3 text-right") Thành tiền
            tbody(id="modalProductList" class="divide-y divide-surface-100 bg-white")
              //- Data populated by JS
              
        //- Total
        div(class="mt-6 flex justify-end")
          div(class="bg-rose-50 border border-rose-100 px-6 py-4 rounded-xl flex items-center gap-4")
            span(class="text-surface-600 font-semibold uppercase tracking-wider text-sm") Tổng thanh toán:
            span(id="modalTotalAmount" class="text-2xl font-bold text-rose-600")

      //- Footer
      div(class="px-6 py-4 border-t border-surface-100 bg-surface-50 flex justify-end gap-3")
        a(id="btn-print-invoice" href="#" target="_blank" class="px-5 py-2 rounded-xl bg-brand-500 text-white font-semibold hover:bg-brand-600 transition-colors shadow-sm flex items-center gap-2 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-brand-500 focus-visible:ring-offset-2")
          i.bi.bi-printer
          | In Hóa Đơn
        button(type="button" data-bs-dismiss="modal" class="px-5 py-2 rounded-xl border border-surface-200 bg-white text-surface-700 font-semibold hover:bg-surface-100 transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-surface-400") Đóng

block scripts
  script(src="/admin/js/order.js")