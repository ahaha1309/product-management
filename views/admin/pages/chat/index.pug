extends ../../layout/default.pug

block main
  div(class="max-w-[1400px] mx-auto space-y-6 h-[calc(100vh-8rem)] flex flex-col p-4 md:p-6")
    //- Header
    div(class="flex items-center justify-between shrink-0 bg-white/60 backdrop-blur-md p-6 rounded-2xl border border-white/40 shadow-[0_8px_30px_rgb(0,0,0,0.04)]")
      div
        h1(class="text-2xl font-bold bg-gradient-to-r from-slate-900 to-slate-700 bg-clip-text text-transparent tracking-tight") #{pageTitle || 'Hỗ trợ khách hàng'}
        p(class="text-slate-500 text-sm mt-1.5 font-medium") Chat trực tiếp với khách hàng của bạn.
        
    //- Main Chat Layout
    div(class="flex flex-col md:flex-row gap-6 flex-1 min-h-0")
      
      //- User List Sidebar
      div(class="w-full md:w-[320px] lg:w-[380px] bg-white/80 backdrop-blur-xl rounded-2xl border border-white/60 shadow-[0_8px_30px_rgb(0,0,0,0.06)] flex flex-col overflow-hidden shrink-0 transition-all duration-300")
        div(class="p-5 border-b border-slate-100/50 bg-white/40")
          h3(class="text-xs font-bold text-slate-400 uppercase tracking-widest") Khách hàng
          
        div(id="chat-user-list" class="flex-1 overflow-y-auto custom-scrollbar divide-y divide-slate-100/50")
          if chatUsers && chatUsers.length > 0
            each user in chatUsers
              - var isLocked = user.status === 'HUMAN' && user.assignedAgentId && user.assignedAgentId !== currentAdminId
              a(href="#" class=`chat-user-item block p-4 hover:bg-indigo-50/50 transition-all duration-200 focus:bg-indigo-50/50 group relative ${isLocked ? 'opacity-60 grayscale-[0.3]' : ''}` data-userid=user._id data-fullname=user.fullName data-status=user.status data-agent=user.assignedAgentId)
                div(class="flex items-center gap-4")
                  div(class="relative")
                    img(src=(user.avatar || 'https://dummyimage.com/40x40/cbd5e1/ffffff') class="w-12 h-12 rounded-2xl object-cover border-2 border-white shadow-sm shrink-0 group-hover:scale-105 transition-transform")
                    if user.status === 'BOT'
                      span(class="absolute -bottom-1 -right-1 w-4 h-4 bg-blue-500 border-2 border-white rounded-full")
                    else if user.status === 'HUMAN'
                      span(class="absolute -bottom-1 -right-1 w-4 h-4 bg-amber-500 border-2 border-white rounded-full")
                  div(class="min-w-0 flex-1")
                    div(class="font-semibold text-slate-800 truncate group-hover:text-indigo-600 transition-colors") #{user.fullName}
                    div(class="text-xs text-slate-500 truncate mt-1 flex items-center gap-2")
                      if user.status === 'BOT'
                        span(class="px-2 py-0.5 rounded-md bg-blue-50 text-blue-600 font-medium text-[10px] tracking-wide border border-blue-100") AI ASSISTANT
                      else if user.status === 'HUMAN'
                        if !user.assignedAgentId
                          span(class="px-2 py-0.5 rounded-md bg-amber-50 text-amber-600 font-medium text-[10px] tracking-wide border border-amber-100") CHỜ TIẾP NHẬN
                        else if user.assignedAgentId === currentAdminId
                          span(class="px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-600 font-medium text-[10px] tracking-wide border border-emerald-100") ĐANG HỖ TRỢ
                        else
                          span(class="px-2 py-0.5 rounded-md bg-rose-50 text-rose-600 font-medium text-[10px] tracking-wide border border-rose-100") ĐÃ CÓ NGƯỜI NHẬN
          else
            div(class="p-10 text-center text-slate-400 flex flex-col items-center justify-center h-full")
              div(class="w-16 h-16 bg-slate-50 rounded-2xl flex items-center justify-center mb-4")
                i.bi.bi-inbox.text-2xl
              span(class="text-sm font-medium") Chưa có tin nhắn nào.
              
      //- Chat Window
      div(class="flex-1 bg-white/80 backdrop-blur-xl rounded-2xl border border-white/60 shadow-[0_8px_30px_rgb(0,0,0,0.06)] flex flex-col overflow-hidden min-h-[400px] relative")
        
        //- Overlay Loading state (hidden by default)
        div(id="admin-chat-loading" class="hidden absolute inset-0 bg-white/50 backdrop-blur-sm z-50 flex items-center justify-center")
          div(class="w-10 h-10 border-4 border-indigo-200 border-t-indigo-600 rounded-full animate-spin")

        //- Empty State
        div(id="admin-chat-empty" class="flex-1 flex flex-col items-center justify-center text-center p-8")
          div(class="w-24 h-24 bg-gradient-to-br from-indigo-50 to-purple-50 rounded-3xl flex items-center justify-center text-indigo-500 text-4xl mb-6 shadow-sm border border-white")
            i.bi.bi-chat-heart-fill
          h3(class="text-xl font-bold text-slate-800 mb-2") Sẵn sàng hỗ trợ
          p(class="text-slate-500 text-sm max-w-sm leading-relaxed") Nhấp vào một khách hàng ở danh sách bên trái để xem cuộc trò chuyện hoặc tiếp nhận hỗ trợ.

        //- Chat Active State
        div(id="admin-chat-window" class="hidden flex-1 flex flex-col min-h-0")
          //- Chat Header
          div(class="p-4 sm:p-6 border-b border-slate-100/50 bg-white/40 flex items-center justify-between gap-4 shrink-0 z-10")
            div(class="flex items-center gap-4")
              div(class="w-12 h-12 rounded-2xl bg-gradient-to-br from-indigo-50 to-blue-50 flex items-center justify-center text-indigo-600 font-bold shrink-0 border border-white shadow-sm")
                i.bi.bi-person-fill.text-xl
              div
                h3(id="current-chat-name" class="font-bold text-slate-800 text-lg") Đang chat với...
                div(id="current-chat-status" class="flex items-center gap-2 mt-1")
                  //- Status injected via JS
            
            //- Action Buttons
            div(id="chat-actions" class="flex items-center gap-2")
              button(type="button" id="btn-take-chat" class="hidden px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium rounded-xl shadow-sm shadow-indigo-200 transition-all active:scale-95 flex items-center gap-2")
                i.bi.bi-person-check-fill
                | Tiếp nhận
              button(type="button" id="btn-return-bot" class="hidden px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-medium rounded-xl transition-all active:scale-95 flex items-center gap-2")
                i.bi.bi-robot
                | Trả về Bot
              button(type="button" id="btn-close-chat" class="hidden px-4 py-2.5 bg-rose-50 hover:bg-rose-100 text-rose-600 text-sm font-medium rounded-xl transition-all active:scale-95 flex items-center gap-2")
                i.bi.bi-x-circle-fill
                | Kết thúc

            input(type="hidden" id="current-chat-userid" value="")
            
          //- Messages Area
          div(id="admin-chat-messages" class="flex-1 overflow-y-auto p-6 bg-slate-50/30 flex flex-col gap-5 custom-scrollbar scroll-smooth")
            //- Lịch sử tin nhắn sẽ được load bằng JS
            
          //- Input Area
          div(class="p-4 sm:p-6 border-t border-slate-100/50 bg-white/40 shrink-0")
            form(id="admin-chat-form" class="flex items-end gap-3" action="")
              div(class="relative flex-1")
                textarea(id="admin-chat-input" placeholder="Nhập tin nhắn hỗ trợ..." rows="1" required class="w-full bg-white border border-slate-200 text-slate-800 text-sm rounded-2xl focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 block pl-5 pr-12 py-3.5 transition-all outline-none resize-none shadow-sm min-h-[50px] max-h-[150px] custom-scrollbar" style="line-height: 1.5;")
                button(type="button" class="absolute right-4 bottom-3.5 text-slate-400 hover:text-indigo-500 transition-colors")
                  i.bi.bi-emoji-smile.text-lg
              button(type="submit" id="btn-send-msg" class="shrink-0 w-12 h-12 flex items-center justify-center bg-indigo-600 hover:bg-indigo-700 disabled:bg-slate-300 disabled:cursor-not-allowed text-white rounded-2xl shadow-md shadow-indigo-200 transition-all active:scale-95")
                i.bi.bi-send-fill
                
  style.
    .chat-message { display: flex; flex-direction: column; width: 100%; animation: fadeIn 0.3s ease-out forwards; }
    .chat-message .bubble { padding: 1rem 1.25rem; border-radius: 1.25rem; max-width: 80%; font-size: 0.9rem; line-height: 1.5; }
    .chat-message.self { align-items: flex-end; }
    .chat-message.self .bubble { background: linear-gradient(135deg, #6366f1, #4f46e5); color: white; border-bottom-right-radius: 0.375rem; box-shadow: 0 4px 15px -3px rgba(99, 102, 241, 0.3); }
    .chat-message.client { align-items: flex-start; }
    .chat-message.client .bubble { background-color: white; color: #334155; border: 1px solid #e2e8f0; border-bottom-left-radius: 0.375rem; box-shadow: 0 2px 10px -2px rgba(0,0,0,0.02); }
    .chat-message.system { align-items: center; margin: 1rem 0; }
    .chat-message.system .bubble { background-color: transparent; color: #94a3b8; font-size: 0.75rem; padding: 0; text-align: center; max-width: 100%; border: none; box-shadow: none; font-weight: 500; letter-spacing: 0.05em; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    
  script(src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js")
  script.
    const currentAdminId = '#{user ? user.id : ""}';
  script(src="/admin/js/chat.js")
