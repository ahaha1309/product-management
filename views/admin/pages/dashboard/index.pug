extends ../../layout/default.pug

block main
  div(class="max-w-7xl mx-auto space-y-6")
    
    //- Welcome Header
    div(class="bg-gradient-to-br from-surface-900 to-surface-950 rounded-2xl p-6 md:p-8 flex flex-col md:flex-row items-start md:items-center justify-between shadow-2xl shadow-surface-900/20 relative overflow-hidden")
      //- Decorative blur
      div(class="absolute -top-24 -right-24 w-64 h-64 bg-brand-500/30 rounded-full blur-[80px] pointer-events-none")
      div(class="relative z-10")
        h1(class="text-2xl md:text-3xl font-black text-white tracking-tight mb-2 flex items-center gap-3")
          i.bi.bi-speedometer2.text-brand-400
          | Tổng quan hệ thống
        p(class="text-white font-medium") Xin chào Admin! Theo dõi hiệu suất và quản lý cửa hàng NVH Mall.
      div(class="relative z-10 mt-4 md:mt-0 bg-white/10 backdrop-blur-md border border-white/10 rounded-xl px-4 py-2.5 flex items-center gap-2 text-white")
        i.bi.bi-calendar3.text-brand-400
        span(id="current-date" class="text-sm font-medium")
        
    //- Key Metrics (Stats)
    div(class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4")
      //- Revenue
      div(class="bg-white rounded-2xl p-5 border border-surface-100 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group")
        div(class="absolute top-0 right-0 w-32 h-32 bg-brand-50 rounded-bl-full -mr-8 -mt-8 transition-transform group-hover:scale-110 motion-reduce:transition-none motion-reduce:transform-none")
        div(class="relative z-10 flex justify-between items-start mb-4")
          div(class="w-10 h-10 rounded-xl bg-brand-100 text-brand-600 flex items-center justify-center text-lg")
            i.bi.bi-currency-dollar
          span(class="text-xs font-semibold text-emerald-600 bg-emerald-50 px-2 py-1 rounded-md flex items-center gap-1")
            i.bi.bi-arrow-up-right
            | Đang tải
        div(class="relative z-10")
          p(class="text-sm font-medium text-surface-500 mb-1") Doanh thu
          h3(id="stat-revenue" class="text-2xl font-bold text-surface-900 tracking-tight") #{new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(orderStats.revenue || 0)}

      //- Orders
      div(class="bg-white rounded-2xl p-5 border border-surface-100 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group")
        div(class="absolute top-0 right-0 w-32 h-32 bg-blue-50 rounded-bl-full -mr-8 -mt-8 transition-transform group-hover:scale-110 motion-reduce:transition-none motion-reduce:transform-none")
        div(class="relative z-10 flex justify-between items-start mb-4")
          div(class="w-10 h-10 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center text-lg")
            i.bi.bi-bag-check
          span(class="text-xs font-semibold text-blue-600 bg-blue-50 px-2 py-1 rounded-md flex items-center gap-1")
            i.bi.bi-clock
            | Tổng quan
        div(class="relative z-10")
          p(class="text-sm font-medium text-surface-500 mb-1") Tổng đơn hàng
          h3(id="stat-orders" class="text-2xl font-bold text-surface-900 tracking-tight") #{orderStats.total.toLocaleString('vi-VN')}

      //- Users
      div(class="bg-white rounded-2xl p-5 border border-surface-100 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group")
        div(class="absolute top-0 right-0 w-32 h-32 bg-rose-50 rounded-bl-full -mr-8 -mt-8 transition-transform group-hover:scale-110 motion-reduce:transition-none motion-reduce:transform-none")
        div(class="relative z-10 flex justify-between items-start mb-4")
          div(class="w-10 h-10 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center text-lg")
            i.bi.bi-people
          span(class="text-xs font-semibold text-rose-600 bg-rose-50 px-2 py-1 rounded-md flex items-center gap-1")
            i.bi.bi-arrow-up-right
            | #{userStats.active} Đang hoạt động
        div(class="relative z-10")
          p(class="text-sm font-medium text-surface-500 mb-1") Tổng khách hàng
          h3(id="stat-users" class="text-2xl font-bold text-surface-900 tracking-tight") #{userStats.total.toLocaleString('vi-VN')}

      //- Products
      div(class="bg-white rounded-2xl p-5 border border-surface-100 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group")
        div(class="absolute top-0 right-0 w-32 h-32 bg-amber-50 rounded-bl-full -mr-8 -mt-8 transition-transform group-hover:scale-110 motion-reduce:transition-none motion-reduce:transform-none")
        div(class="relative z-10 flex justify-between items-start mb-4")
          div(class="w-10 h-10 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center text-lg")
            i.bi.bi-box-seam
          span(class="text-xs font-semibold text-emerald-600 bg-emerald-50 px-2 py-1 rounded-md flex items-center gap-1")
            i.bi.bi-check-circle
            | #{productStats.active} Active
        div(class="relative z-10")
          p(class="text-sm font-medium text-surface-500 mb-1") Tổng sản phẩm
          h3(id="stat-products" class="text-2xl font-bold text-surface-900 tracking-tight") #{productStats.total.toLocaleString('vi-VN')}

    //- Main Grid (Bento Box Layout)
    div(class="grid grid-cols-1 xl:grid-cols-3 gap-6")
      
      //- Left Column (Orders & Products)
      div(class="xl:col-span-2 space-y-6")
        
        //- Chart.js Canvas
        div(class="bg-white rounded-2xl border border-surface-100 shadow-sm p-5")
          h2(class="text-lg font-semibold text-surface-900 flex items-center gap-2 mb-4")
            i.bi.bi-graph-up-arrow.text-brand-500
            | Biểu đồ Doanh thu (7 ngày gần nhất)
          canvas(id="revenueChart" height="100")

        //- Recent Orders Table
        div(class="bg-white rounded-2xl border border-surface-100 shadow-sm overflow-hidden flex flex-col")
          div(class="p-5 border-b border-surface-100 flex justify-between items-center bg-surface-50/50")
            h2(class="text-lg font-semibold text-surface-900 flex items-center gap-2")
              i.bi.bi-cart-check.text-brand-500
              | Đơn hàng mới nhất
            a(href=`${prefixAdmin}/orders` class="text-sm font-medium text-brand-600 hover:text-brand-700 hover:underline flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-sm")
              | Xem tất cả
              i.bi.bi-arrow-right
          
          div(class="overflow-x-auto")
            table(class="w-full text-left border-collapse")
              thead
                tr(class="bg-surface-50 text-xs uppercase text-surface-500 font-semibold tracking-wider")
                  th(class="px-5 py-3 border-b border-surface-100") Mã đơn
                  th(class="px-5 py-3 border-b border-surface-100") Khách hàng
                  th(class="px-5 py-3 border-b border-surface-100") Số tiền
                  th(class="px-5 py-3 border-b border-surface-100") Trạng thái
                  th(class="px-5 py-3 border-b border-surface-100") Thanh toán
              tbody(id="recent-orders-body" class="divide-y divide-surface-100 text-sm")
                tr
                  td(colspan="5" class="px-5 py-4")
                    div(class="space-y-3")
                      div(class="h-4 bg-surface-200 rounded w-full animate-pulse motion-reduce:animate-none")
                      div(class="h-4 bg-surface-200 rounded w-5/6 animate-pulse motion-reduce:animate-none")
                      div(class="h-4 bg-surface-200 rounded w-4/6 animate-pulse motion-reduce:animate-none")

        //- Top Products
        div(class="bg-white rounded-2xl border border-surface-100 shadow-sm overflow-hidden")
          div(class="p-5 border-b border-surface-100 flex justify-between items-center bg-surface-50/50")
            h2(class="text-lg font-semibold text-surface-900 flex items-center gap-2")
              i.bi.bi-trophy.text-amber-500
              | Sản phẩm bán chạy
            a(href=`${prefixAdmin}/analytics` class="text-sm font-medium text-brand-600 hover:text-brand-700 hover:underline flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-sm")
              | Xem báo cáo
              i.bi.bi-arrow-right
          
          div(id="top-products-list" class="divide-y divide-surface-100")
            div(class="px-5 py-4")
              div(class="flex items-center gap-3 animate-pulse motion-reduce:animate-none")
                div(class="w-10 h-10 bg-surface-200 rounded-lg")
                div(class="flex-1 space-y-2")
                  div(class="h-3 bg-surface-200 rounded w-3/4")
                  div(class="h-2 bg-surface-200 rounded w-1/4")
            div(class="px-5 py-4")
              div(class="flex items-center gap-3 animate-pulse motion-reduce:animate-none")
                div(class="w-10 h-10 bg-surface-200 rounded-lg")
                div(class="flex-1 space-y-2")
                  div(class="h-3 bg-surface-200 rounded w-2/3")
                  div(class="h-2 bg-surface-200 rounded w-1/3")

      //- Right Column (Quick Actions, Reviews, Status)
      div(class="space-y-6")
        
        //- Quick Links
        div(class="bg-white rounded-2xl border border-surface-100 shadow-sm p-5")
          h2(class="text-lg font-semibold text-surface-900 flex items-center gap-2 mb-4")
            i.bi.bi-lightning-charge.text-brand-500
            | Truy cập nhanh
          
          div(class="grid grid-cols-2 gap-3")
            a(href=`${prefixAdmin}/product/create` class="flex flex-col items-center justify-center p-3 rounded-xl bg-surface-50 hover:bg-brand-50 border border-transparent hover:border-brand-100 text-surface-600 hover:text-brand-600 transition-all group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500")
              i(class="bi bi-plus-circle text-xl mb-1 transition-transform group-hover:scale-110 motion-reduce:transition-none motion-reduce:transform-none")
              span(class="text-xs font-medium") Thêm SP
            a(href=`${prefixAdmin}/orders` class="flex flex-col items-center justify-center p-3 rounded-xl bg-surface-50 hover:bg-brand-50 border border-transparent hover:border-brand-100 text-surface-600 hover:text-brand-600 transition-all group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500")
              i(class="bi bi-bag-check text-xl mb-1 transition-transform group-hover:scale-110 motion-reduce:transition-none motion-reduce:transform-none")
              span(class="text-xs font-medium") Duyệt đơn
            a(href=`${prefixAdmin}/articles/create` class="flex flex-col items-center justify-center p-3 rounded-xl bg-surface-50 hover:bg-brand-50 border border-transparent hover:border-brand-100 text-surface-600 hover:text-brand-600 transition-all group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500")
              i(class="bi bi-pen text-xl mb-1 transition-transform group-hover:scale-110 motion-reduce:transition-none motion-reduce:transform-none")
              span(class="text-xs font-medium") Viết bài
            a(href=`${prefixAdmin}/users` class="flex flex-col items-center justify-center p-3 rounded-xl bg-surface-50 hover:bg-brand-50 border border-transparent hover:border-brand-100 text-surface-600 hover:text-brand-600 transition-all group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500")
              i(class="bi bi-people text-xl mb-1 transition-transform group-hover:scale-110 motion-reduce:transition-none motion-reduce:transform-none")
              span(class="text-xs font-medium") Khách hàng

        //- Latest Reviews
        div(class="bg-white rounded-2xl border border-surface-100 shadow-sm overflow-hidden")
          div(class="p-5 border-b border-surface-100 flex justify-between items-center")
            h2(class="text-base font-semibold text-surface-900 flex items-center gap-2")
              i.bi.bi-star-fill.text-amber-400
              | Đánh giá mới
          
          div(id="latest-reviews-list" class="divide-y divide-surface-100")
            div(class="px-5 py-8 text-center text-surface-400")
              i(class="bi bi-arrow-repeat animate-spin text-2xl mb-2 inline-block motion-reduce:animate-none")
              p Đang tải dữ liệu...

        //- System Status
        div(class="bg-surface-900 rounded-2xl p-5 shadow-xl shadow-surface-900/10 text-white relative overflow-hidden")
          div(class="absolute top-0 right-0 w-32 h-32 bg-white/5 rounded-bl-full -mr-8 -mt-8")
          h2(class="text-base font-semibold flex items-center gap-2 mb-4 relative z-10")
            i.bi.bi-shield-check.text-emerald-400
            | Trạng thái hệ thống
            
          div(class="space-y-3 relative z-10")
            div(class="flex items-center justify-between text-sm")
              div(class="flex items-center gap-2")
                span(class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse motion-reduce:animate-none")
                span(class="text-surface-300") Database (MongoDB)
              span(class="text-emerald-400 font-medium") Online
            
            div(class="flex items-center justify-between text-sm")
              div(class="flex items-center gap-2")
                span(class="w-2 h-2 rounded-full bg-emerald-400")
                span(class="text-surface-300") Payment Gateway
              span(class="text-emerald-400 font-medium") Active
              
            div(class="flex items-center justify-between text-sm")
              div(class="flex items-center gap-2")
                span(class="w-2 h-2 rounded-full bg-amber-400")
                span(class="text-surface-300") Email Service
              span(class="text-amber-400 font-medium") Kiểm tra

  script.
    // Set current date
    document.getElementById('current-date').textContent = new Date().toLocaleDateString('vi-VN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

    // Format utility
    const formatMoney = (amount) => {
      return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
    };

    // Load dashboard stats via API
    async function loadDashboardData() {
      try {
        const resp = await fetch('#{prefixAdmin}/analytics/api/metrics');
        const data = await resp.json();
        if (data.code !== '00') return;
        const stats = data.data;

        // Update stats
        if (stats.generalStats) {
          const g = stats.generalStats;
          document.getElementById('stat-revenue').textContent = formatMoney(g.totalRevenue || 0);
          document.getElementById('stat-orders').textContent = (g.todayOrders || g.totalOrders || 0).toLocaleString('vi-VN');
          document.getElementById('stat-users').textContent = (g.totalUsers || 0).toLocaleString('vi-VN');
          document.getElementById('stat-products').textContent = (g.totalProducts || 0).toLocaleString('vi-VN');
        }

        // Recent orders
        if (stats.liveOrders && stats.liveOrders.length > 0) {
          const tbody = document.getElementById('recent-orders-body');
          tbody.innerHTML = stats.liveOrders.map(order => {
            const statusColors = {
              'finish': 'bg-emerald-50 text-emerald-600 border-emerald-200',
              'canceled': 'bg-rose-50 text-rose-600 border-rose-200',
              'confirm': 'bg-blue-50 text-blue-600 border-blue-200',
              'pending': 'bg-amber-50 text-amber-600 border-amber-200'
            };
            const pStatusColors = {
              'success': 'bg-emerald-50 text-emerald-600 border-emerald-200',
              'failed': 'bg-rose-50 text-rose-600 border-rose-200',
              'pending': 'bg-amber-50 text-amber-600 border-amber-200'
            };
            
            const sClass = statusColors[order.status] || statusColors['pending'];
            const psClass = pStatusColors[order.paymentStatus] || pStatusColors['pending'];

            return `
              <tr class="hover:bg-surface-50 transition-colors group">
                <td class="px-5 py-3 whitespace-nowrap">
                  <a href="#{prefixAdmin}/orders/detail/${order._id}" class="font-semibold text-surface-900 group-hover:text-brand-600 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-sm">#${(order.orderCode || 'N/A').toUpperCase()}</a>
                </td>
                <td class="px-5 py-3">
                  <div class="font-medium text-surface-900">${order.userName || 'N/A'}</div>
                </td>
                <td class="px-5 py-3 font-medium text-surface-900">${formatMoney(order.amount || 0)}</td>
                <td class="px-5 py-3">
                  <span class="px-2.5 py-1 rounded-full text-xs font-medium border ${sClass}">${order.status || 'pending'}</span>
                </td>
                <td class="px-5 py-3">
                  <span class="px-2.5 py-1 rounded-full text-xs font-medium border ${psClass}">${order.paymentStatus || 'pending'}</span>
                </td>
              </tr>
            `;
          }).join('');
        } else {
          document.getElementById('recent-orders-body').innerHTML = '<tr><td colspan="5" class="px-5 py-8 text-center text-surface-500">Không có đơn hàng nào</td></tr>';
        }

        // Top products
        if (stats.topSellingProducts && stats.topSellingProducts.length > 0) {
          const topList = document.getElementById('top-products-list');
          topList.innerHTML = stats.topSellingProducts.map((p, i) => `
            <div class="px-5 py-3 flex items-center gap-3 hover:bg-surface-50 transition-colors">
              <div class="w-6 h-6 rounded-full bg-surface-100 flex items-center justify-center text-xs font-bold text-surface-600 shrink-0 border border-surface-200">
                ${i+1}
              </div>
              <img src="${p.thumbnail || '/image/logo.png'}" class="w-10 h-10 rounded-lg object-cover border border-surface-200 shadow-sm" alt="Product" width="40" height="40">
              <div class="flex-1 min-w-0">
                <h4 class="text-sm font-semibold text-surface-900 truncate" title="${p.productTitle || 'N/A'}">${p.productTitle || 'N/A'}</h4>
                <p class="text-xs text-surface-500 mt-0.5">Đã bán: <span class="font-medium text-surface-900">${p.sold || 0}</span></p>
              </div>
            </div>
          `).join('');
        } else {
          document.getElementById('top-products-list').innerHTML = '<div class="px-5 py-8 text-center text-surface-500">Chưa có dữ liệu</div>';
        }

        // Latest reviews
        if (stats.latestReviews && stats.latestReviews.length > 0) {
          const reviewsList = document.getElementById('latest-reviews-list');
          reviewsList.innerHTML = stats.latestReviews.slice(0, 4).map(r => `
            <div class="px-5 py-3 hover:bg-surface-50 transition-colors">
              <div class="flex justify-between items-start mb-1">
                <strong class="text-sm font-semibold text-surface-900">${r.userName || 'Ẩn danh'}</strong>
                <div class="flex gap-0.5 text-amber-400 text-xs">
                  ${Array(r.rating || 5).fill('<i class="bi bi-star-fill"></i>').join('')}
                </div>
              </div>
              <p class="text-xs text-surface-600 line-clamp-2">${r.comment || ''}</p>
            </div>
          `).join('');
        } else {
          document.getElementById('latest-reviews-list').innerHTML = '<div class="px-5 py-8 text-center text-surface-500">Chưa có đánh giá</div>';
        }
      } catch (e) {
        console.error('Error fetching dashboard data:', e);
      }
    }
    
    //- Cập nhật số liệu ban đầu
    loadDashboardData();
    
    //- Tự động cập nhật mỗi 30 giây
    setInterval(loadDashboardData, 30000);

  script(src="https://cdn.jsdelivr.net/npm/chart.js")
  script.
    document.addEventListener('DOMContentLoaded', () => {
      const ctx = document.getElementById('revenueChart').getContext('2d');
      const labels = !{chartLabels || '[]'};
      const data = !{chartData || '[]'};

      new Chart(ctx, {
        type: 'line',
        data: {
          labels: labels,
          datasets: [{
            label: 'Doanh thu (VNĐ)',
            data: data,
            borderColor: '#10b981',
            backgroundColor: 'rgba(16, 185, 129, 0.1)',
            borderWidth: 3,
            fill: true,
            tension: 0.4
          }]
        },
        options: {
          responsive: true,
          plugins: {
            legend: { display: false }
          },
          scales: {
            y: {
              beginAtZero: true,
              ticks: {
                callback: function(value) {
                  return value.toLocaleString('vi-VN') + '₫';
                }
              }
            }
          }
        }
      });
    });