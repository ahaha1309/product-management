extends ../../layout/default.pug
include ../../mixins/alert.pug

block main
  +alert-success(messages.success)
  +alert-error(messages.error)
  
  div(class="max-w-3xl mx-auto space-y-6")
    //- Header
    div(class="flex items-center justify-between")
      div
        h1(class="text-2xl font-bold text-surface-900 tracking-tight flex items-center gap-2")
          i.bi.bi-pencil-square.text-brand-500
          | Chỉnh sửa Voucher
        p(class="text-surface-500 text-sm mt-1") Cập nhật thông tin mã khuyến mãi #{voucher.code}.
      a(href=`${prefixAdmin}/vouchers` class="text-sm font-semibold text-surface-600 hover:text-brand-500 flex items-center gap-1 transition-colors")
        i.bi.bi-arrow-left
        | Quay lại

    //- Form
    form(action=`${prefixAdmin}/vouchers/edit/${voucher._id}?_method=PATCH` method="POST")
      div(class="bg-white rounded-2xl border border-surface-100 shadow-sm p-6 md:p-8 space-y-6")
        
        //- Code & Title
        div(class="grid grid-cols-1 md:grid-cols-2 gap-6")
          div
            label(class="text-xs font-semibold text-surface-500 uppercase tracking-wider mb-2 block") Mã Voucher *
            input(type="text" name="code" required value=voucher.code class="w-full bg-surface-50 border border-slate-200 rounded-xl px-4 py-3 text-sm font-semibold uppercase focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition-all")
          div
            label(class="text-xs font-semibold text-surface-500 uppercase tracking-wider mb-2 block") Tiêu đề
            input(type="text" name="title" value=voucher.title class="w-full bg-surface-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition-all")

        //- Type
        div
          label(class="text-xs font-semibold text-surface-500 uppercase tracking-wider mb-2 block") Loại Voucher *
          select#voucherType(name="type" class="w-full bg-surface-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition-all")
            option(value="percentage" selected=voucher.type === 'percentage') Giảm % giá hàng
            option(value="freeship" selected=voucher.type === 'freeship') Miễn phí vận chuyển (Freeship)

        //- Discount & Max
        div#discountFields(class="grid grid-cols-1 md:grid-cols-2 gap-6")
          div
            label(class="text-xs font-semibold text-surface-500 uppercase tracking-wider mb-2 block") Phần trăm giảm (%) *
            input(type="number" name="discountPercentage" min="1" max="100" value=voucher.discountPercentage class="w-full bg-surface-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition-all")
          div
            label(class="text-xs font-semibold text-surface-500 uppercase tracking-wider mb-2 block") Giảm tối đa (VNĐ)
            input(type="number" name="maxDiscountAmount" min="0" value=voucher.maxDiscountAmount class="w-full bg-surface-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition-all")

        script.
          document.addEventListener('DOMContentLoaded', function() {
            const typeSelect = document.getElementById('voucherType');
            const discountFields = document.getElementById('discountFields');
            const inputs = discountFields.querySelectorAll('input');
            function toggleFields() {
              const isFreeship = typeSelect.value === 'freeship';
              discountFields.style.display = isFreeship ? 'none' : 'grid';
              inputs.forEach(input => input.disabled = isFreeship);
            }
            typeSelect.addEventListener('change', toggleFields);
            toggleFields();
          });

        //- Min Order & Usage
        div(class="grid grid-cols-1 md:grid-cols-2 gap-6")
          div
            label(class="text-xs font-semibold text-surface-500 uppercase tracking-wider mb-2 block") Đơn hàng tối thiểu (VNĐ)
            input(type="number" name="minOrderValue" min="0" value=voucher.minOrderValue class="w-full bg-surface-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition-all")
          div
            label(class="text-xs font-semibold text-surface-500 uppercase tracking-wider mb-2 block") Số lượt dùng tối đa
            input(type="number" name="usageLimit" min="1" value=voucher.usageLimit class="w-full bg-surface-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition-all")

        //- Dates
        - const formatDate = (d) => d ? new Date(d).toISOString().split('T')[0] : ''
        div(class="grid grid-cols-1 md:grid-cols-2 gap-6")
          div
            label(class="text-xs font-semibold text-surface-500 uppercase tracking-wider mb-2 block") Ngày bắt đầu
            input(type="date" name="validFrom" value=formatDate(voucher.validFrom) class="w-full bg-surface-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition-all")
          div
            label(class="text-xs font-semibold text-surface-500 uppercase tracking-wider mb-2 block") Ngày kết thúc
            input(type="date" name="validTo" value=formatDate(voucher.validTo) class="w-full bg-surface-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition-all")

        //- Status
        div
          label(class="text-xs font-semibold text-surface-500 uppercase tracking-wider mb-2 block") Trạng thái
          select(name="status" class="w-full bg-surface-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition-all")
            option(value="active" selected=voucher.status === 'active') Hoạt động
            option(value="inactive" selected=voucher.status === 'inactive') Tắt

        //- Usage Info (Read-only)
        div(class="bg-surface-50 rounded-xl p-4 border border-surface-200")
          h3(class="text-xs font-semibold text-surface-500 uppercase tracking-wider mb-3") Thông tin sử dụng
          div(class="grid grid-cols-2 gap-4 text-sm")
            div
              span(class="text-surface-500") Đã sử dụng: 
              span(class="font-bold text-surface-900") #{voucher.usedCount} / #{voucher.usageLimit} lượt
            div
              span(class="text-surface-500") Tạo ngày: 
              span(class="font-bold text-surface-900") #{moment(voucher.createdAt).format('DD/MM/YYYY HH:mm')}

        //- Submit
        div(class="flex justify-end pt-4 border-t border-surface-100")
          button(type="submit" class="btn-premium btn-premium-primary px-8 py-3 flex items-center gap-2")
            i.bi.bi-check-lg
            | Lưu thay đổi
