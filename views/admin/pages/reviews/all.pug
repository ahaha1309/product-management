extends ../../layout/default.pug

block main
  h1= title

  .card.mb-3
    .card-header Lọc trạng thái
    .card-body
      a.btn.btn-sm.me-2(href="?status=approved" class=(currentStatus === 'approved' ? 'btn-primary' : 'btn-outline-primary')) Đã duyệt
      a.btn.btn-sm.me-2(href="?status=pending" class=(currentStatus === 'pending' ? 'btn-warning' : 'btn-outline-warning')) Chờ duyệt
      a.btn.btn-sm(href="?status=rejected" class=(currentStatus === 'rejected' ? 'btn-danger' : 'btn-outline-danger')) Đã từ chối

  .card
    .card-header Danh sách Review
    .card-body
      table.table.table-hover.table-sm
        thead
          tr
            th STT
            th Sản phẩm
            th Người dùng
            th Đánh giá
            th Nội dung
            th Trạng thái
            th Hành động
        tbody
          each review, index in reviews
            tr
              td #{index + 1}
              td #{review.productTitle || review.productId}
              td #{review.userName}
              td 
                span.text-warning #{'⭐'.repeat(review.rating)}
              td #{review.comment}
              td
                if review.status === 'approved'
                  span.badge.bg-success Đã duyệt
                else if review.status === 'pending'
                  span.badge.bg-warning Chờ duyệt
                else
                  span.badge.bg-danger Đã từ chối
              td
                if review.status !== 'approved'
                  button.btn.btn-success.btn-sm.me-1(onclick=`approveReview('${review._id}', 'approved')`) Duyệt
                if review.status !== 'rejected'
                  button.btn.btn-danger.btn-sm(onclick=`approveReview('${review._id}', 'rejected')`) Từ chối

  script.
    function approveReview(id, status) {
      fetch(`/admin/reviews/${id}/approve`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status })
      }).then(res => res.json()).then(data => {
        if(data.code === '00') location.reload();
        else alert(data.message);
      });
    }
