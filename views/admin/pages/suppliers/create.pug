extends ../../layout/default.pug
include ../../mixins/alert.pug

block main
  +alert-error(messages.error)
  
  div(class="max-w-4xl mx-auto space-y-6")
    div(class="flex items-center gap-4")
      a(href=`${prefixAdmin}/suppliers` class="w-10 h-10 rounded-xl bg-white border border-surface-200 text-surface-600 flex items-center justify-center hover:bg-surface-50 hover:text-brand-600 transition-colors shadow-sm")
        i.bi.bi-arrow-left.text-lg
      div
        h1(class="text-2xl font-bold text-surface-900 tracking-tight") Thêm Nhà Cung Cấp
        p(class="text-surface-500 text-sm mt-1") Điền thông tin bên dưới để tạo nhà cung cấp mới

    form(
      action=`${prefixAdmin}/suppliers/create`
      id="form-create"
      method="POST"
      class="bg-white border border-surface-200 rounded-2xl shadow-sm overflow-hidden"
    )
      div(class="p-6 md:p-8 space-y-6")
        
        //- General Info
        div
          h3(class="text-sm font-bold uppercase tracking-wider text-surface-400 mb-4") Thông tin chung
          div(class="grid grid-cols-1 gap-6")
            
            div(class="form-group")
              label(for="name" class="block text-sm font-semibold text-surface-700 mb-2") Tên Nhà Cung Cấp <span class="text-rose-500">*</span>
              input(
                type="text"
                class="w-full px-4 py-2.5 rounded-xl border border-surface-200 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 transition-all text-sm"
                id="name"
                name="name"
                required
                placeholder="VD: Công ty TNHH ABC"
              )

            div(class="grid grid-cols-1 md:grid-cols-2 gap-6")
              div(class="form-group")
                label(for="email" class="block text-sm font-semibold text-surface-700 mb-2") Email liên hệ
                input(
                  type="email"
                  class="w-full px-4 py-2.5 rounded-xl border border-surface-200 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 transition-all text-sm"
                  id="email"
                  name="email"
                  placeholder="VD: contact@abc.com"
                )
                
              div(class="form-group")
                label(for="phone" class="block text-sm font-semibold text-surface-700 mb-2") Số điện thoại
                input(
                  type="text"
                  class="w-full px-4 py-2.5 rounded-xl border border-surface-200 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 transition-all text-sm"
                  id="phone"
                  name="phone"
                  placeholder="VD: 0912345678"
                )
                
            div(class="form-group")
              label(for="address" class="block text-sm font-semibold text-surface-700 mb-2") Địa chỉ
              input(
                type="text"
                class="w-full px-4 py-2.5 rounded-xl border border-surface-200 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 transition-all text-sm"
                id="address"
                name="address"
                placeholder="Địa chỉ công ty/kho hàng"
              )

        div(class="h-px bg-surface-100 my-6")

        //- Status
        div
          h3(class="text-sm font-bold uppercase tracking-wider text-surface-400 mb-4") Trạng thái
          div(class="flex gap-6")
            label(class="relative flex items-center gap-3 p-4 border border-surface-200 rounded-xl cursor-pointer hover:bg-surface-50 transition-colors flex-1")
              input(
                type="radio"
                class="form-radio text-brand-500 focus:ring-brand-500/20 w-5 h-5"
                id="statusActive"
                name="status"
                value="active"
                checked
              )
              div
                p(class="font-semibold text-surface-900 text-sm") Hoạt động
                p(class="text-xs text-surface-500 mt-0.5") Sẵn sàng giao dịch

            label(class="relative flex items-center gap-3 p-4 border border-surface-200 rounded-xl cursor-pointer hover:bg-surface-50 transition-colors flex-1")
              input(
                type="radio"
                class="form-radio text-surface-400 focus:ring-surface-500/20 w-5 h-5"
                id="statusInactive"
                name="status"
                value="inactive"
              )
              div
                p(class="font-semibold text-surface-900 text-sm") Dừng hoạt động
                p(class="text-xs text-surface-500 mt-0.5") Tạm ngưng giao dịch

      //- Actions
      div(class="px-6 py-4 bg-surface-50 border-t border-surface-200 flex justify-end gap-3")
        button(
          type="reset"
          class="px-6 py-2.5 rounded-xl font-semibold text-surface-600 hover:bg-surface-200 transition-colors text-sm"
        ) Làm lại
        button(
          type="submit"
          class="btn-premium btn-premium-primary px-8 py-2.5 text-sm"
        ) Tạo Mới
