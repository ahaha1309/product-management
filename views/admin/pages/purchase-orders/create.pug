extends ../../layout/default.pug
include ../../mixins/alert.pug

block main
  +alert-error(messages.error)
  
  div(class="max-w-5xl mx-auto space-y-6 pb-20")
    div(class="flex items-center gap-4")
      a(href=`${prefixAdmin}/purchase-orders` class="w-10 h-10 rounded-xl bg-white border border-surface-200 text-surface-600 flex items-center justify-center hover:bg-surface-50 hover:text-brand-600 transition-colors shadow-sm")
        i.bi.bi-arrow-left.text-lg
      div
        h1(class="text-2xl font-bold text-surface-900 tracking-tight") Tạo Phiếu Nhập Kho
        p(class="text-surface-500 text-sm mt-1") Nhập hàng hóa vào kho từ nhà cung cấp

    form(
      action=`${prefixAdmin}/purchase-orders/create`
      id="form-create-po"
      method="POST"
      class="bg-white border border-surface-200 rounded-2xl shadow-sm overflow-hidden"
    )
      div(class="p-6 md:p-8 space-y-8")
        
        //- General Info
        div
          h3(class="text-sm font-bold uppercase tracking-wider text-surface-400 mb-4 flex items-center gap-2") 
            i.bi.bi-info-circle
            | Thông tin phiếu nhập
          div(class="grid grid-cols-1 md:grid-cols-2 gap-6")
            
            div(class="form-group")
              label(for="supplierId" class="block text-sm font-semibold text-surface-700 mb-2") Nhà Cung Cấp <span class="text-rose-500">*</span>
              select(
                name="supplierId"
                id="supplierId"
                required
                class="w-full px-4 py-2.5 rounded-xl border border-surface-200 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 transition-all text-sm bg-white"
              )
                option(value="" disabled selected) -- Chọn nhà cung cấp --
                each sup in suppliers
                  option(value=sup.id) #{sup.name}
                  
            div(class="form-group")
              label(for="note" class="block text-sm font-semibold text-surface-700 mb-2") Ghi chú
              input(
                type="text"
                class="w-full px-4 py-2.5 rounded-xl border border-surface-200 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 transition-all text-sm"
                id="note"
                name="note"
                placeholder="Nhập ghi chú cho phiếu nhập này"
              )

        div(class="h-px bg-surface-100")

        //- Products List
        div
          div(class="flex items-center justify-between mb-4")
            h3(class="text-sm font-bold uppercase tracking-wider text-surface-400 flex items-center gap-2")
              i.bi.bi-box-seam
              | Danh sách sản phẩm nhập
            button(type="button" id="btnAddProduct" class="text-xs font-bold text-brand-600 bg-brand-50 px-3 py-1.5 rounded-lg hover:bg-brand-600 hover:text-white transition-colors flex items-center gap-1")
              i.bi.bi-plus
              | Thêm sản phẩm

          div(id="po-products-container" class="space-y-3")
            //- Template for one product row
            div(class="po-product-row flex items-start gap-3 bg-surface-50 p-3 rounded-xl border border-surface-200")
              div(class="flex-1")
                label(class="block text-xs font-semibold text-surface-700 mb-1") Sản phẩm <span class="text-rose-500">*</span>
                select(name="productIds" required class="w-full px-3 py-2 rounded-lg border border-surface-200 focus:outline-none focus:border-brand-500 text-sm")
                  option(value="" disabled selected) -- Chọn SP --
                  each p in products
                    option(value=p.id) #{p.title}
              
              div(class="w-24")
                label(class="block text-xs font-semibold text-surface-700 mb-1") SL <span class="text-rose-500">*</span>
                input(type="number" name="quantities" min="1" value="1" required class="w-full px-3 py-2 rounded-lg border border-surface-200 focus:outline-none focus:border-brand-500 text-sm")
              
              div(class="w-32")
                label(class="block text-xs font-semibold text-surface-700 mb-1") Đơn giá nhập <span class="text-rose-500">*</span>
                input(type="number" name="unitPrices" min="0" value="0" required class="w-full px-3 py-2 rounded-lg border border-surface-200 focus:outline-none focus:border-brand-500 text-sm")
              
              div(class="pt-6")
                button(type="button" class="btn-remove-row w-9 h-9 rounded-lg bg-rose-50 text-rose-500 hover:bg-rose-500 hover:text-white flex items-center justify-center transition-colors")
                  i.bi.bi-trash

      //- Actions
      div(class="px-6 py-4 bg-surface-50 border-t border-surface-200 flex justify-end gap-3")
        a(
          href=`${prefixAdmin}/purchase-orders`
          class="px-6 py-2.5 rounded-xl font-semibold text-surface-600 hover:bg-surface-200 transition-colors text-sm"
        ) Hủy
        button(
          type="submit"
          class="btn-premium btn-primary px-8 py-2.5 text-sm flex items-center gap-2"
        ) 
          i.bi.bi-check2-circle
          | Hoàn tất nhập kho

  script.
    document.addEventListener('DOMContentLoaded', () => {
      const container = document.getElementById('po-products-container');
      const btnAdd = document.getElementById('btnAddProduct');
      
      // Clone row function
      btnAdd.addEventListener('click', () => {
        const rows = container.querySelectorAll('.po-product-row');
        if(rows.length > 0) {
          const newRow = rows[0].cloneNode(true);
          // reset values
          newRow.querySelector('select').selectedIndex = 0;
          const inputs = newRow.querySelectorAll('input');
          inputs[0].value = 1;
          inputs[1].value = 0;
          container.appendChild(newRow);
          attachRemoveEvent(newRow.querySelector('.btn-remove-row'));
        }
      });

      // Remove row function
      function attachRemoveEvent(btn) {
        btn.addEventListener('click', (e) => {
          const rows = container.querySelectorAll('.po-product-row');
          if (rows.length > 1) {
            e.currentTarget.closest('.po-product-row').remove();
          } else {
            alert('Phải có ít nhất 1 sản phẩm!');
          }
        });
      }

      // Attach to initial row
      const initialBtns = container.querySelectorAll('.btn-remove-row');
      initialBtns.forEach(btn => attachRemoveEvent(btn));
    });
