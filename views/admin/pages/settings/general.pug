extends ../../layout/default.pug
include ../../mixins/alert.pug

block main
  +alert-success(messages.success)
  +alert-error(messages.error)

  div(class="max-w-4xl mx-auto")
    //- Header
    div(class="flex items-center justify-between mb-6")
      div
        h1(class="text-2xl font-bold text-surface-900 tracking-tight") Cài đặt chung
        p(class="text-surface-500 text-sm mt-1") Quản lý thông tin cơ bản và cấu hình của hệ thống.
      
      button(type="submit" form="settings-form" class="px-5 py-2.5 bg-brand-500 hover:bg-brand-600 text-white text-sm font-semibold rounded-xl shadow-lg shadow-brand-500/30 transition-all active:scale-95 flex items-center gap-2")
        i.bi.bi-save.text-lg
        | Lưu cài đặt

    form(id="settings-form" action=`${prefixAdmin}/settings/general?_method=PATCH` method="POST" enctype="multipart/form-data" class="space-y-6")
      
      //- Basic Information
      div(class="bg-white rounded-2xl border border-surface-200 shadow-sm p-6")
        h2(class="text-base font-bold text-surface-900 mb-5 pb-3 border-b border-surface-100 flex items-center gap-2")
          i.bi.bi-info-circle.text-brand-500
          | Thông tin cơ bản
          
        div(class="space-y-5")
          div(class="grid grid-cols-1 md:grid-cols-2 gap-5")
            div(class="md:col-span-2")
              label(class="block text-sm font-semibold text-surface-700 mb-1.5") Tên website
              input(type="text" name="websiteName" value=(settingGeneral && settingGeneral.websiteName ? settingGeneral.websiteName : "VanHa Tech") class="w-full bg-surface-50 border border-surface-200 text-surface-900 text-sm rounded-xl focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 block px-4 py-3 transition-all outline-none")
              
            div
              label(class="block text-sm font-semibold text-surface-700 mb-1.5") Email liên hệ
              input(type="email" name="email" value=(settingGeneral && settingGeneral.email ? settingGeneral.email : "contact@vanhatech.com") class="w-full bg-surface-50 border border-surface-200 text-surface-900 text-sm rounded-xl focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 block px-4 py-3 transition-all outline-none")
              
            div
              label(class="block text-sm font-semibold text-surface-700 mb-1.5") Số điện thoại hotline
              input(type="text" name="phone" value=(settingGeneral && settingGeneral.phone ? settingGeneral.phone : "0123456789") class="w-full bg-surface-50 border border-surface-200 text-surface-900 text-sm rounded-xl focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 block px-4 py-3 transition-all outline-none")
              
            div(class="md:col-span-2")
              label(class="block text-sm font-semibold text-surface-700 mb-1.5") Địa chỉ trụ sở
              input(type="text" name="address" value=(settingGeneral && settingGeneral.address ? settingGeneral.address : "Hà Nội, Việt Nam") class="w-full bg-surface-50 border border-surface-200 text-surface-900 text-sm rounded-xl focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 block px-4 py-3 transition-all outline-none")
              
            div(class="md:col-span-2")
              label(class="block text-sm font-semibold text-surface-700 mb-1.5") Giới thiệu ngắn / Slogan
              textarea(name="shortDescription" rows="3" class="w-full bg-surface-50 border border-surface-200 text-surface-900 text-sm rounded-xl focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 block px-4 py-3 transition-all outline-none") #{settingGeneral && settingGeneral.shortDescription ? settingGeneral.shortDescription : "Nền tảng quản lý bán hàng thông minh"}
              
            div(class="md:col-span-2")
              label(class="block text-sm font-semibold text-surface-700 mb-1.5") Bản quyền (Copyright)
              input(type="text" name="copyright" value=(settingGeneral && settingGeneral.copyright ? settingGeneral.copyright : "© 2026 VanHa Tech. All rights reserved.") class="w-full bg-surface-50 border border-surface-200 text-surface-900 text-sm rounded-xl focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 block px-4 py-3 transition-all outline-none")

      //- Logo & Media
      div(class="bg-white rounded-2xl border border-surface-200 shadow-sm p-6")
        h2(class="text-base font-bold text-surface-900 mb-5 pb-3 border-b border-surface-100 flex items-center gap-2")
          i.bi.bi-image.text-brand-500
          | Logo & Nhận diện
          
        div(class="space-y-4" upload-image)
          label(class="block text-sm font-semibold text-surface-700") Logo chính
          div(class="relative border-2 border-dashed border-surface-200 rounded-xl bg-surface-50 p-6 text-center hover:bg-surface-100 transition-colors group cursor-pointer")
            input(type="file" name="logo" accept="image/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" upload-image-input)
            i(class="bi bi-cloud-arrow-up text-4xl text-brand-400 mb-2 group-hover:scale-110 transition-transform inline-block")
            p(class="text-sm font-medium text-surface-700") Click để tải logo lên
            
          div(class=`relative ${settingGeneral && settingGeneral.logo ? '' : 'hidden'} bg-surface-100 border border-surface-200 p-4 rounded-xl flex items-center justify-center` id="logo-preview-container")
            img(src=(settingGeneral ? settingGeneral.logo : "") class="max-h-32 object-contain" upload-image-preview)
            button(type="button" class="absolute top-2 right-2 w-8 h-8 flex items-center justify-center bg-rose-500 text-white rounded-full hover:bg-rose-600 shadow-md transition-colors" close-image-upload title="Xóa logo")
              i.bi.bi-x-lg.text-sm

      //- Social Links
      div(class="bg-white rounded-2xl border border-surface-200 shadow-sm p-6")
        h2(class="text-base font-bold text-surface-900 mb-5 pb-3 border-b border-surface-100 flex items-center gap-2")
          i.bi.bi-share.text-brand-500
          | Mạng xã hội
          
        div(class="grid grid-cols-1 md:grid-cols-2 gap-5")
          div
            label(class="block text-sm font-semibold text-surface-700 mb-1.5 flex items-center gap-2")
              i.bi.bi-facebook.text-blue-600
              | Facebook URL
            input(type="url" name="facebook" value=(settingGeneral ? settingGeneral.facebook : "") placeholder="https://facebook.com/..." class="w-full bg-surface-50 border border-surface-200 text-surface-900 text-sm rounded-xl focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 block px-4 py-3 transition-all outline-none")
            
          div
            label(class="block text-sm font-semibold text-surface-700 mb-1.5 flex items-center gap-2")
              i.bi.bi-youtube.text-red-600
              | Youtube URL
            input(type="url" name="youtube" value=(settingGeneral ? settingGeneral.youtube : "") placeholder="https://youtube.com/..." class="w-full bg-surface-50 border border-surface-200 text-surface-900 text-sm rounded-xl focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 block px-4 py-3 transition-all outline-none")
            
          div
            label(class="block text-sm font-semibold text-surface-700 mb-1.5 flex items-center gap-2")
              i.bi.bi-instagram.text-pink-600
              | Instagram URL
            input(type="url" name="instagram" value=(settingGeneral ? settingGeneral.instagram : "") placeholder="https://instagram.com/..." class="w-full bg-surface-50 border border-surface-200 text-surface-900 text-sm rounded-xl focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 block px-4 py-3 transition-all outline-none")
            
          div
            label(class="block text-sm font-semibold text-surface-700 mb-1.5 flex items-center gap-2")
              i.bi.bi-tiktok.text-black
              | TikTok URL
            input(type="url" name="tiktok" value=(settingGeneral ? settingGeneral.tiktok : "") placeholder="https://tiktok.com/..." class="w-full bg-surface-50 border border-surface-200 text-surface-900 text-sm rounded-xl focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 block px-4 py-3 transition-all outline-none")

  script.
    document.querySelector('[upload-image-input]').addEventListener('change', function() {
      const file = this.files[0];
      const previewContainer = document.getElementById('logo-preview-container');
      if (file) previewContainer.classList.remove('hidden');
    });
    document.querySelector('[close-image-upload]').addEventListener('click', function() {
      const previewContainer = document.getElementById('logo-preview-container');
      previewContainer.classList.add('hidden');
      document.querySelector('[upload-image-preview]').src = '';
      document.querySelector('[upload-image-input]').value = '';
    });
