doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Đăng nhập Admin | ShopVN Enterprise
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet")
    link(href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet")
    script(src="https://cdn.tailwindcss.com")
    script.
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: { sans: ['Inter', 'sans-serif'] },
            colors: {
              brand: { 50: '#f0fdfa', 100: '#ccfbf1', 400: '#2dd4bf', 500: '#14b8a6', 600: '#0d9488', 900: '#134e4a' },
              surface: { 50: '#f8fafc', 100: '#f1f5f9', 200: '#e2e8f0', 300: '#cbd5e1', 400: '#94a3b8', 500: '#64748b', 600: '#475569', 700: '#334155', 800: '#1e293b', 900: '#0f172a' }
            },
            animation: {
              'blob': 'blob 7s infinite',
              'slide-up': 'slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards'
            },
            keyframes: {
              blob: {
                '0%': { transform: 'translate(0px, 0px) scale(1)' },
                '33%': { transform: 'translate(30px, -50px) scale(1.1)' },
                '66%': { transform: 'translate(-20px, 20px) scale(0.9)' },
                '100%': { transform: 'translate(0px, 0px) scale(1)' }
              },
              slideUp: {
                '0%': { opacity: '0', transform: 'translateY(30px)' },
                '100%': { opacity: '1', transform: 'translateY(0)' }
              }
            }
          }
        }
      }
    style.
      body { background-color: #0f172a; }
      .glass-card { background: rgba(30, 41, 59, 0.7); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }

  body(class="min-h-screen flex items-center justify-center p-4 relative overflow-hidden text-surface-200")
    //- Background Effects
    div(class="absolute inset-0 z-0 overflow-hidden pointer-events-none")
      div(class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] rounded-full bg-brand-500/20 blur-[100px] animate-blob")
      div(class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] rounded-full bg-indigo-500/20 blur-[100px] animate-blob" style="animation-delay: 2s")
      div(class="absolute top-[40%] left-[60%] w-[30%] h-[30%] rounded-full bg-purple-500/20 blur-[100px] animate-blob" style="animation-delay: 4s")
      div(class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iNDAiIGhlaWdodD0iNDAiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PGNpcmNsZSBjeD0iMSIgY3k9IjEiIHI9IjEiIGZpbGw9InJnYmEoMjU1LDI1NSwyNTUsMC4wNSkiLz48L3N2Zz4=')] [mask-image:linear-gradient(to_bottom,white,transparent)]")

    //- Login Card
    div(class="w-full max-w-md relative z-10 animate-slide-up opacity-0")
      div(class="glass-card rounded-[2rem] border border-surface-700/50 shadow-2xl shadow-black/50 p-8 sm:p-10")
        
        //- Logo Header
        div(class="text-center mb-10")
          div(class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br from-brand-400 to-indigo-600 shadow-lg shadow-brand-500/30 mb-5 relative group")
            div(class="absolute inset-0 rounded-2xl bg-white opacity-0 group-hover:opacity-20 transition-opacity")
            i.bi.bi-lightning-charge-fill.text-3xl.text-white
            
          h1(class="text-3xl font-bold tracking-tight text-white mb-2") ShopVN Admin
          p(class="text-surface-400 text-sm font-medium") Enterprise Management System
          
        //- Alerts
        if(messages && messages.error)
          div(class="mb-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 flex items-start gap-3")
            i(class="bi bi-exclamation-circle-fill text-rose-400 mt-0.5")
            p(class="text-sm font-medium text-rose-200") #{messages.error}
            
        if(messages && messages.success)
          div(class="mb-6 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-start gap-3")
            i(class="bi bi-check-circle-fill text-emerald-400 mt-0.5")
            p(class="text-sm font-medium text-emerald-200") #{messages.success}

        //- Form
        form(id="loginForm" action="/admin/auth/login" method="POST" class="space-y-5")
          div
            label(for="email" class="block text-sm font-semibold text-surface-300 mb-2") Tài khoản Email
            div(class="relative")
              i.bi.bi-envelope.absolute.left-4.top-1.translate-y-2.text-surface-500.pointer-events-none
              input(type="email" id="email" name="email" placeholder="admin@shopvn.com" required autocomplete="email" class="w-full bg-surface-900/50 border border-surface-700 text-white placeholder-surface-500 text-sm rounded-xl focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500 block pl-11 pr-4 py-3.5 transition-all outline-none shadow-inner")
              
          div
            label(for="password" class="block text-sm font-semibold text-surface-300 mb-2") Mật khẩu truy cập
            div(class="relative")
              i.bi.bi-lock.absolute.left-4.top-1.translate-y-2.text-surface-500.pointer-events-none
              input(type="password" id="password" name="password" placeholder="••••••••" required autocomplete="current-password" class="w-full bg-surface-900/50 border border-surface-700 text-white placeholder-surface-500 text-sm rounded-xl focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500 block pl-11 pr-12 py-3.5 transition-all outline-none shadow-inner")
              button(type="button" id="togglePw" class="absolute right-4 top-1 translate-y-2 text-surface-500 hover:text-surface-300 transition-colors focus:outline-none" title="Hiện/ẩn mật khẩu")
                i.bi.bi-eye#eyeIcon

          div(class="flex items-center justify-between pt-2")
            label(class="flex items-center gap-2 cursor-pointer group")
              input(type="checkbox" name="remember" class="w-4 h-4 rounded border-surface-600 bg-surface-900/50 text-brand-500 focus:ring-brand-500/50 focus:ring-offset-surface-800 transition-all cursor-pointer")
              span(class="text-sm font-medium text-surface-400 group-hover:text-surface-300 transition-colors") Ghi nhớ đăng nhập
              
            a(href="#" class="text-sm font-semibold text-brand-400 hover:text-brand-300 transition-colors") Quên mật khẩu?

          button(type="submit" id="submitBtn" class="w-full relative group overflow-hidden rounded-xl bg-gradient-to-r from-brand-500 to-indigo-600 text-white font-bold text-sm py-4 mt-4 shadow-lg shadow-brand-500/25 transition-all hover:shadow-brand-500/40 active:scale-[0.98]")
            div(class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out")
            span(class="relative flex items-center justify-center gap-2" id="btnContent")
              | Đăng nhập hệ thống
              i.bi.bi-arrow-right
            div(class="absolute inset-0 flex items-center justify-center hidden" id="btnLoader")
              svg(class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24")
                circle(class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4")
                path(class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z")

        div(class="mt-8 pt-6 border-t border-surface-700/50 text-center")
          p(class="text-xs text-surface-500") 
            | Hệ thống bảo mật cấp độ doanh nghiệp. 
            br
            | Mọi truy cập trái phép sẽ bị ghi log.

    script.
      // Toggle password visibility
      const togglePw = document.getElementById('togglePw');
      const pwInput = document.getElementById('password');
      const eyeIcon = document.getElementById('eyeIcon');

      togglePw.addEventListener('click', function () {
        const isHidden = pwInput.type === 'password';
        pwInput.type = isHidden ? 'text' : 'password';
        eyeIcon.className = isHidden ? 'bi bi-eye-slash' : 'bi bi-eye';
      });

      // Loading state on submit
      const form = document.getElementById('loginForm');
      const submitBtn = document.getElementById('submitBtn');
      const btnContent = document.getElementById('btnContent');
      const btnLoader = document.getElementById('btnLoader');

      form.addEventListener('submit', function () {
        submitBtn.disabled = true;
        btnContent.classList.add('hidden');
        btnLoader.classList.remove('hidden');
      });