extends ../../layout/default.pug

block main
  div(class="max-w-7xl mx-auto space-y-6")
    //- Header
    div(class="flex flex-col md:flex-row md:items-center justify-between gap-4")
      div(class="flex items-center gap-3")
        a(href=`${prefixAdmin}/analytics` class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-surface-200 text-surface-600 hover:bg-surface-50 hover:text-brand-600 transition-colors shadow-sm")
          i.bi.bi-arrow-left.text-lg
        div
          h1(class="text-2xl font-bold text-surface-900 tracking-tight flex items-center gap-2")
            i.bi.bi-box-seam.text-brand-500
            | Phân Tích Sản Phẩm
          p(class="text-surface-500 text-sm mt-1") Đánh giá hiệu suất bán hàng của từng sản phẩm.

    div(class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-6")
      
      //- Top Products
      div(class="bg-white rounded-2xl border border-surface-200 shadow-sm overflow-hidden flex flex-col")
        div(class="p-6 border-b border-surface-100")
          h3(class="text-lg font-bold text-surface-900 flex items-center gap-2")
            i.bi.bi-fire.text-rose-500
            | Top Sản Phẩm Bán Chạy
            
        div(class="overflow-x-auto flex-1")
          table(class="w-full text-left border-collapse whitespace-nowrap")
            thead
              tr(class="bg-surface-50 border-b border-surface-200 text-xs uppercase text-surface-500 font-semibold tracking-wider")
                th(class="px-6 py-4") Sản phẩm
                th(class="px-6 py-4 text-center") Đã bán
                th(class="px-6 py-4 text-right") Doanh thu
                th(class="px-6 py-4 text-center") Đánh giá
            tbody(class="divide-y divide-surface-100 text-sm")
              each item in productPerformance || []
                - var productInfo = item.product && item.product.length > 0 ? item.product[0] : {}
                tr(class="hover:bg-surface-50 transition-colors")
                  td(class="px-6 py-4")
                    div(class="flex items-center gap-3")
                      if productInfo.thumbnail || item.orderThumbnail
                        img(src=(productInfo.thumbnail || item.orderThumbnail) alt=(productInfo.title || item.orderTitle) class="w-12 h-12 rounded-xl object-cover border border-surface-200 shrink-0")
                      else
                        div(class="w-12 h-12 rounded-xl bg-surface-100 flex items-center justify-center text-surface-400 shrink-0")
                          i.bi.bi-image
                      div(class="font-bold text-surface-900 max-w-[200px] truncate")= (productInfo.title || item.orderTitle || item._id)
                  
                  td(class="px-6 py-4 text-center")
                    span(class="inline-flex items-center justify-center px-3 py-1 bg-emerald-50 text-emerald-700 font-bold rounded-lg")
                      = (item.sold || 0).toLocaleString('vi-VN')
                      
                  td(class="px-6 py-4 text-right font-bold text-brand-600")= (item.revenue || 0).toLocaleString('vi-VN') + 'đ'
                  
                  td(class="px-6 py-4 text-center text-amber-400 text-xs")
                    i.bi.bi-star-fill
                    i.bi.bi-star-fill
                    i.bi.bi-star-fill
                    i.bi.bi-star-fill
                    i.bi.bi-star-fill
              
              if !productPerformance || productPerformance.length === 0
                tr
                  td(colspan="4" class="px-6 py-10 text-center text-surface-500") Không có dữ liệu

      //- Category Analysis
      div(class="bg-white rounded-2xl border border-surface-200 shadow-sm overflow-hidden flex flex-col")
        div(class="p-6 border-b border-surface-100")
          h3(class="text-lg font-bold text-surface-900 flex items-center gap-2")
            i.bi.bi-diagram-3.text-indigo-500
            | Phân Tích Theo Danh Mục
            
        div(class="overflow-x-auto flex-1")
          table(class="w-full text-left border-collapse whitespace-nowrap")
            thead
              tr(class="bg-surface-50 border-b border-surface-200 text-xs uppercase text-surface-500 font-semibold tracking-wider")
                th(class="px-6 py-4") Danh mục
                th(class="px-6 py-4 text-right") Doanh thu
                th(class="px-6 py-4 text-center") Sản phẩm bán
            tbody(class="divide-y divide-surface-100 text-sm")
              each category in topCategories || []
                tr(class="hover:bg-surface-50 transition-colors")
                  td(class="px-6 py-4 font-bold text-surface-900 flex items-center gap-2")
                    i.bi.bi-folder2-open.text-indigo-400
                    | #{category.categoryTitle || category._id || 'Không xác định'}
                  td(class="px-6 py-4 text-right font-medium text-surface-700")= (category.revenue || 0).toLocaleString('vi-VN') + 'đ'
                  td(class="px-6 py-4 text-center")
                    span(class="font-bold text-indigo-600")= (category.quantity || 0).toLocaleString('vi-VN')
              
              if !topCategories || topCategories.length === 0
                tr
                  td(colspan="3" class="px-6 py-10 text-center text-surface-500") Không có dữ liệu
