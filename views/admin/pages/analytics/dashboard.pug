extends ../../layout/default.pug

block main
  div(class="max-w-7xl mx-auto space-y-6")
    //- Header
    div(class="flex flex-col md:flex-row md:items-center justify-between gap-4")
      div
        h1(class="text-2xl font-bold text-surface-900 tracking-tight flex items-center gap-2")
          i.bi.bi-bar-chart-line-fill.text-brand-500
          | Analytics Dashboard
        p(class="text-surface-500 text-sm mt-1") Tổng quan toàn diện về hiệu suất kinh doanh.
      
      div(class="flex items-center gap-3")
        div(class="relative")
          select(onchange="changePeriod(this.value)" class="appearance-none bg-white border border-surface-200 text-surface-700 text-sm font-semibold rounded-xl focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 block pl-4 pr-10 py-2.5 transition-all outline-none cursor-pointer shadow-sm")
            option(value='7') 7 ngày qua
            option(value='30') 30 ngày qua
            option(value='90') 90 ngày qua
          i.bi.bi-chevron-down.absolute.right-4.top-1.translate-y-2.text-surface-400.pointer-events-none.text-xs

        button(onclick="exportData()" class="px-4 py-2.5 bg-white hover:bg-surface-50 border border-surface-200 text-surface-700 text-sm font-semibold rounded-xl shadow-sm transition-all active:scale-95 flex items-center gap-2")
          i.bi.bi-download
          | Xuất báo cáo

    //- KPI Cards
    div(class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4")
      //- Revenue
      div(class="bg-white rounded-2xl border border-surface-200 shadow-sm p-5 hover:border-brand-300 transition-all hover:shadow-md group")
        div(class="flex items-start justify-between mb-2")
          div(class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg group-hover:scale-110 transition-transform")
            i.bi.bi-currency-dollar
          span(class="inline-flex items-center gap-1 text-[10px] font-bold px-2 py-1 rounded-full bg-emerald-50 text-emerald-600")
            i.bi.bi-arrow-up-right
            | 12%
        p(class="text-xs font-bold text-surface-500 uppercase tracking-wider mb-1") Doanh thu
        p(class="text-xl font-bold text-surface-900 truncate")= (overview.totalRevenue || 0).toLocaleString('vi-VN') + 'đ'

      //- Orders
      div(class="bg-white rounded-2xl border border-surface-200 shadow-sm p-5 hover:border-brand-300 transition-all hover:shadow-md group")
        div(class="flex items-start justify-between mb-2")
          div(class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg group-hover:scale-110 transition-transform")
            i.bi.bi-box-seam
          span(class="inline-flex items-center gap-1 text-[10px] font-bold px-2 py-1 rounded-full bg-emerald-50 text-emerald-600")
            i.bi.bi-arrow-up-right
            | 8%
        p(class="text-xs font-bold text-surface-500 uppercase tracking-wider mb-1") Đơn hàng
        p(class="text-xl font-bold text-surface-900 truncate")= (overview.totalOrders || 0).toLocaleString('vi-VN')

      //- Products
      div(class="bg-white rounded-2xl border border-surface-200 shadow-sm p-5 hover:border-brand-300 transition-all hover:shadow-md group")
        div(class="flex items-start justify-between mb-2")
          div(class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-lg group-hover:scale-110 transition-transform")
            i.bi.bi-bag-check
          span(class="inline-flex items-center gap-1 text-[10px] font-bold px-2 py-1 rounded-full bg-emerald-50 text-emerald-600")
            i.bi.bi-arrow-up-right
            | 5%
        p(class="text-xs font-bold text-surface-500 uppercase tracking-wider mb-1") Đã bán
        p(class="text-xl font-bold text-surface-900 truncate")= (overview.totalProductsSold || 0).toLocaleString('vi-VN')

      //- Customers
      div(class="bg-white rounded-2xl border border-surface-200 shadow-sm p-5 hover:border-brand-300 transition-all hover:shadow-md group")
        div(class="flex items-start justify-between mb-2")
          div(class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-lg group-hover:scale-110 transition-transform")
            i.bi.bi-people
          span(class="inline-flex items-center gap-1 text-[10px] font-bold px-2 py-1 rounded-full bg-emerald-50 text-emerald-600")
            i.bi.bi-arrow-up-right
            | 15%
        p(class="text-xs font-bold text-surface-500 uppercase tracking-wider mb-1") Khách mới
        p(class="text-xl font-bold text-surface-900 truncate")= (overview.newCustomers || 0).toLocaleString('vi-VN')

      //- AOV
      div(class="bg-white rounded-2xl border border-surface-200 shadow-sm p-5 hover:border-brand-300 transition-all hover:shadow-md group")
        div(class="flex items-start justify-between mb-2")
          div(class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-lg group-hover:scale-110 transition-transform")
            i.bi.bi-cash-stack
          span(class="inline-flex items-center gap-1 text-[10px] font-bold px-2 py-1 rounded-full bg-emerald-50 text-emerald-600")
            i.bi.bi-arrow-up-right
            | 3%
        p(class="text-xs font-bold text-surface-500 uppercase tracking-wider mb-1") AOV
        p(class="text-xl font-bold text-surface-900 truncate")= (overview.avgOrderValue || 0).toLocaleString('vi-VN') + 'đ'

    //- Quick Links
    div(class="flex flex-wrap gap-3")
      a(href="/admin/analytics/revenue" class="px-4 py-2 bg-blue-50 text-blue-700 hover:bg-blue-100 text-sm font-semibold rounded-xl border border-blue-200 transition-colors flex items-center gap-2")
        i.bi.bi-graph-up
        | Báo cáo doanh thu
      a(href="/admin/analytics/customers" class="px-4 py-2 bg-indigo-50 text-indigo-700 hover:bg-indigo-100 text-sm font-semibold rounded-xl border border-indigo-200 transition-colors flex items-center gap-2")
        i.bi.bi-people
        | Phân tích khách hàng
      a(href="/admin/analytics/products" class="px-4 py-2 bg-purple-50 text-purple-700 hover:bg-purple-100 text-sm font-semibold rounded-xl border border-purple-200 transition-colors flex items-center gap-2")
        i.bi.bi-box-seam
        | Phân tích sản phẩm
      a(href="/admin/analytics/reviews" class="px-4 py-2 bg-amber-50 text-amber-700 hover:bg-amber-100 text-sm font-semibold rounded-xl border border-amber-200 transition-colors flex items-center gap-2")
        i.bi.bi-star
        | Phân tích đánh giá

    //- Charts Row 1
    div(class="grid grid-cols-1 lg:grid-cols-2 gap-6")
      //- Revenue Chart
      div(class="bg-white rounded-2xl border border-surface-200 shadow-sm p-6")
        h3(class="text-base font-bold text-surface-900 mb-6 flex items-center gap-2")
          i.bi.bi-graph-up-arrow.text-brand-500
          | Doanh Thu Theo Ngày
        div(class="relative h-72 w-full")
          canvas#revenueChart

      //- Top Categories Chart
      div(class="bg-white rounded-2xl border border-surface-200 shadow-sm p-6")
        h3(class="text-base font-bold text-surface-900 mb-6 flex items-center gap-2")
          i.bi.bi-pie-chart.text-brand-500
          | Danh Mục Nổi Bật
        div(class="relative h-72 w-full flex justify-center")
          canvas#categoryChart

    //- Data Tables Row
    div(class="grid grid-cols-1 lg:grid-cols-2 gap-6")
      
      //- Top Selling Products
      div(class="bg-white rounded-2xl border border-surface-200 shadow-sm overflow-hidden flex flex-col")
        div(class="p-5 border-b border-surface-100 flex justify-between items-center")
          h3(class="text-base font-bold text-surface-900 flex items-center gap-2")
            i.bi.bi-fire.text-rose-500
            | Top Sản phẩm bán chạy
          a(href="/admin/analytics/products" class="text-xs font-semibold text-brand-600 hover:text-brand-700") Xem tất cả
        
        div(class="overflow-x-auto flex-1")
          table(class="w-full text-left border-collapse whitespace-nowrap")
            thead
              tr(class="bg-surface-50 border-b border-surface-200 text-xs uppercase text-surface-500 font-semibold tracking-wider")
                th(class="px-5 py-3") Sản phẩm
                th(class="px-5 py-3 text-center") Đã bán
                th(class="px-5 py-3 text-right") Doanh thu
            tbody(class="divide-y divide-surface-100 text-sm")
              each product in topSellingProducts || []
                tr(class="hover:bg-surface-50 transition-colors")
                  td(class="px-5 py-3")
                    div(class="flex items-center gap-3")
                      if product.thumbnail
                        img(src=product.thumbnail alt=product.productTitle class="w-10 h-10 rounded-lg object-cover border border-surface-200")
                      else
                        div(class="w-10 h-10 rounded-lg bg-surface-100 flex items-center justify-center text-surface-400")
                          i.bi.bi-image
                      div(class="font-bold text-surface-900 max-w-[150px] truncate")= product.productTitle || product.productId
                  td(class="px-5 py-3 text-center font-bold text-emerald-600")= product.sold
                  td(class="px-5 py-3 text-right font-medium text-surface-700")= (product.sold * 150000).toLocaleString('vi-VN') + 'đ'

      //- Recent Orders
      div(class="bg-white rounded-2xl border border-surface-200 shadow-sm overflow-hidden flex flex-col")
        div(class="p-5 border-b border-surface-100 flex justify-between items-center")
          h3(class="text-base font-bold text-surface-900 flex items-center gap-2")
            i.bi.bi-lightning-charge.text-amber-500
            | Đơn hàng mới nhất
          a(href="/admin/orders" class="text-xs font-semibold text-brand-600 hover:text-brand-700") Xem tất cả
        
        div(class="overflow-x-auto flex-1")
          table(class="w-full text-left border-collapse whitespace-nowrap")
            thead
              tr(class="bg-surface-50 border-b border-surface-200 text-xs uppercase text-surface-500 font-semibold tracking-wider")
                th(class="px-5 py-3") ID
                th(class="px-5 py-3") Thời gian
                th(class="px-5 py-3 text-right") Tổng tiền
            tbody(class="divide-y divide-surface-100 text-sm")
              each order in liveOrders || []
                tr(class="hover:bg-surface-50 transition-colors")
                  td(class="px-5 py-3 font-mono text-xs font-bold text-surface-500")= '#' + order.id.toString().substring(0, 6).toUpperCase()
                  td(class="px-5 py-3")
                    span(class="px-2 py-1 bg-surface-100 text-surface-600 rounded-md text-xs font-medium")= order.timeAgo || 'Vừa xong'
                  td(class="px-5 py-3 text-right font-bold text-brand-600")= (order.amount || 0).toLocaleString('vi-VN') + 'đ'

    //- Charts Row 2
    div(class="grid grid-cols-1 lg:grid-cols-2 gap-6")
      //- Payment Chart
      div(class="bg-white rounded-2xl border border-surface-200 shadow-sm p-6")
        h3(class="text-base font-bold text-surface-900 mb-6 flex items-center gap-2")
          i.bi.bi-credit-card.text-brand-500
          | Phương Thức Thanh Toán
        div(class="relative h-64 w-full flex justify-center")
          canvas#paymentChart

      //- Rating Chart
      div(class="bg-white rounded-2xl border border-surface-200 shadow-sm p-6")
        h3(class="text-base font-bold text-surface-900 mb-6 flex items-center gap-2")
          i.bi.bi-star.text-brand-500
          | Phân Bố Đánh Giá
        div(class="relative h-64 w-full")
          canvas#ratingChart

block scripts
  script(src='https://cdn.jsdelivr.net/npm/chart.js')
  script.
    // Data from server
    const topCategories = !{JSON.stringify(topCategories || [])};
    const revenueTrend = !{JSON.stringify(revenueTrend || [])};

    // Style configs for Charts
    Chart.defaults.font.family = "'Inter', sans-serif";
    Chart.defaults.color = '#64748b'; // surface-500
    const gridOptions = { color: '#f1f5f9', drawBorder: false };

    // Revenue Chart
    const revenueCtx = document.getElementById('revenueChart')?.getContext('2d');
    if (revenueCtx) {
      // Create gradient
      let gradient = revenueCtx.createLinearGradient(0, 0, 0, 400);
      gradient.addColorStop(0, 'rgba(20, 184, 166, 0.5)'); // brand-500
      gradient.addColorStop(1, 'rgba(20, 184, 166, 0.0)');
      
      new Chart(revenueCtx, {
        type: 'line',
        data: {
          labels: revenueTrend.map(item => item._id),
          datasets: [{
            label: 'Doanh thu (VNĐ)',
            data: revenueTrend.map(item => item.revenue || 0),
            borderColor: '#14b8a6', // brand-500
            backgroundColor: gradient,
            borderWidth: 3,
            pointBackgroundColor: '#fff',
            pointBorderColor: '#14b8a6',
            pointBorderWidth: 2,
            pointRadius: 4,
            pointHoverRadius: 6,
            tension: 0.4,
            fill: true
          }]
        },
        options: { 
          responsive: true,
          maintainAspectRatio: false,
          plugins: { 
            legend: { display: false },
            tooltip: {
              backgroundColor: '#1e293b',
              padding: 12,
              titleFont: { size: 13, weight: 'bold' },
              bodyFont: { size: 14, weight: 'bold' },
              callbacks: {
                label: function(context) {
                  let label = context.dataset.label || '';
                  if (label) label += ': ';
                  if (context.parsed.y !== null) {
                    label += new Intl.NumberFormat('vi-VN').format(context.parsed.y) + 'đ';
                  }
                  return label;
                }
              }
            }
          },
          scales: {
            x: { grid: { display: false } },
            y: { grid: gridOptions, beginAtZero: true }
          }
        }
      });
    }

    // Category Chart
    const categoryCtx = document.getElementById('categoryChart')?.getContext('2d');
    if (categoryCtx) {
      new Chart(categoryCtx, {
        type: 'doughnut',
        data: {
          labels: topCategories.map(item => item.categoryTitle || item._id),
          datasets: [{
            data: topCategories.map(item => item.quantity || 0),
            backgroundColor: ['#14b8a6', '#6366f1', '#f59e0b', '#ec4899', '#8b5cf6'],
            borderWidth: 0,
            hoverOffset: 4
          }]
        },
        options: { 
          responsive: true, 
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'right', labels: { usePointStyle: true, boxWidth: 8 } }
          },
          cutout: '70%'
        }
      });
    }

    // Payment Chart (Mock)
    const paymentCtx = document.getElementById('paymentChart')?.getContext('2d');
    if (paymentCtx) {
      new Chart(paymentCtx, {
        type: 'pie',
        data: {
          labels: ['COD', 'Chuyển khoản', 'MOMO', 'Thẻ tín dụng'],
          datasets: [{
            data: [45, 30, 15, 10],
            backgroundColor: ['#f59e0b', '#3b82f6', '#ec4899', '#10b981'],
            borderWidth: 0,
            hoverOffset: 4
          }]
        },
        options: { 
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'right', labels: { usePointStyle: true, boxWidth: 8 } }
          }
        }
      });
    }

    // Rating Chart (Mock)
    const ratingCtx = document.getElementById('ratingChart')?.getContext('2d');
    if (ratingCtx) {
      new Chart(ratingCtx, {
        type: 'bar',
        data: {
          labels: ['5⭐', '4⭐', '3⭐', '2⭐', '1⭐'],
          datasets: [{
            label: 'Đánh giá',
            data: [150, 45, 10, 5, 2],
            backgroundColor: '#f59e0b',
            borderRadius: 6,
            borderSkipped: false
          }]
        },
        options: { 
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: { grid: { display: false } },
            y: { grid: gridOptions }
          }
        }
      });
    }

    function changePeriod(days) {
      location.href = `?period=${days}`;
    }

    function exportData() {
      location.href = '/admin/analytics/export?type=revenue';
    }
