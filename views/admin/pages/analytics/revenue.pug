extends ../../layout/default.pug

block main
  div(class="max-w-7xl mx-auto space-y-6")
    //- Header
    div(class="flex flex-col md:flex-row md:items-center justify-between gap-4")
      div(class="flex items-center gap-3")
        a(href=`${prefixAdmin}/analytics` class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-surface-200 text-surface-600 hover:bg-surface-50 hover:text-brand-600 transition-colors shadow-sm")
          i.bi.bi-arrow-left.text-lg
        div
          h1(class="text-2xl font-bold text-surface-900 tracking-tight flex items-center gap-2")
            i.bi.bi-graph-up-arrow.text-brand-500
            | Báo Cáo Doanh Thu
          p(class="text-surface-500 text-sm mt-1") Thống kê doanh thu trong #{period || 30} ngày qua.
      
      div(class="flex flex-col sm:flex-row items-center gap-3 bg-white p-2 rounded-xl border border-surface-200 shadow-sm")
        span(class="text-sm font-semibold text-surface-600 pl-2") Lọc:
        div(class="flex items-center gap-2")
          input(type="date" id="startDate" onchange="filterByDate()" class="bg-surface-50 border border-surface-200 text-surface-900 text-sm rounded-lg px-3 py-2 outline-none focus:border-brand-500")
          span(class="text-surface-400") -
          input(type="date" id="endDate" onchange="filterByDate()" class="bg-surface-50 border border-surface-200 text-surface-900 text-sm rounded-lg px-3 py-2 outline-none focus:border-brand-500")

    //- Summary Cards
    div(class="grid grid-cols-1 md:grid-cols-3 gap-5")
      div(class="bg-gradient-to-br from-brand-500 to-teal-600 rounded-2xl shadow-lg shadow-brand-500/20 p-6 text-white relative overflow-hidden")
        i.bi.bi-cash-coin.absolute.-right-4.-bottom-4.text-8xl.opacity-10
        p(class="text-sm font-bold text-white/80 uppercase tracking-wider mb-2") Tổng doanh thu
        p(class="text-3xl font-bold")= (overview.totalRevenue || 0).toLocaleString('vi-VN') + 'đ'
        
      div(class="bg-white rounded-2xl border border-surface-200 shadow-sm p-6 relative overflow-hidden")
        i.bi.bi-bag-check.absolute.-right-4.-bottom-4.text-8xl.text-surface-100
        p(class="text-sm font-bold text-surface-500 uppercase tracking-wider mb-2") Tổng đơn hàng
        p(class="text-3xl font-bold text-surface-900")= (overview.totalOrders || 0)
        
      div(class="bg-white rounded-2xl border border-surface-200 shadow-sm p-6 relative overflow-hidden")
        i.bi.bi-receipt.absolute.-right-4.-bottom-4.text-8xl.text-surface-100
        p(class="text-sm font-bold text-surface-500 uppercase tracking-wider mb-2") Giá trị trung bình / đơn
        p(class="text-3xl font-bold text-surface-900")= (overview.avgOrderValue || 0).toLocaleString('vi-VN') + 'đ'

    //- Chart Section
    div(class="bg-white rounded-2xl border border-surface-200 shadow-sm p-6")
      h3(class="text-base font-bold text-surface-900 mb-6 flex items-center gap-2")
        i.bi.bi-bar-chart.text-brand-500
        | Biểu Đồ Doanh Thu
      div(class="relative h-[400px] w-full")
        canvas#revenueChartFull

    //- Table Section
    div(class="bg-white rounded-2xl border border-surface-200 shadow-sm overflow-hidden mt-6")
      div(class="p-6 border-b border-surface-100")
        h3(class="text-base font-bold text-surface-900 flex items-center gap-2")
          i.bi.bi-calendar3.text-brand-500
          | Chi Tiết Theo Ngày
          
      div(class="overflow-x-auto")
        table(class="w-full text-left border-collapse whitespace-nowrap")
          thead
            tr(class="bg-surface-50 border-b border-surface-200 text-xs uppercase text-surface-500 font-semibold tracking-wider")
              th(class="px-6 py-4") Ngày
              th(class="px-6 py-4 text-center") Số đơn hàng
              th(class="px-6 py-4 text-right") Doanh thu
              th(class="px-6 py-4 text-center") Tăng trưởng
          tbody(class="divide-y divide-surface-100 text-sm")
            each day in revenueTrend || []
              tr(class="hover:bg-surface-50 transition-colors")
                td(class="px-6 py-4 font-bold text-surface-900")= day._id
                td(class="px-6 py-4 text-center font-medium text-surface-700")= day.orders
                td(class="px-6 py-4 text-right font-bold text-brand-600")= (day.revenue || 0).toLocaleString('vi-VN') + 'đ'
                td(class="px-6 py-4 text-center")
                  span(class="inline-flex items-center gap-1 px-2.5 py-1 bg-emerald-50 text-emerald-600 text-xs font-bold rounded-md")
                    i.bi.bi-arrow-up-right
                    | 8%

block scripts
  script(src='https://cdn.jsdelivr.net/npm/chart.js')
  script.
    const revenueTrend = !{JSON.stringify(revenueTrend || [])};
    
    // Style config
    Chart.defaults.font.family = "'Inter', sans-serif";
    Chart.defaults.color = '#64748b';
    
    const ctx = document.getElementById('revenueChartFull')?.getContext('2d');
    if (ctx) {
      new Chart(ctx, {
        type: 'bar',
        data: {
          labels: revenueTrend.map(item => item._id),
          datasets: [{
            label: 'Doanh thu (VNĐ)',
            data: revenueTrend.map(item => item.revenue || 0),
            backgroundColor: '#14b8a6', // brand-500
            borderRadius: 6,
            borderSkipped: false,
            hoverBackgroundColor: '#0d9488' // brand-600
          }]
        },
        options: { 
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#1e293b',
              padding: 12,
              titleFont: { size: 13, weight: 'bold' },
              bodyFont: { size: 14, weight: 'bold' },
              callbacks: {
                label: function(context) {
                  return new Intl.NumberFormat('vi-VN').format(context.parsed.y) + 'đ';
                }
              }
            }
          },
          scales: {
            x: { grid: { display: false } },
            y: { grid: { color: '#f1f5f9', drawBorder: false } }
          }
        }
      });
    }

    function filterByDate() {
      // Implement filter logic later
      alert("Tính năng đang phát triển...");
    }

    // Set default dates
    window.onload = () => {
      const end = new Date();
      const start = new Date();
      start.setDate(end.getDate() - #{period || 30});
      
      const format = (date) => {
        // Adjust for timezone to avoid off-by-one errors in toISOString()
        const offset = date.getTimezoneOffset() * 60000;
        const localISOTime = (new Date(date - offset)).toISOString().split('T')[0];
        return localISOTime;
      };
      
      const startInput = document.getElementById('startDate');
      const endInput = document.getElementById('endDate');
      if (startInput && endInput) {
        startInput.value = format(start);
        endInput.value = format(end);
      }
    }
