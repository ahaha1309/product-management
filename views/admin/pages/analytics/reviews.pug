extends ../../layout/default.pug

block main
  div(class="max-w-7xl mx-auto space-y-6")
    //- Header
    div(class="flex flex-col md:flex-row md:items-center justify-between gap-4")
      div(class="flex items-center gap-3")
        a(href=`${prefixAdmin}/analytics` class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-surface-200 text-surface-600 hover:bg-surface-50 hover:text-brand-600 transition-colors shadow-sm")
          i.bi.bi-arrow-left.text-lg
        div
          h1(class="text-2xl font-bold text-surface-900 tracking-tight flex items-center gap-2")
            i.bi.bi-star.text-amber-400
            | Phân Tích Đánh Giá
          p(class="text-surface-500 text-sm mt-1") Thống kê phản hồi và độ hài lòng của khách hàng.

    //- Review Stats
    div(class="grid grid-cols-2 md:grid-cols-4 gap-4")
      div(class="bg-white rounded-2xl border border-surface-200 shadow-sm p-6 text-center group hover:border-brand-300 transition-colors")
        div(class="text-xs font-bold text-surface-500 uppercase tracking-wider mb-2") Tổng đánh giá
        div(class="text-3xl font-bold text-surface-900")= (reviewAnalytics.totalReviews || 0).toLocaleString('vi-VN')
        
      div(class="bg-white rounded-2xl border border-surface-200 shadow-sm p-6 text-center group hover:border-emerald-300 transition-colors")
        div(class="text-xs font-bold text-surface-500 uppercase tracking-wider mb-2") Đã duyệt
        div(class="text-3xl font-bold text-emerald-600")= (reviewAnalytics.approvedReviews || 0).toLocaleString('vi-VN')
        
      div(class="bg-white rounded-2xl border border-surface-200 shadow-sm p-6 text-center group hover:border-amber-300 transition-colors")
        div(class="text-xs font-bold text-surface-500 uppercase tracking-wider mb-2") Chờ duyệt
        div(class="text-3xl font-bold text-amber-500")= (reviewAnalytics.pendingReviews || 0).toLocaleString('vi-VN')
        
      div(class="bg-white rounded-2xl border border-surface-200 shadow-sm p-6 text-center group hover:border-yellow-300 transition-colors")
        div(class="text-xs font-bold text-surface-500 uppercase tracking-wider mb-2") Rating trung bình
        div(class="text-3xl font-bold text-yellow-500")= Number(reviewAnalytics.averageRating || 0).toFixed(1) + '⭐'

    //- Bottom Section
    div(class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-6")
      
      //- Rating Distribution
      div(class="bg-white rounded-2xl border border-surface-200 shadow-sm p-6")
        h3(class="text-base font-bold text-surface-900 mb-6 pb-4 border-b border-surface-100 flex items-center gap-2")
          i.bi.bi-pie-chart.text-brand-500
          | Phân Bố Đánh Giá
        div(class="relative h-[300px] w-full flex justify-center")
          canvas#ratingDistributionChart

      //- Action Card
      div(class="bg-gradient-to-br from-indigo-50 to-purple-50 rounded-2xl border border-indigo-100 shadow-sm p-8 flex flex-col justify-center items-center text-center")
        div(class="w-20 h-20 bg-white rounded-2xl shadow-sm flex items-center justify-center mb-6 relative")
          i.bi.bi-chat-dots.text-4xl.text-indigo-500
          if reviewAnalytics.pendingReviews > 0
            span(class="absolute -top-2 -right-2 flex h-6 w-6 items-center justify-center rounded-full bg-rose-500 text-[10px] font-bold text-white ring-2 ring-white")= reviewAnalytics.pendingReviews
            
        h3(class="text-xl font-bold text-surface-900 mb-3") Quản lý Đánh Giá
        p(class="text-surface-600 mb-8 max-w-sm mx-auto") Hiện đang có <span class="font-bold text-rose-500">#{reviewAnalytics.pendingReviews || 0}</span> đánh giá mới cần được quản trị viên kiểm duyệt.
        
        a(href="/admin/reviews?status=pending" class="px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl shadow-lg shadow-indigo-500/30 transition-all active:scale-95 flex items-center gap-2")
          i.bi.bi-eye
          | Xem và duyệt ngay

block scripts
  script(src='https://cdn.jsdelivr.net/npm/chart.js')
  script.
    Chart.defaults.font.family = "'Inter', sans-serif";
    
    const ratingCtx = document.getElementById('ratingDistributionChart')?.getContext('2d');
    if (ratingCtx) {
      new Chart(ratingCtx, {
        type: 'doughnut',
        data: {
          labels: ['5⭐ Tuyệt vời', '4⭐ Rất tốt', '3⭐ Bình thường', '2⭐ Kém', '1⭐ Rất tệ'],
          datasets: [{
            data: [45, 30, 15, 7, 3],
            backgroundColor: ['#10b981', '#84cc16', '#f59e0b', '#f97316', '#ef4444'],
            borderWidth: 0,
            hoverOffset: 8
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { 
              position: 'right',
              labels: { usePointStyle: true, boxWidth: 8, padding: 20 }
            }
          },
          cutout: '75%'
        }
      });
    }
