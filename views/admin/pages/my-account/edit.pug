extends ../../layout/default.pug
include ../../mixins/alert.pug

block main
  div(class="max-w-4xl mx-auto space-y-6")
    //- Header
    div(class="flex items-center justify-between mb-6")
      div
        h1(class="text-2xl font-bold text-surface-900 tracking-tight") Cập nhật thông tin cá nhân
        p(class="text-surface-500 text-sm mt-1") Quản lý tài khoản quản trị của bạn.
        
      a(href=`${prefixAdmin}/my-account` class="px-4 py-2 bg-white border border-surface-200 text-surface-700 hover:bg-surface-50 text-sm font-semibold rounded-xl transition-colors flex items-center gap-2")
        i.bi.bi-x-lg
        | Hủy bỏ

    +alert-success(messages.success)
    +alert-error(messages.error)

    form(action=`${prefixAdmin}/my-account/edit?_method=PATCH` method="POST" enctype="multipart/form-data" class="space-y-6")
      
      div(class="bg-white rounded-2xl border border-surface-200 shadow-sm overflow-hidden flex flex-col md:flex-row")
        
        //- Left: Avatar
        div(class="w-full md:w-1/3 bg-surface-50 p-6 flex flex-col items-center justify-center border-b md:border-b-0 md:border-r border-surface-200")
          div(class="relative group" upload-image)
            div(class="w-32 h-32 rounded-full overflow-hidden border-4 border-white shadow-lg bg-surface-200 mb-4 mx-auto relative")
              img(src=(account.avatar || 'https://dummyimage.com/200x200/cbd5e1/ffffff') class="w-full h-full object-cover" upload-image-preview)
              
              //- Overlay to change avatar
              label(class="absolute inset-0 bg-surface-900/50 flex flex-col items-center justify-center text-white opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer")
                i.bi.bi-camera-fill.text-2xl.mb-1
                span(class="text-xs font-bold") Đổi ảnh
                input(type="file" name="avatar" accept="image/*" class="hidden" upload-image-input)
                
            p(class="text-sm font-bold text-surface-900 text-center") #{account.fullname}
            p(class="text-xs text-brand-600 font-semibold text-center mt-1") #{role ? role.title : 'Admin'}
            
            button(type="button" class="hidden mx-auto mt-2 text-xs text-rose-500 font-bold" close-image-upload) Xóa ảnh chọn

        //- Right: Form Fields
        div(class="w-full md:w-2/3 p-6 space-y-5")
          h2(class="text-base font-bold text-surface-900 mb-4 pb-2 border-b border-surface-100") Thông tin liên hệ
          
          div
            label(class="block text-sm font-semibold text-surface-700 mb-1.5") Họ và tên <span class="text-rose-500">*</span>
            input(type="text" name="fullName" id="fullName" required value=account.fullname class="w-full bg-surface-50 border border-surface-200 text-surface-900 text-sm rounded-xl focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 block px-4 py-3 transition-all outline-none")
            
          div
            label(class="block text-sm font-semibold text-surface-700 mb-1.5") Địa chỉ Email <span class="text-rose-500">*</span>
            input(type="email" name="email" id="email" required value=account.email class="w-full bg-surface-50 border border-surface-200 text-surface-900 text-sm rounded-xl focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 block px-4 py-3 transition-all outline-none")
            
          div
            label(class="block text-sm font-semibold text-surface-700 mb-1.5") Số điện thoại
            input(type="text" name="phone" id="phone" value=account.phone placeholder="Nhập số điện thoại liên hệ" class="w-full bg-surface-50 border border-surface-200 text-surface-900 text-sm rounded-xl focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 block px-4 py-3 transition-all outline-none")
            
          div(class="pt-2")
            label(class="block text-sm font-semibold text-surface-700 mb-1.5") Mật khẩu mới
            input(type="password" name="password" id="password" placeholder="Bỏ trống nếu không muốn đổi mật khẩu" class="w-full bg-surface-50 border border-surface-200 text-surface-900 text-sm rounded-xl focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 block px-4 py-3 transition-all outline-none")

      div(class="flex justify-end")
        button(type="submit" class="px-6 py-3 bg-brand-500 hover:bg-brand-600 text-white text-sm font-semibold rounded-xl shadow-lg shadow-brand-500/30 transition-all active:scale-95 flex items-center gap-2")
          i.bi.bi-check2-circle.text-lg
          | Cập nhật thông tin

  script.
    document.querySelector('[upload-image-input]').addEventListener('change', function() {
      const file = this.files[0];
      const closeBtn = document.querySelector('[close-image-upload]');
      if (file) {
        closeBtn.classList.remove('hidden');
        closeBtn.classList.add('block');
      }
    });
    document.querySelector('[close-image-upload]').addEventListener('click', function() {
      this.classList.add('hidden');
      this.classList.remove('block');
      document.querySelector('[upload-image-preview]').src = '#{account.avatar || "https://dummyimage.com/200x200/cbd5e1/ffffff"}';
      document.querySelector('[upload-image-input]').value = '';
    });