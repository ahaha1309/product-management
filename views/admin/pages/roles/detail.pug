extends ../../layout/default.pug

block main
  include ../../mixins/alert.pug
  +alert-error(messages.error)
  
  div(class="max-w-3xl mx-auto space-y-6")
    //- Header
    div(class="flex items-center justify-between mb-6")
      div(class="flex items-center gap-3")
        a(href=`${prefixAdmin}/roles` class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-surface-200 text-surface-600 hover:bg-surface-50 hover:text-brand-600 transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500")
          i.bi.bi-arrow-left.text-lg
        h1(class="text-2xl font-bold text-surface-900 tracking-tight") Chi tiết nhóm quyền
      
      if(role.permission.includes('roles_edit'))
        a(href=`${prefixAdmin}/roles/edit/${role.id}` class="px-5 py-2.5 bg-amber-500 hover:bg-amber-600 text-white text-sm font-semibold rounded-xl shadow-lg shadow-amber-500/30 transition-all active:scale-95 flex items-center gap-2 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-amber-500 focus-visible:ring-offset-2")
          i.bi.bi-pencil-square.text-lg
          | Chỉnh sửa

    if role
      div(class="bg-white rounded-2xl border border-surface-200 shadow-sm p-8")
        div(class="flex items-start gap-5")
          div(class="w-16 h-16 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-3xl shrink-0 border border-indigo-100 shadow-inner")
            i.bi.bi-shield-check
            
          div(class="flex-1")
            h2(class="text-2xl font-bold text-surface-900 mb-2") #{role.title}
            
            div(class="mt-6")
              h3(class="text-sm font-bold text-surface-900 mb-2 uppercase tracking-wider") Mô tả:
              div(class="text-surface-700 bg-surface-50 p-4 rounded-xl border border-surface-100") 
                | #{role.description || 'Chưa có mô tả'}

            if(role.permission && role.permission.length > 0)
              div(class="mt-6")
                h3(class="text-sm font-bold text-surface-900 mb-3 uppercase tracking-wider") Quyền hạn được cấp:
                div(class="flex flex-wrap gap-2")
                  each perm in role.permission
                    span(class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-200")
                      i.bi.bi-check2.mr-1
                      | #{perm}
            else
              div(class="mt-6 text-amber-600 bg-amber-50 p-4 rounded-xl border border-amber-200 flex items-center gap-2 text-sm font-medium")
                i.bi.bi-exclamation-triangle
                | Nhóm quyền này chưa được cấu hình quyền hạn nào.
                
    else
      div(class="bg-rose-50 border border-rose-200 text-rose-600 p-8 rounded-2xl flex flex-col items-center justify-center text-center")
        i.bi.bi-shield-x.text-5xl.mb-4
        h2(class="text-xl font-bold mb-2") Không tìm thấy!
        p(class="text-sm") Nhóm quyền này không tồn tại hoặc đã bị xóa khỏi hệ thống.

  script(src='/admin/js/product.js')