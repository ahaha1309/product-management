doctype html
html(lang="vi") 
    head 
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title=title || 'Admin Dashboard'
        link(rel="icon" href=`/images/favicon.png?v=${Date.now()}` type="image/x-icon")
        link(rel="preconnect" href="https://fonts.googleapis.com")
        link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
        link(href="https://cdn.jsdelivr.net/npm/geist@1.0.3/dist/fonts/geist-sans/style.css" rel="stylesheet")
        link(rel="stylesheet", href="/css/tailwind.css?v=1")
        link(rel="stylesheet", href="/admin/css/style.css?v=4")
        link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css")
    body(class="bg-surface-50 font-sans text-surface-900 min-h-screen flex flex-col md:flex-row overflow-hidden")
        //- Skip link for accessibility
        a.skip-link(href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[10000] focus:px-4 focus:py-2 focus:bg-white focus:text-brand-600 focus:font-bold focus:shadow-xl focus:rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500") Chuyển đến nội dung chính
        
        //- Mobile Sidebar Backdrop
        div(id="sidebar-backdrop" class="fixed inset-0 bg-surface-900/50 backdrop-blur-sm z-40 hidden md:hidden transition-opacity opacity-0")
        include ../partials/sider.pug
        div(class="flex-1 flex flex-col h-screen overflow-hidden w-full relative")
            include ../partials/header.pug
            main(class="flex-1 overflow-y-auto p-4 md:p-6 lg:p-8")
                block main 
        
        script(src="/socket.io/socket.io.js")
        script(src="/admin/js/index.js") 
        script(src="/admin/js/notification.js") 
        // Include TinyMCE JS file and configuration
        script(src= "/tinymce/tinymce.min.js")
        script(src= "/admin/js/tinymce-config.js")
        //end TinyMCE
        block scripts
