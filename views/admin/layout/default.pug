doctype html
html 
    head 
        title=title 
        link(rel="icon" href=`/images/favicon.png?v=${Date.now()}` type="image/x-icon")
        link(rel="preconnect" href="https://fonts.googleapis.com")
        link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
        link(href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet")
        link(rel="stylesheet", href="/css/tailwind.css?v=1")
        link(rel="stylesheet", href="/admin/css/style.css?v=4")
        link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css")
    body(class="bg-surface-50 font-sans text-surface-900 min-h-screen flex flex-col md:flex-row overflow-hidden")
        //- Mobile Sidebar Backdrop
        div(id="sidebar-backdrop" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-40 hidden md:hidden transition-opacity opacity-0")
        include ../partials/sider.pug
        div(class="flex-1 flex flex-col h-screen overflow-hidden w-full relative")
            include ../partials/header.pug
            main(class="flex-1 overflow-y-auto p-4 md:p-6 lg:p-8")
                block main 
        
        script(src="/socket.io/socket.io.js")
        script(src="/admin/js/index.js") 
        script(src="/admin/js/notification.js") 
        // Include TinyMCE JS file and configuration
        script(src= "/tinymce/tinymce.min.js")
        script(src= "/admin/js/tinymce-config.js")
        //end TinyMCE
        script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
        block scripts
