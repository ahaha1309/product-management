html(lang="vi")
    head 
        meta(charset="UTF-8")
        if seoData
            title=seoData.title
            if seoData.metaTags
                each tag in seoData.metaTags
                    meta(name=tag.name content=tag.content)
            if seoData.openGraph
                each og in seoData.openGraph
                    meta(property=og.property content=og.content)
            if seoData.jsonLd
                each ld in seoData.jsonLd
                    script(type="application/ld+json") !{JSON.stringify(ld)}
        else
            title=title || 'NVH Mall - Premium E-commerce'
            meta(name="description" content=metaDesc || 'NVH Mall - Nơi cung cấp các sản phẩm công nghệ chính hãng, uy tín với giá cả tốt nhất thị trường.')
            meta(name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0")
            meta(name="theme-color" content="#2563eb")
        
        block head
        link(rel="icon" href=`/images/favicon.png?v=${Date.now()}` type="image/x-icon")
        link(rel="stylesheet", href="/css/chatbot.css?v=2")
        link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")
        link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/geist@1.0.3/dist/fonts/geist-sans/style.css")
        link(rel="stylesheet", href=`/css/tailwind.css?v=${Date.now()}`)
    body(class="overflow-x-hidden antialiased text-surface-900 bg-surface-50")
        //- Skip link for accessibility
        a.skip-link(href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[10000] focus:px-4 focus:py-2 focus:bg-white focus:text-brand-600 focus:font-bold focus:shadow-xl focus:rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500") Chuyển đến nội dung chính
        
        //- ===== MÀN HÌNH CHỜ (Global Loader) =====
        #global-loader(class="fixed inset-0 z-[9999] bg-white flex flex-col items-center justify-center transition-all duration-700 ease-in-out")
          div(class="relative flex items-center justify-center w-24 h-24 mb-6")
            div(class="absolute inset-0 border-[3px] border-slate-100 rounded-full")
            div(class="absolute inset-0 border-[3px] border-brand-500 rounded-full border-t-transparent animate-spin motion-reduce:animate-none")
            i(class="bi bi-bag-heart-fill text-brand-500 text-3xl perpetual-pulse motion-reduce:animate-none")
          h1(class="text-xl font-black text-surface-900 tracking-tight uppercase") NVH Mall
          p(class="text-[10px] font-semibold text-surface-400 tracking-[0.2em] uppercase mt-3 animate-pulse motion-reduce:animate-none") Đang tải...
        
        script.
          window.addEventListener('load', function() {
            const loader = document.getElementById('global-loader');
            if (loader) {
              const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
              if(prefersReducedMotion) {
                loader.style.display = 'none';
              } else {
                setTimeout(() => {
                  loader.style.opacity = '0';
                  loader.style.transform = 'scale(1.05)';
                  setTimeout(() => {
                    loader.style.display = 'none';
                  }, 700);
                }, 400);
              }
            }
          });

        include ../partials/header.pug
        



            
        //- Back to top button
        button#backToTop(aria-label="Lên đầu trang" title="Lên đầu trang" style="right: 36px; bottom: 100px;" class="fixed z-50 w-12 h-12 rounded-full bg-surface-900 text-white flex items-center justify-center shadow-lg shadow-surface-900/30 hover:-translate-y-2 hover:bg-brand-600 hover:shadow-brand-500/50 transition-all duration-300 opacity-0 invisible [&.show]:opacity-100 [&.show]:visible focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2")
          i(class="bi bi-arrow-up-short text-3xl" aria-hidden="true")
        
        main#main-content
            block main 
        
        include ../partials/footer.pug
        include ../mixins/chatbot.pug
        +chatbot()
        
        script(src="https://cdn.socket.io/4.7.4/socket.io.min.js")
        script(src="/js/chat.js")
        script(src="/js/toast.js")
        script(src="/js/index.js?v=7") 
        script(src="/js/chatbot.js")
        script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")