html 
    head 
        title=title 
        meta(name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0")
        link(rel="icon" href="/image/logo.png" type="image/x-icon")
        link(rel="stylesheet", href="/css/style.css?v=8")
        link(rel="stylesheet", href="/css/shopee-style.css?v=2")
        link(rel="stylesheet", href="/css/chatbot.css?v=2")
        link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")
        link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous")
    body 
        //- ===== SPLASH SCREEN (MÀN HÌNH CHỜ) =====
        #splash-screen
          .splash-content
            .splash-logo
              i.bi.bi-lightning-charge-fill
            h1.splash-title VANHA TECH
            p.splash-desc Mua sắm thông minh - Tiết kiệm tối đa
        script.
          if (sessionStorage.getItem('splashShown')) {
            document.getElementById('splash-screen').style.display = 'none';
          } else {
            sessionStorage.setItem('splashShown', 'true');
          }

        include ../partials/header.pug
        
        //- ===== STICKY SIDE BANNERS =====
        if (title !== "Đăng Nhập" && title !== "Đăng Ký")
          a.sticky-side-banner.left(href="/product")
            img(src="https://cdn.tgdd.vn/2024/05/banner/Sticky-left-mac--1--180x420.png" alt="Sale trái")
          a.sticky-side-banner.right(href="/product")
            img(src="https://cdn.tgdd.vn/2024/05/banner/Sticky-right-mac--1--180x420.png" alt="Sale phải")

          //- Social Contact Sidebar
          .social-contact-sidebar
            a.social-btn.zalo(href="https://zalo.me/0123456789" target="_blank" title="Chat Zalo")
              img(src="/image/zalo-icon.png" alt="Zalo")
            a.social-btn.messenger(href="https://m.me/vanhatech" target="_blank" title="Chat Messenger")
              img(src="/image/messenger-icon.png" alt="Messenger")
            a.social-btn.phone(href="tel:0123456789" title="Gọi Hotline")
              i.bi.bi-telephone-fill
          //- Back to top button
          button#backToTop.back-to-top-btn(title="Lên đầu trang")
            i.bi.bi-arrow-up-short
        block main 
        
        include ../partials/footer.pug
        include ../mixins/chatbot.pug
        +chatbot()
        
        script(src="https://cdn.socket.io/4.7.4/socket.io.min.js")
        script(src="/js/chat.js")
        script(src="/js/index.js?v=7") 
        script(src="/js/chatbot.js")
        script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js" integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO" crossorigin="anonymous")
        script(src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous")
        script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.min.js" integrity="sha384-RuyvpeZCpMJCqVUGFI0Do1mQrods/hhxYlcVfGPOfQtPJh0JCw12tUAZ/Mv10S7D" crossorigin="anonymous")