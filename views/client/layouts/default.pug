html 
    head 
        title=title 
        meta(name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0")
        link(rel="icon" href=`/images/favicon.png?v=${Date.now()}` type="image/x-icon")
        link(rel="stylesheet", href="/css/chatbot.css?v=2")
        link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")
        link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous")
        link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/geist@1.0.3/dist/fonts/geist-sans/style.css")
        link(rel="stylesheet", href=`/css/tailwind.css?v=${Date.now()}`)
    body 
        //- ===== MÀN HÌNH CHỜ (Global Loader) =====
        #global-loader(class="fixed inset-0 z-[9999] bg-white flex flex-col items-center justify-center transition-all duration-700 ease-in-out")
          div(class="relative flex items-center justify-center w-24 h-24 mb-6")
            div(class="absolute inset-0 border-[3px] border-slate-100 rounded-full")
            div(class="absolute inset-0 border-[3px] border-brand-500 rounded-full border-t-transparent animate-spin")
            i(class="bi bi-bag-heart-fill text-brand-500 text-3xl perpetual-pulse")
          h1(class="text-xl font-black text-surface-900 tracking-tight uppercase") VanHa Tech
          p(class="text-[10px] font-semibold text-surface-400 tracking-[0.2em] uppercase mt-3 animate-pulse") Đang tải...
        
        script.
          window.addEventListener('load', function() {
            const loader = document.getElementById('global-loader');
            if (loader) {
              // Wait a tiny bit to let the user see the premium loader, then fade out
              setTimeout(() => {
                loader.style.opacity = '0';
                loader.style.transform = 'scale(1.05)';
                setTimeout(() => {
                  loader.style.display = 'none';
                }, 700);
              }, 400);
            }
          });

        include ../partials/header.pug
        


          //- Social Contact Sidebar
          div(class="fixed bottom-24 right-6 z-50 flex flex-col gap-3")
            a(href="https://zalo.me/0123456789" target="_blank" title="Chat Zalo" class="w-12 h-12 rounded-full bg-white flex items-center justify-center shadow-lg hover:scale-110 hover:shadow-xl transition-all duration-300 overflow-hidden border border-slate-100")
              img(src="/image/zalo-icon.png" alt="Zalo" class="w-8 h-8 object-contain")
            a(href="https://m.me/vanhatech" target="_blank" title="Chat Messenger" class="w-12 h-12 rounded-full bg-white flex items-center justify-center shadow-lg hover:scale-110 hover:shadow-xl transition-all duration-300 overflow-hidden border border-slate-100")
              img(src="/image/messenger-icon.png" alt="Messenger" class="w-8 h-8 object-contain")
            a(href="tel:0123456789" title="Gọi Hotline" class="w-12 h-12 rounded-full bg-rose-500 text-white flex items-center justify-center shadow-lg shadow-rose-500/30 hover:scale-110 hover:shadow-rose-500/50 transition-all duration-300 border border-rose-400")
              i(class="bi bi-telephone-fill text-xl")
              
          //- Back to top button
          button#backToTop(title="Lên đầu trang" class="fixed bottom-8 right-6 z-50 w-12 h-12 rounded-full bg-surface-900 text-white flex items-center justify-center shadow-lg shadow-surface-900/30 hover:-translate-y-2 hover:bg-brand-600 hover:shadow-brand-500/50 transition-all duration-300 opacity-0 invisible [&.show]:opacity-100 [&.show]:visible")
            i(class="bi bi-arrow-up-short text-3xl")
        block main 
        
        include ../partials/footer.pug
        include ../mixins/chatbot.pug
        +chatbot()
        
        script(src="https://cdn.socket.io/4.7.4/socket.io.min.js")
        script(src="/js/chat.js")
        script(src="/js/index.js?v=7") 
        script(src="/js/chatbot.js")
        script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js" integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO" crossorigin="anonymous")
        script(src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous")
        script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.min.js" integrity="sha384-RuyvpeZCpMJCqVUGFI0Do1mQrods/hhxYlcVfGPOfQtPJh0JCw12tUAZ/Mv10S7D" crossorigin="anonymous")