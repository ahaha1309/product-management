    /* Shopee style product grid uses 6 items per row, which matches col-xl-2 col-lg-2 natively. No overrides needed. */

  script.
    // Init Bootstrap Carousel for auto-slide
    document.addEventListener('DOMContentLoaded', function () {
      var myCarousel = document.querySelector('#heroCarousel');
      if (myCarousel) {
        var carousel = new bootstrap.Carousel(myCarousel, {
          interval: 3000,
          ride: 'carousel'
        });
      }
    });

    // Flash Sale Timer Animation
    function startTimer() {
      const elH = document.getElementById('h');
      const elM = document.getElementById('m');
      const elS = document.getElementById('s');
      if (!elH || !elM || !elS) return;

      // Tính toán thời gian đến cuối ngày hiện tại
      const now = new Date();
      const endOfDay = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 23, 59, 59);
      let diffSeconds = Math.floor((endOfDay - now) / 1000);

      setInterval(() => {
        if (diffSeconds > 0) {
          diffSeconds--;
        } else {
          // Reset sang ngày mới nếu đếm ngược kết thúc
          diffSeconds = 24 * 60 * 60 - 1;
        }

        const h = Math.floor(diffSeconds / 3600);
        const m = Math.floor((diffSeconds % 3600) / 60);
        const s = diffSeconds % 60;
        
        elH.innerText = h.toString().padStart(2, '0');
        elM.innerText = m.toString().padStart(2, '0');
        elS.innerText = s.toString().padStart(2, '0');
      }, 1000);
    }
    startTimer();

    // Flash Sale Slider Logic
    document.addEventListener('DOMContentLoaded', function() {
      const flashSaleContainer = document.querySelector('.flash-sale-products');
      const flashNextBtn = document.querySelector('.flash-sale-next');
      const flashPrevBtn = document.querySelector('.flash-sale-prev');
      
      if (flashSaleContainer) {
        const scrollAmt = 220; // Độ dài scroll
        let autoScrollInterval;

        const autoScroll = () => {
          // Tự động cuộn sang phải (hiển thị các item tiếp theo) -> Sản phẩm trượt sang trái
          if (flashSaleContainer.scrollLeft + flashSaleContainer.clientWidth >= flashSaleContainer.scrollWidth - 10) {
            flashSaleContainer.scrollTo({ left: 0, behavior: 'smooth' });
          } else {
            flashSaleContainer.scrollBy({ left: scrollAmt, behavior: 'smooth' });
          }
        };

        const startAutoScroll = () => {
          clearInterval(autoScrollInterval); // Đảm bảo không bị chồng interval
          if (flashSaleContainer.scrollWidth > flashSaleContainer.clientWidth) {
            autoScrollInterval = setInterval(autoScroll, 3000);
          }
        };
        const stopAutoScroll = () => { clearInterval(autoScrollInterval); };

        if(flashNextBtn) {
          flashNextBtn.addEventListener('click', () => {
            stopAutoScroll();
            flashSaleContainer.scrollBy({ left: scrollAmt, behavior: 'smooth' });
            startAutoScroll();
          });
        }
        
        if(flashPrevBtn) {
          flashPrevBtn.addEventListener('click', () => {
            stopAutoScroll();
            flashSaleContainer.scrollBy({ left: -scrollAmt, behavior: 'smooth' });
            startAutoScroll();
          });
        }

        // Tạm dừng tự cuộn khi rê chuột vào
        flashSaleContainer.addEventListener('mouseenter', stopAutoScroll);
        flashSaleContainer.addEventListener('mouseleave', startAutoScroll);
        
        // Cập nhật lại khi resize cửa sổ
        window.addEventListener('resize', () => {
          stopAutoScroll();
          startAutoScroll();
        });

        startAutoScroll();
      }
    });

    // Scroll Animation Logic
    document.addEventListener('DOMContentLoaded', function() {
      const animatedElements = document.querySelectorAll('.scroll-animate');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries, observer) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1, rootMargin: "0px 0px -50px 0px" });
        
        animatedElements.forEach(el => observer.observe(el));
      } else {
        // Fallback for older browsers
        animatedElements.forEach(el => el.classList.add('is-visible'));
      }
    });