extends ../../layouts/default.pug

block head
  style.
    .wheel-container {
      position: relative;
      width: 320px;
      height: 320px;
      margin: 0 auto;
    }
    .wheel {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      border: 8px solid #fff;
      box-shadow: 0 10px 25px rgba(0,0,0,0.1);
      position: relative;
      overflow: hidden;
      transition: transform 5s cubic-bezier(0.25, 0.1, 0.15, 1);
      background: conic-gradient(
        #10b981 0deg 60deg, 
        #f59e0b 60deg 120deg, 
        #3b82f6 120deg 180deg, 
        #ef4444 180deg 240deg, 
        #8b5cf6 240deg 300deg, 
        #ec4899 300deg 360deg
      );
    }
    .wheel-marker {
      position: absolute;
      top: -15px;
      left: 50%;
      transform: translateX(-50%);
      width: 30px;
      height: 40px;
      background: #334155;
      clip-path: polygon(50% 100%, 0 0, 100% 0);
      z-index: 10;
    }
    .wheel-center {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 60px;
      height: 60px;
      background: #fff;
      border-radius: 50%;
      z-index: 5;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 900;
      color: #334155;
      box-shadow: 0 4px 10px rgba(0,0,0,0.15);
      cursor: pointer;
    }
    .wheel-segment {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 50%;
      height: 2px;
      transform-origin: 0% 50%;
      font-weight: bold;
      color: white;
      text-transform: uppercase;
      font-size: 11px;
      text-shadow: 1px 1px 2px rgba(0,0,0,0.4);
    }
    .segment-text {
      position: absolute;
      left: 40px;
      transform: translateY(-50%);
      width: 100px;
      text-align: left;
    }

block main
  div(class="bg-gradient-to-br from-surface-50 to-surface-100 min-h-screen pb-20")
    //- Hero Banner
    div(class="relative bg-slate-900 text-white overflow-hidden py-16 md:py-24")
      div(class="absolute inset-0 opacity-20")
        div(class="absolute top-0 -left-40 w-96 h-96 bg-emerald-500 rounded-full mix-blend-screen filter blur-3xl opacity-50 animate-blob")
        div(class="absolute top-0 -right-40 w-96 h-96 bg-brand-500 rounded-full mix-blend-screen filter blur-3xl opacity-50 animate-blob animation-delay-2000")
        div(class="absolute -bottom-40 left-20 w-96 h-96 bg-purple-500 rounded-full mix-blend-screen filter blur-3xl opacity-50 animate-blob animation-delay-4000")
      div(class="container mx-auto px-4 relative z-10 text-center")
        h1(class="text-4xl md:text-5xl font-black mb-4 tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-emerald-400 via-white to-brand-400") Trung Tâm Khuyến Mãi
        p(class="text-slate-300 max-w-xl mx-auto text-sm md:text-base font-medium") Nơi tổng hợp các ưu đãi cực HOT. Săn mã giảm giá, mã Freeship để tiết kiệm tối đa khi mua sắm tại NVH Mall.

    div(class="container mx-auto px-4 -mt-10 relative z-20 grid grid-cols-1 lg:grid-cols-12 gap-8")
      //- Cột trái: Vòng quay & Bài viết
      div(class="lg:col-span-7 space-y-8")
        
        //- Vòng quay may mắn
        div(class="bg-white/80 backdrop-blur-xl border border-white/40 shadow-xl rounded-[2rem] p-8")
          div(class="text-center mb-8")
            h2(class="text-2xl font-black text-slate-800 flex items-center justify-center gap-2")
              i.bi.bi-star-fill.text-amber-400
              | Vòng Quay May Mắn
            p(class="text-xs text-slate-500 font-medium mt-1") Tham gia quay thưởng nhận ngay Voucher cực xịn.

          div.wheel-container
            div.wheel-marker
            div#wheel.wheel
              div.wheel-segment(style="transform: rotate(30deg);")
                span.segment-text Lần Sau
              div.wheel-segment(style="transform: rotate(90deg);")
                span.segment-text Voucher
              div.wheel-segment(style="transform: rotate(150deg);")
                span.segment-text Lần Sau
              div.wheel-segment(style="transform: rotate(210deg);")
                span.segment-text Voucher
              div.wheel-segment(style="transform: rotate(270deg);")
                span.segment-text Lần Sau
              div.wheel-segment(style="transform: rotate(330deg);")
                span.segment-text Freeship
            div#spinBtn.wheel-center Quay
            
        //- Bài viết hướng dẫn
        div(class="bg-white rounded-[2rem] p-8 shadow-sm border border-slate-100")
          h3(class="text-xl font-bold text-slate-800 mb-6 flex items-center gap-2")
            i.bi.bi-journal-text.text-brand-500
            | Cẩm Nang Sử Dụng Mã
          
          div(class="space-y-6")
            div(class="flex gap-4")
              div(class="w-10 h-10 shrink-0 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-lg") 1
              div
                h4(class="font-bold text-slate-900 mb-1") Mã Freeship (Miễn Phí Vận Chuyển)
                p(class="text-sm text-slate-600 leading-relaxed") Là loại mã đặc biệt giúp bạn được trừ trực tiếp 30.000₫ phí giao hàng vào tổng đơn. Hãy thu thập mã Freeship để trải nghiệm mua sắm không lo về giá ship!
            
            div(class="flex gap-4")
              div(class="w-10 h-10 shrink-0 rounded-2xl bg-brand-50 text-brand-600 flex items-center justify-center font-bold text-lg") 2
              div
                h4(class="font-bold text-slate-900 mb-1") Mã Phần Trăm (%)
                p(class="text-sm text-slate-600 leading-relaxed") Giảm trực tiếp phần trăm giá trị đơn hàng hàng. Đặc biệt có điều kiện "Giảm tối đa", hãy xem kỹ điều kiện của mỗi mã để tận dụng tối đa mức ưu đãi nhé.
                
            div(class="flex gap-4")
              div(class="w-10 h-10 shrink-0 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center font-bold text-lg") 3
              div
                h4(class="font-bold text-slate-900 mb-1") Cách áp dụng
                p(class="text-sm text-slate-600 leading-relaxed") Trong trang "Thanh Toán" (Checkout), bạn sẽ thấy phần "Mã khuyến mãi". Nhập trực tiếp mã vào ô hoặc chọn từ danh sách hiển thị sẵn bên dưới và bấm "Áp dụng".

      //- Cột phải: Danh sách Voucher
      div(class="lg:col-span-5")
        div(class="bg-white rounded-[2rem] p-6 lg:p-8 shadow-sm border border-slate-100 h-full")
          h3(class="text-xl font-bold text-slate-800 mb-6 flex items-center gap-2")
            i.bi.bi-ticket-perforated-fill.text-rose-500
            | Mã Ưu Đãi Đang Hot
            
          if vouchers && vouchers.length > 0
            div(class="space-y-4 max-h-[600px] overflow-y-auto pr-2 custom-scrollbar")
              each voucher in vouchers
                div(class="relative overflow-hidden bg-slate-50 border border-slate-200 rounded-2xl p-4 flex gap-4 transition-all hover:border-emerald-300 hover:bg-emerald-50/30 group")
                  //- Nửa trái (Icon)
                  div(class="w-16 h-16 shrink-0 rounded-xl bg-gradient-to-br from-emerald-400 to-emerald-600 text-white flex flex-col items-center justify-center shadow-inner")
                    if voucher.type === 'freeship'
                      i.bi.bi-truck.text-2xl
                    else
                      span(class="font-black text-xl") #{voucher.discountPercentage}%
                      span(class="text-[9px] uppercase tracking-wider font-bold opacity-80") Giảm
                  
                  //- Nửa phải (Info)
                  div(class="flex-1 flex flex-col justify-center")
                    div(class="flex justify-between items-start mb-1")
                      div(class="font-black text-slate-900 text-sm tracking-wide uppercase")= voucher.code
                      button.btn-copy-code(type="button" aria-label=`Copy mã ${voucher.code}` data-code=voucher.code class="text-xs font-bold text-brand-600 bg-brand-50 px-2 py-1 rounded-md hover:bg-brand-600 hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500") Copy
                    
                    if voucher.type === 'freeship'
                      p(class="text-xs text-slate-500 font-medium mb-1") Miễn phí vận chuyển (Tối đa 30K)
                    else
                      p(class="text-xs text-slate-500 font-medium mb-1") Giảm #{voucher.discountPercentage}% (Tối đa #{voucher.maxDiscountAmount.toLocaleString('vi-VN')}₫)
                      
                    if voucher.minOrderValue > 0
                      p(class="text-[10px] text-slate-400") Đơn tối thiểu: <span class="font-bold text-slate-600">#{voucher.minOrderValue.toLocaleString('vi-VN')}₫</span>
          else
            div(class="text-center py-10")
              div(class="w-20 h-20 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4")
                i.bi.bi-emoji-frown.text-3xl.text-slate-400
              p(class="text-slate-500 font-medium") Hiện chưa có mã khuyến mãi nào.
              
  //- Toast Notification cho Copy
  div#copyToast(class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-slate-900 text-white px-6 py-3 rounded-full text-sm font-bold shadow-2xl transition-all duration-300 opacity-0 invisible z-50 flex items-center gap-2")
    i.bi.bi-check-circle-fill.text-emerald-400
    span Đã copy mã vào khay nhớ tạm!

  //- Popup trúng thưởng
  div#prizeModal(class="fixed inset-0 z-[100] flex items-center justify-center opacity-0 invisible transition-all duration-300")
    div.prize-backdrop(class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm")
    div.prize-content(class="bg-white rounded-3xl p-8 max-w-sm w-full mx-4 shadow-2xl transform scale-90 transition-transform duration-300 relative overflow-hidden text-center")
      div(class="absolute -top-24 -left-24 w-48 h-48 bg-brand-200 rounded-full mix-blend-multiply filter blur-2xl opacity-70")
      div(class="absolute -bottom-24 -right-24 w-48 h-48 bg-emerald-200 rounded-full mix-blend-multiply filter blur-2xl opacity-70")
      
      div(class="relative z-10")
        div#prizeIcon(class="w-20 h-20 mx-auto rounded-full flex items-center justify-center text-4xl mb-4 shadow-lg")
        h3#prizeTitle(class="text-2xl font-black text-slate-800 mb-2")
        p#prizeDesc(class="text-sm text-slate-500 font-medium mb-6")
        
        div#prizeCodeWrap(class="hidden bg-slate-50 border-2 border-dashed border-emerald-300 rounded-xl p-4 mb-6")
          p(class="text-xs text-slate-400 font-bold uppercase tracking-wider mb-1") Mã của bạn
          p#prizeCode(class="text-2xl font-black text-emerald-600 tracking-widest")
        
        button#closePrizeBtn(type="button" class="w-full bg-slate-900 text-white font-bold py-3 rounded-xl hover:bg-slate-800 transition-colors focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-slate-900 focus-visible:ring-offset-2") Đóng lại

  script(src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js")
  script(src="/js/lucky-wheel.js")
