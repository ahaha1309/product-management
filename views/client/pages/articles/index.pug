extends ../../layouts/default.pug

block main
  //- Hero Section
  div(class="relative bg-surface-950 py-20 px-4 overflow-hidden")
    div(class="absolute inset-0 bg-gradient-to-br from-brand-900 via-surface-900 to-blue-900 opacity-90")
    div(class="absolute top-0 right-0 w-[800px] h-[800px] bg-brand-500/20 blur-[120px] rounded-full translate-x-1/2 -translate-y-1/2 pointer-events-none")
    div(class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-blue-500/20 blur-[100px] rounded-full -translate-x-1/2 translate-y-1/2 pointer-events-none")
    
    div(class="container mx-auto relative z-10 text-center max-w-3xl")
      div(class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-white text-sm font-bold tracking-wider uppercase mb-6")
        i.bi.bi-newspaper.text-brand-400
        | Tin tức & Kiến thức
      
      h1(class="text-4xl md:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight mb-6") Blog NVH Mall
      p(class="text-lg md:text-xl text-white/90 font-medium leading-relaxed drop-shadow-md max-w-2xl mx-auto") Cập nhật liên tục những xu hướng công nghệ mới nhất, thủ thuật mua sắm và thông tin hữu ích từ chuyên gia.

  div(class="container mx-auto px-4 py-12 mb-20")

    //- Category Tabs
    div(class="flex flex-wrap items-center justify-center gap-3 mb-12")
      a(href="/articles" class=`px-6 py-2.5 rounded-full text-sm font-bold transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 ${!currentCategory ? 'bg-gradient-to-r from-brand-500 to-blue-600 text-white shadow-lg shadow-brand-500/30' : 'bg-surface-100 text-surface-600 hover:bg-surface-200'}`)
        | Tất cả bài viết
      
      if categories && categories.length > 0
        each cat in categories
          - const isActive = currentCategory == cat._id.toString()
          a(href=`/articles?category=${cat._id}` class=`px-6 py-2.5 rounded-full text-sm font-bold transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 ${isActive ? 'bg-gradient-to-r from-brand-500 to-blue-600 text-white shadow-lg shadow-brand-500/30' : 'bg-surface-100 text-surface-600 hover:bg-surface-200'}`)
            | #{cat.title}

    //- Articles Grid
    if articles && articles.length > 0
      div(class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8")
        each article in articles
          a(href=`/articles/${article.slug}` class="bento-card !p-0 group flex flex-col h-full overflow-hidden hover:-translate-y-2 hover:shadow-diffusion transition-all duration-500 border border-slate-100 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-brand-500")
            //- Thumbnail
            div(class="relative h-56 overflow-hidden bg-surface-100")
              img(src=article.thumbnail || '/image/logo.png' alt=article.title width="600" height="400" loading="lazy" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 motion-reduce:transition-none motion-reduce:transform-none")
              div(class="absolute inset-0 bg-gradient-to-t from-surface-950/80 to-transparent opacity-60")
              
              div(class="absolute bottom-4 right-4 bg-white/20 backdrop-blur-md px-3 py-1.5 rounded-full text-xs font-bold text-white shadow-sm flex items-center gap-1.5 border border-white/30")
                i.bi.bi-calendar3
                span #{moment ? moment(article.createdAt).format('DD/MM/YYYY') : 'N/A'}

            //- Body
            div(class="p-6 flex flex-col flex-1")
              h5(class="text-lg font-black text-surface-900 leading-snug mb-3 group-hover:text-brand-600 transition-colors line-clamp-2")
                | #{article.title}
              
              p(class="text-sm text-surface-500 font-medium leading-relaxed mb-6 line-clamp-3")
                | !{article.description ? article.description.replace(/<[^>]*>?/gm, '').substring(0, 150) + '...' : 'Nhấn để xem chi tiết bài viết...'}
              
              div(class="mt-auto flex items-center justify-between pt-4 border-t border-slate-100")
                span(class="text-sm font-bold text-brand-600 flex items-center gap-1 group-hover:gap-2 transition-all")
                  | Đọc tiếp
                  i.bi.bi-arrow-right
                
                div(class="w-8 h-8 rounded-full bg-surface-100 flex items-center justify-center text-surface-400 group-hover:bg-brand-50 group-hover:text-brand-600 transition-colors")
                  i.bi.bi-book
    else
      div(class="bento-card text-center py-24 max-w-2xl mx-auto")
        div(class="w-24 h-24 rounded-full bg-surface-50 flex items-center justify-center mx-auto mb-6")
          i.bi.bi-newspaper.text-5xl.text-surface-300
        h5(class="text-2xl font-black text-surface-900 mb-3") Chưa có bài viết nào
        p(class="text-surface-500 font-medium mb-8") Các bài viết mới sẽ sớm được cập nhật. Cảm ơn bạn đã quan tâm!
        a(href="/product" class="btn-premium btn-primary px-8 py-3.5 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-brand-500 focus-visible:ring-offset-2") Mua sắm ngay
