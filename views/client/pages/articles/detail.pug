extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  div(class="container mx-auto px-4 py-8 mb-20")

    //- Breadcrumb
    div(class="flex items-center flex-wrap gap-2 text-sm font-medium text-surface-500 mb-8")
      a(href="/" class="hover:text-brand-600 transition-colors") Trang chủ
      i(class="bi bi-chevron-right text-[10px]")
      a(href="/articles" class="hover:text-brand-600 transition-colors") Tin tức
      i(class="bi bi-chevron-right text-[10px]")
      span(class="text-surface-900 line-clamp-1") #{article.title}

    div(class="grid grid-cols-1 lg:grid-cols-12 gap-8")
      
      //- Article content (Main Column)
      div(class="lg:col-span-8")
        div(class="bento-card !p-0 overflow-hidden mb-8")
          if article.thumbnail
            div(class="relative h-[300px] md:h-[400px] w-full")
              img(src=article.thumbnail alt=article.title class="w-full h-full object-cover")
          
          div(class="p-6 md:p-10")
            h1(class="text-3xl md:text-4xl font-black text-surface-950 tracking-tight leading-tight mb-6") #{article.title}
            
            //- Meta
            div(class="flex items-center flex-wrap gap-4 text-sm font-bold text-surface-500 uppercase tracking-wider mb-8 pb-6 border-b border-slate-100")
              div(class="flex items-center gap-2")
                i.bi.bi-calendar3.text-brand-500
                | #{moment ? moment(article.createdAt).format('DD/MM/YYYY') : 'N/A'}
              
              div(class="w-1 h-1 rounded-full bg-surface-300")
              
              div(class="flex items-center gap-2")
                i.bi.bi-clock.text-brand-500
                | 5 phút đọc
            
            //- Content
            div(class="prose prose-slate prose-lg max-w-none prose-headings:font-black prose-a:text-brand-600 prose-img:rounded-2xl prose-img:shadow-sm")
              | !{article.description}

            //- Share Section
            div(class="mt-12 pt-8 border-t border-slate-100")
              h6(class="text-sm font-bold text-surface-900 uppercase tracking-wider mb-4") Chia sẻ bài viết:
              div(class="flex flex-wrap gap-3")
                a(href="https://www.facebook.com/sharer/sharer.php" target="_blank" class="px-5 py-2.5 rounded-xl bg-[#1877F2] text-white text-sm font-bold hover:bg-[#166FE5] transition-colors flex items-center gap-2 shadow-sm shadow-[#1877F2]/30")
                  i.bi.bi-facebook
                  | Facebook
                a(href="#" class="px-5 py-2.5 rounded-xl bg-[#1DA1F2] text-white text-sm font-bold hover:bg-[#1A91DA] transition-colors flex items-center gap-2 shadow-sm shadow-[#1DA1F2]/30")
                  i.bi.bi-twitter
                  | Twitter
                a(href="#" class="px-5 py-2.5 rounded-xl bg-[#25D366] text-white text-sm font-bold hover:bg-[#22BF5B] transition-colors flex items-center gap-2 shadow-sm shadow-[#25D366]/30")
                  i.bi.bi-whatsapp
                  | WhatsApp

        //- Comments Section
        div(class="bento-card")
          h4(class="text-2xl font-black text-surface-900 mb-6 flex items-center gap-3") 
            i.bi.bi-chat-dots.text-brand-500
            | Bình luận (#{comments ? comments.length : 0})
          
          div(class="mb-8")
            if user
              div(class="relative")
                textarea#article-comment-input(rows="3" placeholder="Chia sẻ suy nghĩ của bạn về bài viết..." class="w-full bg-surface-50 border border-slate-200 rounded-2xl p-4 text-sm font-medium focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all resize-none")
                div(class="mt-3 flex justify-end")
                  button(type="button" onclick="submitArticleComment()" class="btn-premium btn-premium-primary px-8 py-2.5 text-sm")
                    i.bi.bi-send.mr-2
                    | Gửi bình luận
            else
              div(class="bg-blue-50 border border-blue-100 rounded-2xl p-5 flex items-center gap-4")
                div(class="w-12 h-12 rounded-full bg-white flex items-center justify-center text-blue-500 shadow-sm shrink-0")
                  i.bi.bi-info-circle-fill.text-xl
                div
                  p(class="text-sm font-medium text-blue-900") Vui lòng đăng nhập để tham gia bình luận bài viết này.
                  a(href="/auth/login" class="inline-block mt-2 text-sm font-bold text-blue-700 hover:underline") Đăng nhập ngay →

          div#article-comment-list(class="space-y-6")
            if comments && comments.length > 0
              each comment in comments
                div(class="flex gap-4 p-4 rounded-2xl bg-surface-50/50 border border-slate-100 transition-colors hover:bg-surface-50")
                  img(src=comment.userAvatar class="w-12 h-12 rounded-full object-cover border-2 border-white shadow-sm shrink-0")
                  div(class="flex-1")
                    div(class="flex items-center justify-between mb-1")
                      div(class="font-bold text-surface-900 text-sm") #{comment.userName}
                      div(class="text-xs font-semibold text-surface-400 uppercase tracking-wider") #{moment ? moment(comment.createdAt).fromNow() : 'Vừa xong'}
                    p(class="text-sm text-surface-700 leading-relaxed") #{comment.text}
            else
              div#no-comments(class="text-center py-10")
                i.bi.bi-chat-left-text.text-4xl.text-surface-200.mb-3.block
                p(class="text-sm font-medium text-surface-500") Hãy là người đầu tiên bình luận về bài viết này!

      //- Sidebar (Right Column)
      div(class="lg:col-span-4")
        div(class="sticky top-24 space-y-6")
          
          //- Recent articles
          if recentArticles && recentArticles.length > 0
            div(class="bento-card !p-5")
              h6(class="text-sm font-bold text-surface-900 uppercase tracking-wider mb-5 flex items-center gap-2")
                i.bi.bi-clock-history.text-brand-500
                | Bài viết gần đây
              
              div(class="flex flex-col gap-4")
                each recent in recentArticles
                  a(href=`/articles/${recent.slug}` class="group flex gap-3 p-2 -mx-2 rounded-xl hover:bg-surface-50 transition-colors")
                    div(class="w-20 h-20 rounded-lg overflow-hidden shrink-0 bg-surface-100")
                      if recent.thumbnail
                        img(src=recent.thumbnail alt=recent.title class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500")
                      else
                        div(class="w-full h-full flex items-center justify-center text-surface-400")
                          i.bi.bi-image
                    
                    div(class="flex flex-col justify-center")
                      div(class="text-sm font-bold text-surface-900 line-clamp-2 mb-1 group-hover:text-brand-600 transition-colors") #{recent.title}
                      div(class="text-xs font-semibold text-surface-400 uppercase tracking-wider") #{moment ? moment(recent.createdAt).format('DD/MM/YYYY') : ''}

          //- CTA
          div(class="bento-card bg-gradient-to-br from-brand-900 to-blue-950 text-white relative overflow-hidden")
            div(class="absolute top-0 right-0 w-32 h-32 bg-brand-500/30 blur-2xl rounded-full translate-x-1/2 -translate-y-1/2")
            div(class="relative z-10 text-center")
              div(class="w-16 h-16 rounded-2xl bg-white/10 backdrop-blur-md flex items-center justify-center mx-auto mb-4 border border-white/20")
                i.bi.bi-bag-heart.text-3xl.text-brand-300
              h6(class="text-xl font-black mb-2") Mua sắm ngay!
              p(class="text-sm font-medium text-brand-100/80 mb-6") Hàng nghìn sản phẩm chính hãng công nghệ mới nhất đang chờ bạn khám phá.
              a(href="/product" class="btn-premium btn-premium-primary w-full py-3 shadow-brand-500/30")
                i.bi.bi-shop.mr-2
                | Xem sản phẩm

  script.
    async function submitArticleComment() {
      const input = document.getElementById('article-comment-input');
      const list = document.getElementById('article-comment-list');
      const noComments = document.getElementById('no-comments');
      
      if(!input || !list) return;

      const text = input.value.trim();
      if(!text) return; 

      const btn = input.nextElementSibling.querySelector('button');
      const originalText = btn.innerHTML;
      btn.disabled = true;
      input.disabled = true;
      btn.innerHTML = '<i class="bi bi-arrow-repeat animate-spin mr-2"></i>Đang gửi...';

      try {
        const baseUrl = window.location.pathname.replace(/\/$/, '');
        const response = await fetch(baseUrl + '/comment', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ text })
        });
        
        let data;
        const contentType = response.headers.get("content-type");
        if (contentType && contentType.indexOf("application/json") !== -1) {
          data = await response.json();
        } else {
          throw new Error('Server không trả về JSON (có thể là lỗi 404 hoặc 500 HTML). HTTP Status: ' + response.status);
        }

        if (data.success && data.comment) {
          const safeText = text.replace(/</g, "&lt;").replace(/>/g, "&gt;");
          
          if(noComments) noComments.remove();

          const newComment = document.createElement('div');
          newComment.className = 'flex gap-4 p-4 rounded-2xl bg-brand-50 border border-brand-100 mb-4 animate-fade-in';
          newComment.innerHTML = `
            <img class="w-12 h-12 rounded-full object-cover border-2 border-white shadow-sm shrink-0" src="${data.comment.userAvatar}">
            <div class="flex-1">
              <div class="flex items-center justify-between mb-1">
                <div class="font-bold text-surface-900 text-sm">${data.comment.userName}</div>
                <div class="text-xs font-semibold text-brand-600 uppercase tracking-wider">Vừa xong</div>
              </div>
              <p class="text-sm text-surface-700 leading-relaxed">${safeText}</p>
            </div>
          `;
          
          list.prepend(newComment);
          input.value = '';
        } else {
          alert('Lỗi: ' + (data.message || 'Không xác định'));
        }
      } catch (error) {
        console.error(error);
        alert('Lỗi catch: ' + error.message);
      } finally {
        input.disabled = false;
        btn.disabled = false;
        btn.innerHTML = originalText;
      }
    }
