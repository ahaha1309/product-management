extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main 
  div(class="container mx-auto px-4 max-w-3xl py-12 mb-20")
    div(class="bento-card border border-slate-100")
      
      div(class="text-center mb-10")
        div(class="w-16 h-16 rounded-full bg-brand-50 text-brand-600 flex items-center justify-center mx-auto mb-4 text-2xl")
          i.bi.bi-pencil-square
        h1(class="text-3xl font-black text-surface-950 tracking-tight") Chỉnh sửa thông tin
        p(class="text-surface-500 font-medium mt-2") Cập nhật dữ liệu cá nhân của bạn để trải nghiệm tốt hơn
        
      form(method="POST" action=`/my-account/edit/${user._id}` enctype="multipart/form-data" class="space-y-6")
        
        //- Avatar Upload
        div(class="flex flex-col items-center justify-center mb-10")
          button(type="button" aria-label="Tải ảnh đại diện lên" class="relative group cursor-pointer focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-brand-500 rounded-full" onclick="document.getElementById('avatarInput').click()")
            img#avatarPreview(src=user.avatar || 'https://via.placeholder.com/150?text=No+Avatar' alt='Avatar' width="128" height="128" class="w-32 h-32 rounded-full border-4 border-surface-100 object-cover bg-surface-50 group-hover:border-brand-200 transition-colors shadow-sm")
            div(class="absolute inset-0 bg-black/40 rounded-full opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center")
              i.bi.bi-camera.text-white.text-2xl(aria-hidden="true")
            
            div(class="absolute bottom-0 right-0 w-10 h-10 bg-brand-500 text-white rounded-full flex items-center justify-center border-4 border-white shadow-md transition-transform group-hover:scale-110")
              i.bi.bi-upload.text-sm(aria-hidden="true")
              
          input#avatarInput(type="file" name="avatar" accept="image/*" class="hidden")
          p(class="text-xs text-surface-400 mt-4 font-medium uppercase tracking-wider") Định dạng: JPG, PNG (Max 2MB)

        div(class="grid grid-cols-1 md:grid-cols-2 gap-6")
          //- Full Name
          div(class="md:col-span-2")
            label(class="block text-sm font-bold text-surface-700 mb-1.5") Họ và tên <span class="text-rose-500">*</span>
            div(class="relative")
              i.bi.bi-person.absolute.left-4.top-1.translate-y-1.text-surface-400
              input(type="text" name="fullName" value=(user.fullName || '') placeholder="Nguyễn Văn A" required class="w-full bg-surface-50 border border-slate-200 rounded-xl py-3 pl-11 pr-4 text-sm font-medium focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all")
              
          //- Email
          div
            label(class="block text-sm font-bold text-surface-700 mb-1.5") Email <span class="text-rose-500">*</span>
            div(class="relative")
              i.bi.bi-envelope.absolute.left-4.top-1.translate-y-1.text-surface-400
              input(type="email" name="email" value=(user.email || '') placeholder="email@example.com" required class="w-full bg-surface-50 border border-slate-200 rounded-xl py-3 pl-11 pr-4 text-sm font-medium focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all")

          //- Phone
          div
            label(class="block text-sm font-bold text-surface-700 mb-1.5") Số điện thoại <span class="text-rose-500">*</span>
            div(class="relative")
              i.bi.bi-telephone.absolute.left-4.top-1.translate-y-1.text-surface-400
              input(type="tel" name="phone" value=(user.phone || '') placeholder="0123456789" required class="w-full bg-surface-50 border border-slate-200 rounded-xl py-3 pl-11 pr-4 text-sm font-medium focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all")

          //- Address
          div(class="md:col-span-2")
            label(class="block text-sm font-bold text-surface-700 mb-1.5") Địa chỉ giao hàng <span class="text-rose-500">*</span>
            div(class="relative")
              i.bi.bi-geo-alt.absolute.left-4.top-1.translate-y-1.text-surface-400
              input(type="text" name="address" value=(user.address || '') placeholder="Số nhà, Đường, Phường/Xã, Quận/Huyện..." required class="w-full bg-surface-50 border border-slate-200 rounded-xl py-3 pl-11 pr-4 text-sm font-medium focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all")

        div(class="flex flex-col sm:flex-row gap-3 mt-10 pt-8 border-t border-slate-100")
          button(type="submit" class="btn-premium btn-primary flex-1 py-3.5 text-base focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-brand-500 focus-visible:ring-offset-2") Lưu thay đổi
          a(href=`/my-account/${user._id}` class="px-8 py-3.5 rounded-xl border border-slate-200 text-sm font-bold text-surface-600 hover:bg-surface-50 transition-colors text-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500") Hủy bỏ

  script.
    // Preview Avatar Image
    const avatarInput = document.getElementById('avatarInput');
    const avatarPreview = document.getElementById('avatarPreview');

    avatarInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) {
        // Validate size (2MB)
        if (file.size > 2 * 1024 * 1024) {
          alert('Ảnh quá lớn! Tối đa 2MB');
          avatarInput.value = '';
          return;
        }

        // Validate format
        if (!file.type.startsWith('image/')) {
          alert('Vui lòng chọn file ảnh!');
          avatarInput.value = '';
          return;
        }

        // Preview
        const reader = new FileReader();
        reader.onload = (event) => {
          avatarPreview.src = event.target.result;
        };
        reader.readAsDataURL(file);
      }
    });