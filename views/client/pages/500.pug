extends ../layouts/default.pug

block main
  //- 500 Split Layout Wrapper
  div(class="min-h-[85vh] flex flex-col lg:flex-row items-center justify-center bg-surface-50 px-4 md:px-12 py-16")
    
    //- Left Side (Visuals)
    div(class="w-full lg:w-1/2 flex flex-col items-center lg:items-end justify-center pr-0 lg:pr-16 mb-12 lg:mb-0")
      div(class="relative")
        //- Decorative Background
        div(class="absolute inset-0 bg-rose-500/20 blur-[80px] rounded-full")
        
        //- 500 Illustration
        div(class="relative z-10 w-64 h-64 md:w-80 md:h-80 rounded-full border-8 border-white shadow-2xl bg-white flex items-center justify-center animate-[float_6s_ease-in-out_infinite] motion-reduce:animate-none")
          i(class="bi bi-exclamation-triangle text-[120px] text-rose-500 drop-shadow-md")
          
        //- Badge
        div(class="absolute -bottom-6 -right-6 bg-brand-500 text-white font-black text-2xl md:text-3xl px-6 py-4 rounded-3xl shadow-xl shadow-brand-500/30 -rotate-12") 500

    //- Right Side (Content & CTAs)
    div(class="w-full lg:w-1/2 flex flex-col items-center lg:items-start text-center lg:text-left pl-0 lg:pl-16 border-t lg:border-t-0 lg:border-l border-slate-200/60 pt-12 lg:pt-0")
      
      div(class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-rose-50 text-rose-600 font-bold text-sm mb-6")
        i.bi.bi-cone-striped
        span Lỗi máy chủ cục bộ

      h1(class="text-4xl md:text-5xl font-black text-surface-900 mb-6 leading-tight tracking-tight")
        | Hệ thống đang
        br
        span(class="text-rose-500") bảo trì
        |  vài phút...

      p(class="text-lg text-surface-500 mb-10 max-w-md leading-relaxed")
        | Rất xin lỗi sự bất tiện này! Hệ thống máy chủ của chúng tôi đang gặp chút sự cố và đội ngũ kỹ thuật đang cố gắng khắc phục nhanh nhất có thể.

      //- Action Buttons
      div(class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto")
        button(type="button" onclick="window.location.reload()" class="btn-premium btn-primary w-full sm:w-auto px-8 py-4 flex items-center justify-center gap-2 text-base focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-brand-500 focus-visible:ring-offset-2")
          i.bi.bi-arrow-clockwise(aria-hidden="true")
          | Thử tải lại trang

        a(href="/" class="btn-premium bg-white text-surface-700 border border-slate-200 hover:border-brand-500 hover:text-brand-500 w-full sm:w-auto px-8 py-4 flex items-center justify-center gap-2 text-base shadow-sm focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-brand-500 focus-visible:ring-offset-2")
          i.bi.bi-house-door(aria-hidden="true")
          | Về Trang Chủ

      //- Quick Links
      div(class="mt-12 w-full max-w-md")
        p(class="text-sm font-semibold text-surface-400 uppercase tracking-wider mb-4") Cần hỗ trợ ngay?
        div(class="flex flex-wrap items-center justify-center lg:justify-start gap-3")
          a(href="tel:19001234" class="px-5 py-2.5 rounded-xl bg-surface-100 text-surface-600 text-sm font-medium hover:bg-surface-200 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500") 📞 Gọi Hotline: 1900 1234
          a(href="/contact" class="px-5 py-2.5 rounded-xl bg-surface-100 text-surface-600 text-sm font-medium hover:bg-surface-200 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500") 🎧 Liên hệ CSKH
