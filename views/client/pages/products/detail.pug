extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-success(messages.success)

  div(class="container mx-auto px-4 max-w-7xl py-8 mb-20")

    //- Breadcrumb
    nav(class="flex items-center gap-2 text-sm text-surface-500 mb-8 overflow-x-auto hide-scrollbar whitespace-nowrap")
      a(href="/" class="hover:text-brand-500 transition-colors") Trang chủ
      i(class="bi bi-chevron-right text-[10px]")
      a(href="/product" class="hover:text-brand-500 transition-colors") Sản phẩm
      if product.category
        i(class="bi bi-chevron-right text-[10px]")
        a(href=`/product/c/${product.category.slug}` class="hover:text-brand-500 transition-colors") #{product.category.title}
      i(class="bi bi-chevron-right text-[10px]")
      span(class="text-surface-900 font-medium truncate max-w-xs") #{product.title}

    div(class="grid grid-cols-1 lg:grid-cols-12 gap-12")
      //- Left: Sticky Product Gallery (Spans 5)
      div(class="lg:col-span-5")
        div(class="sticky top-24")
          //- Main Image
          div(class="relative aspect-square rounded-[2rem] overflow-hidden bg-surface-50 border border-slate-100 shadow-sm group mb-4")
            img#main-image(src=product.thumbnail alt=product.title class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105")
            if product.discountPercentage > 0
              div(class="absolute top-4 right-4 bg-rose-500 text-white px-3 py-1.5 rounded-xl font-bold shadow-md tracking-wide z-10")
                | -#{product.discountPercentage}%
            if product.stock <= 0
              div(class="absolute top-4 left-4 bg-surface-900/80 backdrop-blur-md text-white px-3 py-1.5 rounded-xl font-medium shadow-sm z-10")
                | Hết hàng

          //- Thumbnails
          if variants && variants.length > 0
            div(class="flex overflow-x-auto snap-x gap-3 pb-2 hide-scrollbar")
              each v, index in variants
                - const vImg = (v.images && v.images[0]) ? v.images[0].url : product.thumbnail
                - const vColor = (v.attributes && v.attributes.color) ? v.attributes.color : ''
                img.thumbnail-item(src=vImg alt=vColor class=`w-20 h-20 rounded-xl object-cover cursor-pointer border-2 transition-all shrink-0 snap-start ${index === 0 ? 'border-brand-500 opacity-100' : 'border-transparent opacity-60 hover:opacity-100'}` onclick=`selectVariantImage(this, '${vImg}', '${vColor}')`)
          else if product.images && product.images.length > 0
            div(class="flex overflow-x-auto snap-x gap-3 pb-2 hide-scrollbar")
              each img, index in product.images
                img.thumbnail-item(src=img alt=product.title class=`w-20 h-20 rounded-xl object-cover cursor-pointer border-2 transition-all shrink-0 snap-start ${index === 0 ? 'border-brand-500 opacity-100' : 'border-transparent opacity-60 hover:opacity-100'}` onclick=`changeMainImage(this, '${img}')`)

      //- Right: Product Info (Spans 7)
      div(class="lg:col-span-7 flex flex-col")
        
        if product.category
          div(class="mb-3")
            a(href=`/product/c/${product.category.slug}` class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-50 text-brand-600 text-xs font-semibold tracking-wide")
              i.bi.bi-tag-fill
              | #{product.category.title}

        h1(class="text-3xl md:text-4xl font-bold text-surface-950 tracking-tight leading-tight mb-4") #{product.title}

        div(class="flex items-center gap-4 mb-6 flex-wrap")
          div(class="flex items-center gap-1 text-warning")
            - for(let i=1; i<=5; i++)
              if i <= Math.round(averageRating || 5)
                i.bi.bi-star-fill
              else
                i.bi.bi-star
          span(class="text-surface-500 text-sm") (#{averageRating || 5}/5 · #{reviews ? reviews.length : 0} đánh giá)
          
          div(class="w-1 h-1 rounded-full bg-surface-300")
          
          if product.stock > 0
            span(class="flex items-center gap-1.5 text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-lg text-sm font-medium")
              i.bi.bi-check-circle-fill
              | Còn #{product.stock} sản phẩm
          else
            span(class="flex items-center gap-1.5 text-rose-600 bg-rose-50 px-2.5 py-1 rounded-lg text-sm font-medium")
              i.bi.bi-x-circle-fill
              | Hết hàng

        //- Price Box
        div(class="bg-surface-50/50 border border-slate-100 rounded-3xl p-6 mb-8")
          div(class="flex items-end gap-3 mb-2")
            div(class="text-4xl md:text-5xl font-black text-brand-600 tracking-tighter")
              | ₫#{product.newPrice.toLocaleString('vi-VN')}
            if product.discountPercentage > 0
              div(class="text-lg text-surface-400 line-through mb-1 font-medium")
                | ₫#{product.price.toLocaleString('vi-VN')}

          div(class="flex items-center gap-2 mt-4 pt-4 border-t border-slate-200/60 text-sm")
            i.bi.bi-coin.text-amber-500.text-lg
            span(class="text-surface-600") Nhận 
            span(class="font-bold text-amber-500") #{Math.floor(product.newPrice * 0.01).toLocaleString('vi-VN')} Xu 
            span(class="text-surface-500") (Tương đương ₫#{Math.floor(product.newPrice * 0.01).toLocaleString('vi-VN')})

        //- Promo / Vouchers
        div(class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8")
          div(class="bento-card !p-4 !rounded-2xl !shadow-sm flex items-start gap-3 border-emerald-100 bg-emerald-50/30")
            i.bi.bi-ticket-perforated.text-emerald-600.text-xl
            div
              h4(class="font-semibold text-surface-900 text-sm mb-1") Mã giảm giá
              div(class="flex gap-2 flex-wrap")
                span(class="text-[10px] font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded border border-emerald-200") GIẢM 10K
                span(class="text-[10px] font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded border border-emerald-200") GIẢM 5%
          
          div(class="bento-card !p-4 !rounded-2xl !shadow-sm flex items-start gap-3 border-blue-100 bg-blue-50/30")
            i.bi.bi-truck.text-blue-600.text-xl
            div
              h4(class="font-semibold text-surface-900 text-sm mb-1") Vận chuyển
              p(class="text-xs text-surface-600 leading-relaxed") Miễn phí vận chuyển toàn quốc. Xử lý đơn hàng bởi hệ thống VanHa.

        //- Shop Info
        div(class="flex items-center justify-between p-4 border border-slate-100 rounded-2xl bg-white mb-8")
          div(class="flex items-center gap-4")
            img(src="https://ui-avatars.com/api/?name=VanHa+Tech&background=0d9488&color=fff" alt="Shop Avatar" class="w-12 h-12 rounded-full")
            div
              div(class="font-bold text-surface-950 flex items-center gap-1.5")
                span(class="bg-brand-500 text-white text-[10px] uppercase font-bold px-1.5 py-0.5 rounded") Mall
                | VanHa Tech Store
              div(class="text-xs text-surface-500 mt-0.5") Online 5 phút trước
          
          div(class="flex gap-2")
            button(onclick=`openProductChat('${product.title.replace(/'/g, "\\'")}')` class="px-4 py-2 rounded-xl text-sm font-medium border border-surface-200 text-surface-700 hover:border-brand-500 hover:text-brand-600 transition-colors flex items-center gap-2")
              i.bi.bi-chat-dots
              span(class="hidden sm:inline") Chat
            a(href="/" class="px-4 py-2 rounded-xl text-sm font-medium border border-surface-200 text-surface-700 hover:border-brand-500 hover:text-brand-600 transition-colors flex items-center gap-2")
              i.bi.bi-shop
              span(class="hidden sm:inline") Xem Shop

        //- Add to Cart Form
        if product.stock > 0
          form.form-add-cart(action=`/cart/add/${product._id}` method="POST" formSubmit id="addCartForm" class="mt-auto")
            input(type="hidden" name="variantText" id="variantInputVal" value="")
            
            div(class="flex items-center gap-4 mb-6")
              span(class="text-surface-700 font-medium") Số lượng:
              div(class="flex items-center bg-surface-50 border border-slate-200 rounded-xl overflow-hidden")
                button(type="button" onclick="changeQty(-1)" class="w-10 h-10 flex items-center justify-center text-surface-500 hover:bg-surface-200 transition-colors")
                  i.bi.bi-dash
                input(type="number" name="quantity" value="1" min="1" max=product.stock slug=product.slug id="qty-input" class="w-12 h-10 text-center bg-transparent border-none focus:outline-none font-semibold text-surface-900 appearance-none m-0")
                button(type="button" onclick="changeQty(1)" class="w-10 h-10 flex items-center justify-center text-surface-500 hover:bg-surface-200 transition-colors")
                  i.bi.bi-plus
            
            div(class="grid grid-cols-1 sm:grid-cols-2 gap-4")
              button.btn-action-main(type="button" action-type="cart" class="btn-premium bg-brand-50 text-brand-600 border border-brand-200 hover:bg-brand-100 w-full py-4 text-base")
                i.bi.bi-cart-plus.text-xl.mr-2
                | Thêm vào giỏ
              button.btn-action-main(type="button" action-type="checkout" class="btn-premium btn-premium-primary w-full py-4 text-base shadow-brand-500/40")
                | Mua ngay
            
            button.wishlist-btn-main(type="button" class=`mt-4 w-full py-3 rounded-xl font-medium flex items-center justify-center gap-2 transition-all border ${isWishlisted ? 'border-rose-200 bg-rose-50 text-rose-600' : 'border-slate-200 bg-white text-surface-700 hover:border-slate-300'}` onclick=`toggleWishlist('${product._id}')`)
              i.bi(class=(isWishlisted ? "bi-heart-fill text-rose-500" : "bi-heart"))
              | Yêu Thích Sản Phẩm

    //- Product Content Sections (Bento Stack)
    div(class="mt-20 max-w-4xl mx-auto space-y-8")
      
      //- Description Section
      div(class="bento-card")
        h2(class="text-2xl font-bold text-surface-950 mb-6 flex items-center gap-3")
          i.bi.bi-info-circle.text-brand-500
          | Chi tiết sản phẩm
        div(class="prose prose-slate max-w-none text-surface-600 leading-relaxed")
          | !{product.description}

      //- Specs & Installment Section
      div(class="grid grid-cols-1 md:grid-cols-2 gap-8")
        div(class="bento-card")
          h2(class="text-xl font-bold text-surface-950 mb-6") Thông số kỹ thuật
          div(class="space-y-3 text-sm")
            div(class="flex justify-between py-2 border-b border-slate-100")
              span(class="text-surface-500") Vi xử lý
              span(class="font-medium text-surface-900") Snapdragon / Apple Silicon
            div(class="flex justify-between py-2 border-b border-slate-100")
              span(class="text-surface-500") RAM
              span(class="font-medium text-surface-900") 16GB / 32GB
            div(class="flex justify-between py-2 border-b border-slate-100")
              span(class="text-surface-500") Lưu trữ
              span(class="font-medium text-surface-900") 512GB SSD / 1TB
            div(class="flex justify-between py-2 border-b border-slate-100")
              span(class="text-surface-500") Màn hình
              span(class="font-medium text-surface-900") OLED 120Hz

        div(class="bento-card bg-surface-950 text-white")
          h2(class="text-xl font-bold mb-2") Trả góp 0%
          p(class="text-surface-400 text-sm mb-6") Chỉ từ #{Math.round((product.newPrice * 0.7) / 6).toLocaleString('vi-VN')}₫/tháng
          
          div(class="space-y-4 mb-6")
            div
              label(class="text-xs text-surface-400 mb-1 block uppercase tracking-wider") Trả trước (30%)
              div(class="font-semibold text-lg") ₫#{(product.newPrice * 0.3).toLocaleString('vi-VN')}
            div
              label(class="text-xs text-surface-400 mb-1 block uppercase tracking-wider") Kỳ hạn
              select#instMonths(class="bg-surface-900 border border-surface-800 text-white text-sm rounded-lg w-full p-2.5 focus:border-brand-500 focus:ring-1 focus:ring-brand-500")
                option(value="6") 6 Tháng
                option(value="9") 9 Tháng
                option(value="12") 12 Tháng
                
          div(class="pt-4 border-t border-surface-800")
            div(class="text-xs text-surface-400 mb-1") Mỗi tháng trả khoảng:
            div#instMonthly(class="text-3xl font-bold text-brand-400")
              | #{Math.round((product.newPrice * 0.7) / 6).toLocaleString('vi-VN')}₫

      //- Reviews Section
      div(class="bento-card")
        div(class="flex items-center justify-between mb-8")
          h2(class="text-2xl font-bold text-surface-950 flex items-center gap-3")
            i.bi.bi-chat-quote.text-brand-500
            | Đánh giá khách hàng (#{product.reviewCount || reviews ? reviews.length : 0})
          
          if isLogin
            button(data-bs-toggle="modal" data-bs-target="#reviewModal" class="btn-premium btn-premium-primary py-2 px-4 text-sm")
              i.bi.bi-pencil.mr-2
              | Viết đánh giá
          else
            a(href="/auth/login" class="btn-premium bg-surface-100 text-surface-700 py-2 px-4 text-sm") Đăng nhập để đánh giá

        if reviews && reviews.length > 0
          div(class="space-y-6")
            each review in reviews
              div(class="border-b border-slate-100 pb-6 last:border-0 last:pb-0")
                div(class="flex gap-4")
                  img(src="https://ui-avatars.com/api/?name=User&background=random" class="w-10 h-10 rounded-full")
                  div(class="flex-1")
                    div(class="flex items-center justify-between mb-1")
                      div(class="font-bold text-surface-900 text-sm") Người dùng ẩn danh
                      div(class="text-xs text-surface-400") #{new Date(review.createdAt).toLocaleDateString('vi-VN')}
                    
                    div(class="flex items-center gap-1 text-warning text-xs mb-2")
                      - for(let i=1; i<=5; i++)
                        if i <= review.rating
                          i.bi.bi-star-fill
                        else
                          i.bi.bi-star
                          
                    if review.variantText
                      div(class="text-xs text-surface-500 mb-2 bg-surface-50 inline-block px-2 py-1 rounded") Phân loại: #{review.variantText}
                      
                    p(class="text-surface-700 text-sm leading-relaxed mb-3") #{review.content || review.comment}
                    
                    if review.images && review.images.length > 0
                      div(class="flex gap-2 flex-wrap")
                        each img in review.images
                          img(src=img class="w-16 h-16 rounded-lg object-cover border border-slate-200")
        else
          div(class="text-center py-12")
            div(class="w-16 h-16 bg-surface-50 rounded-full flex items-center justify-center mx-auto mb-4 text-surface-300 text-2xl")
              i.bi.bi-chat-dots
            p(class="text-surface-500 font-medium") Chưa có đánh giá nào. Hãy là người đầu tiên!

  //- Modals from original logic preserved but restyled
  if isLogin
    #reviewModal.modal.fade(tabindex="-1" aria-hidden="true")
      .modal-dialog.modal-dialog-centered
        .modal-content.border-0.rounded-3xl.shadow-diffusion.overflow-hidden
          .modal-header.border-b.border-slate-100.bg-surface-50.px-6.py-4
            h5.modal-title.font-bold.text-surface-900 Đánh giá sản phẩm
            button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
          .modal-body.p-6
            form#popupReviewForm
              input(type="hidden" name="productId" value=product._id)
              input(type="hidden" name="rating" id="ratingInput" value="5")
              .mb-6.text-center
                label.block.text-sm.font-semibold.text-surface-700.mb-3 Đánh giá của bạn
                .interactive-stars.text-3xl.text-warning.flex.justify-center.gap-2.cursor-pointer
                  i.bi.bi-star-fill.star-item(data-val="1")
                  i.bi.bi-star-fill.star-item(data-val="2")
                  i.bi.bi-star-fill.star-item(data-val="3")
                  i.bi.bi-star-fill.star-item(data-val="4")
                  i.bi.bi-star-fill.star-item(data-val="5")
              .mb-4
                label.block.text-sm.font-semibold.text-surface-700.mb-2 Nội dung
                textarea.form-control.rounded-xl.border-slate-200.text-sm(name="comment" rows="4" required placeholder="Chia sẻ trải nghiệm của bạn về sản phẩm...")
              .mb-6
                label.block.text-sm.font-semibold.text-surface-700.mb-2 Thêm hình ảnh
                input.form-control.rounded-xl.text-sm(type="file" name="images" multiple accept="image/*")
              button.btn-premium.btn-premium-primary.w-full.py-3(type="submit") Gửi đánh giá

  //- Variant Modal
  if variantAttributes && (variantAttributes.colors.length > 0 || variantAttributes.storages.length > 0 || variantAttributes.sizes.length > 0)
    #variantModal.modal.fade(tabindex="-1" aria-hidden="true")
      .modal-dialog.modal-dialog-centered.modal-dialog-scrollable
        .modal-content.border-0.rounded-3xl.shadow-diffusion
          .modal-header.border-0.pb-0.flex.justify-end
            button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
          .modal-body.px-6.pb-6
            .flex.gap-4.mb-6.pb-6.border-b.border-slate-100
              img#modal-img(src=product.thumbnail class="w-24 h-24 rounded-2xl object-cover border border-slate-100 shadow-sm")
              div.flex.flex-col.justify-center
                .text-2xl.font-bold.text-brand-600 ₫#{product.newPrice.toLocaleString('vi-VN')}
                .text-sm.text-surface-500 Kho: #{product.stock}
            
            .variants-section.space-y-6
              if variantAttributes.storages.length > 0
                div
                  .text-sm.font-bold.text-surface-900.mb-3 Dung Lượng
                  .flex.flex-wrap.gap-2
                    each storage in variantAttributes.storages
                      button.variant-btn(type="button" class="px-4 py-2 rounded-xl border border-slate-200 text-sm font-medium text-surface-700 hover:border-brand-500 hover:text-brand-600 transition-colors focus:ring-2 focus:ring-brand-500/20") #{storage}
              
              if variantAttributes.sizes.length > 0
                div
                  .text-sm.font-bold.text-surface-900.mb-3 Kích Thước
                  .flex.flex-wrap.gap-2
                    each size in variantAttributes.sizes
                      button.variant-btn(type="button" class="px-4 py-2 rounded-xl border border-slate-200 text-sm font-medium text-surface-700 hover:border-brand-500 hover:text-brand-600 transition-colors focus:ring-2 focus:ring-brand-500/20") #{size}
                      
              if variantAttributes.colors.length > 0
                div
                  .text-sm.font-bold.text-surface-900.mb-3 Màu Sắc
                  .flex.flex-wrap.gap-2
                    each color in variantAttributes.colors
                      button.variant-btn(type="button" class="px-4 py-2 rounded-xl border border-slate-200 text-sm font-medium text-surface-700 hover:border-brand-500 hover:text-brand-600 transition-colors focus:ring-2 focus:ring-brand-500/20") #{color}
                      
          .modal-footer.border-0.px-6.pb-6.pt-0
            button#confirmVariantBtn.btn-premium.btn-premium-primary.w-full.py-3(type="button") Xác Nhận

  script.
    //- Keep exact same logic to preserve backend functionality
    document.addEventListener('DOMContentLoaded', function () {
      const isLogin = !{JSON.stringify(isLogin)};

      // Quantity buttons
      window.changeQty = function(delta) {
        const inputMain = document.getElementById('qty-input');
        const inputModal = document.getElementById('qty-modal-input');
        
        let max = 99;
        let val = 1;
        
        if (inputMain) {
          max = parseInt(inputMain.getAttribute('max')) || 99;
          val = parseInt(inputMain.value) + delta;
        } else if (inputModal) {
          max = parseInt(inputModal.getAttribute('max')) || 99;
          val = parseInt(inputModal.value) + delta;
        }
        
        if (val < 1) val = 1;
        if (val > max) val = max;
        
        if (inputMain) inputMain.value = val;
        if (inputModal) inputModal.value = val;
      };

      // Change Main Image
      window.changeMainImage = function(element, src) {
        document.getElementById('main-image').src = src;
        const modalImg = document.getElementById('modal-img');
        if (modalImg) modalImg.src = src;
        
        document.querySelectorAll('.thumbnail-item').forEach(el => {
          el.classList.remove('border-brand-500', 'opacity-100');
          el.classList.add('border-transparent', 'opacity-60');
        });
        element.classList.remove('border-transparent', 'opacity-60');
        element.classList.add('border-brand-500', 'opacity-100');
      };

      // Select Variant via thumbnail
      window.selectVariantImage = function(element, src, colorText) {
        window.changeMainImage(element, src);
        const vInput = document.getElementById('variantInputVal');
        if (vInput) vInput.value = colorText;
        
        const colorBtns = document.querySelectorAll('.variant-btn');
        colorBtns.forEach(btn => {
           if(btn.innerText.trim() === colorText) {
              btn.classList.add('border-brand-500', 'text-brand-600', 'bg-brand-50');
              btn.classList.remove('border-slate-200');
              btn.classList.add('active'); // Keep standard class for logic
           } else {
              btn.classList.remove('border-brand-500', 'text-brand-600', 'bg-brand-50', 'active');
              btn.classList.add('border-slate-200');
           }
        });
      };

      // Variant selection logic in Modal
      const variantBtns = document.querySelectorAll('.variant-btn');
      variantBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const siblings = this.parentElement.querySelectorAll('.variant-btn');
          siblings.forEach(s => {
            s.classList.remove('border-brand-500', 'text-brand-600', 'bg-brand-50', 'active');
            s.classList.add('border-slate-200');
          });
          this.classList.add('border-brand-500', 'text-brand-600', 'bg-brand-50', 'active');
          this.classList.remove('border-slate-200');
          
          const activeVariants = document.querySelectorAll('.variant-btn.active');
          const variantText = Array.from(activeVariants).map(b => b.innerText.trim()).join(', ');
          
          const vInput = document.getElementById('variantInputVal');
          if (vInput) vInput.value = variantText;
        });
      });

      // Actions
      let currentAction = '';
      const hasVariants = document.querySelectorAll('.variants-section .flex.flex-wrap').length > 0;
      
      const btns = document.querySelectorAll('.btn-action-main');
      btns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          if (!isLogin) {
            e.preventDefault();
            alert('Bạn cần đăng nhập để mua hàng!');
            return;
          }
          currentAction = btn.getAttribute('action-type');
          if (hasVariants) {
            const myModal = new bootstrap.Modal(document.getElementById('variantModal'));
            myModal.show();
          } else {
            executeAction();
          }
        });
      });
      
      const confirmBtn = document.getElementById('confirmVariantBtn');
      if (confirmBtn) {
        confirmBtn.addEventListener('click', () => {
          const variantSections = document.querySelectorAll('.variants-section .flex.flex-wrap');
          const activeVariants = document.querySelectorAll('.variant-btn.active');
          if (variantSections.length > 0 && activeVariants.length < variantSections.length) {
            alert('Vui lòng chọn đầy đủ Phân loại sản phẩm (Màu sắc, Size...)!');
            return;
          }
          executeAction();
        });
      }
      
      function executeAction() {
        if (currentAction === 'cart') {
          document.getElementById('addCartForm').submit();
        } else if (currentAction === 'checkout') {
          const input = document.getElementById('qty-input');
          const quantity = input ? input.value : 1;
          const slug = input ? input.getAttribute('slug') : '';
          const variantText = document.getElementById('variantInputVal') ? document.getElementById('variantInputVal').value : '';
          window.location.href = `/order?product=${slug}&quantity=${quantity}&variant=${encodeURIComponent(variantText)}`;
        }
      }

      // Wishlist toggle
      window.toggleWishlist = function(productId) {
        if (!isLogin) {
          alert('Bạn cần đăng nhập để thêm vào yêu thích!');
          return;
        }
        const btn = document.querySelector('.wishlist-btn-main');
        fetch(`/wishlist/toggle`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId })
        })
        .then(r => r.json())
        .then(data => {
          if (data.code === '00') {
            const isW = btn.classList.toggle('border-rose-200');
            btn.classList.toggle('bg-rose-50');
            btn.classList.toggle('text-rose-600');
            btn.classList.toggle('border-slate-200');
            btn.classList.toggle('bg-white');
            btn.classList.toggle('text-surface-700');
            btn.querySelector('i').className = isW ? 'bi bi-heart-fill text-rose-500' : 'bi bi-heart';
          }
        });
      };

      // Interactive stars logic
      const stars = document.querySelectorAll('.interactive-stars .star-item');
      const ratingInput = document.getElementById('ratingInput');
      
      if (stars.length > 0) {
        stars.forEach(star => {
          star.addEventListener('mouseover', function() {
            const val = parseInt(this.getAttribute('data-val'));
            stars.forEach(s => {
              s.className = parseInt(s.getAttribute('data-val')) <= val ? 'bi bi-star-fill star-item' : 'bi bi-star star-item';
            });
          });
          star.parentElement.addEventListener('mouseleave', function() {
            const currentVal = parseInt(ratingInput.value);
            stars.forEach(s => {
              s.className = parseInt(s.getAttribute('data-val')) <= currentVal ? 'bi bi-star-fill star-item' : 'bi bi-star star-item';
            });
          });
          star.addEventListener('click', function() {
            const val = parseInt(this.getAttribute('data-val'));
            ratingInput.value = val;
            stars.forEach(s => {
              s.className = parseInt(s.getAttribute('data-val')) <= val ? 'bi bi-star-fill star-item' : 'bi bi-star star-item';
            });
          });
        });
      }

      // Review Form Submission
      const reviewForm = document.getElementById('popupReviewForm');
      if (reviewForm) {
        reviewForm.addEventListener('submit', function(e) {
          e.preventDefault();
          const formData = new FormData(reviewForm);
          const productId = formData.get('productId');

          fetch(`/review/add/${productId}`, {
            method: 'POST',
            body: formData
          })
          .then(res => res.json())
          .then(result => {
            if (result.code === '00') {
              alert(result.message || 'Cảm ơn bạn đã đánh giá!');
              window.location.reload();
            } else {
              alert(result.message || 'Có lỗi xảy ra!');
            }
          });
        });
      }

      // Installment
      const instMonths = document.getElementById('instMonths');
      if (instMonths) {
        instMonths.addEventListener('change', () => {
          const months = parseInt(instMonths.value);
          const price = !{product.newPrice};
          const remaining = price * 0.7;
          const monthly = Math.round(remaining / months);
          document.getElementById('instMonthly').textContent = monthly.toLocaleString('vi-VN') + '₫';
        });
      }
    });

    function openProductChat(productTitle) {
      const chatBtn = document.getElementById('chat-toggle-btn');
      if (chatBtn) {
        const chatWindow = document.getElementById('chat-window');
        if (chatWindow && chatWindow.classList.contains('d-none')) {
          chatBtn.click();
        }
        setTimeout(() => {
          const chatInput = document.getElementById('chat-input');
          if (chatInput) {
            chatInput.value = 'Tôi cần tư vấn về sản phẩm: ' + productTitle;
            chatInput.focus();
          }
        }, 100);
      } else {
        alert('Vui lòng đăng nhập để sử dụng tính năng chat!');
      }
    }