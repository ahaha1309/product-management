extends ../../layouts/default.pug
include ../../mixins/alert.pug

block head
  //- JSON-LD injected centrally via seo.service.js

block main
  +alert-success(messages.success)

  div(class="container mx-auto px-4 max-w-7xl py-12 mb-24")

    //- Breadcrumb - Modernized with pill shapes
    nav(class="flex items-center gap-2 text-sm text-surface-500 mb-8 overflow-x-auto hide-scrollbar whitespace-nowrap bg-white/60 backdrop-blur-md px-5 py-3 rounded-full border border-white shadow-sm w-max max-w-full")
      a(href="/" class="hover:text-brand-600 transition-colors font-medium flex items-center gap-1.5") 
        i.bi.bi-house-door
        | Trang chủ
      i(class="bi bi-chevron-right text-[10px] opacity-60")
      a(href="/product" class="hover:text-brand-600 transition-colors font-medium") Sản phẩm
      if product.category
        i(class="bi bi-chevron-right text-[10px] opacity-60")
        a(href=`/product/c/${product.category.slug}` class="hover:text-brand-600 transition-colors font-medium") #{product.category.title}
      i(class="bi bi-chevron-right text-[10px] opacity-60")
      span(class="text-surface-950 font-bold truncate max-w-[200px] md:max-w-xs") #{product.title}

    //- HERO BENTO CONTAINER
    div(class="bg-white rounded-[3rem] p-4 md:p-8 shadow-diffusion border border-slate-100/50 mb-12")
      div(class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16")
        
        //- Left: Product Gallery (Premium Style)
        div(class="lg:col-span-5")
          div(class="sticky top-28")
            //- Main Image Container (Glassmorphism & Perpetual Float)
            div(class="relative aspect-[4/5] rounded-[2.5rem] overflow-hidden bg-gradient-to-br from-surface-50 to-surface-100 border border-white shadow-inner flex items-center justify-center group mb-6")
              //- Floating Image
              img#main-image(src=product.thumbnail alt=product.title class="w-10/12 h-10/12 object-contain drop-shadow-2xl transition-transform duration-700 group-hover:scale-110 perpetual-float")
              
              //- Badges
              div(class="absolute top-6 left-6 flex flex-col gap-2 z-10")
                if product.isFlashSale
                  div(class="bg-gradient-to-r from-rose-500 to-orange-500 text-white px-4 py-2 rounded-2xl font-black text-sm tracking-widest shadow-xl flex items-center gap-1.5")
                    i.bi.bi-lightning-fill
                    | FLASH SALE

                if product.discountPercentage > 0
                  div(class="liquid-glass text-rose-600 px-4 py-2 rounded-2xl font-black text-sm tracking-widest shadow-xl flex items-center gap-1.5")
                    i.bi.bi-lightning-charge-fill
                    | -#{product.discountPercentage}%
                
                if product.stock <= 0
                  div(class="bg-surface-950/80 backdrop-blur text-white px-4 py-2 rounded-2xl font-bold text-sm shadow-xl")
                    | Hết hàng

            //- Thumbnails Gallery (Pill shaped, interactive)
            div(class="flex items-center gap-3 overflow-x-auto pb-4 hide-scrollbar snap-x")
              if variants && variants.length > 0
                div(class=`thumbnail-item relative w-20 h-20 rounded-2xl cursor-pointer overflow-hidden border-2 transition-all shrink-0 snap-start bg-surface-50 hover:shadow-md border-brand-500 shadow-brand-500/20` onclick=`changeMainImage(this, '${product.thumbnail}')`)
                  img(src=product.thumbnail alt=product.title class="w-full h-full object-cover p-2 mix-blend-multiply")
                each v, index in variants
                  - const vImg = (v.images && v.images[0]) ? v.images[0].url : product.thumbnail
                  - const vColor = (v.attributes && v.attributes.color) ? v.attributes.color : ''
                  div(class=`thumbnail-item relative w-20 h-20 rounded-2xl cursor-pointer overflow-hidden border-2 transition-all shrink-0 snap-start bg-surface-50 hover:shadow-md border-transparent opacity-70 hover:opacity-100` onclick=`selectVariantImage(this, '${vImg}', '${vColor}')`)
                    img(src=vImg alt=vColor class="w-full h-full object-cover p-2 mix-blend-multiply")
              else if product.images && product.images.length > 0
                div(class=`thumbnail-item relative w-20 h-20 rounded-2xl cursor-pointer overflow-hidden border-2 transition-all shrink-0 snap-start bg-surface-50 hover:shadow-md border-brand-500 shadow-brand-500/20` onclick=`changeMainImage(this, '${product.thumbnail}')`)
                  img(src=product.thumbnail alt=product.title class="w-full h-full object-cover p-2 mix-blend-multiply")
                each img, index in product.images
                  div(class=`thumbnail-item relative w-20 h-20 rounded-2xl cursor-pointer overflow-hidden border-2 transition-all shrink-0 snap-start bg-surface-50 hover:shadow-md border-transparent opacity-70 hover:opacity-100` onclick=`changeMainImage(this, '${img}')`)
                    img(src=img alt=product.title class="w-full h-full object-cover p-2 mix-blend-multiply")

        //- Right: Product Info & Actions
        div(class="lg:col-span-7 flex flex-col justify-center")
          
          if product.category
            div(class="mb-4")
              a(href=`/product/c/${product.category.slug}` class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-brand-50 text-brand-600 text-xs font-bold tracking-wider uppercase border border-brand-100 hover:bg-brand-100 transition-colors")
                i.bi.bi-hash.text-brand-400
                | #{product.category.title}

          //- Title
          h1(class="text-4xl md:text-5xl font-black text-surface-950 tracking-tighter leading-[1.1] mb-6") #{product.title}

          //- Ratings & Stock
          div(class="flex items-center gap-4 mb-8 flex-wrap")
            div(class="flex items-center gap-1.5 bg-surface-50 px-3 py-1.5 rounded-full border border-slate-100")
              div(class="flex items-center gap-0.5 text-amber-500 text-sm")
                - for(let i=1; i<=5; i++)
                  if i <= Math.round(averageRating || 5)
                    i.bi.bi-star-fill
                  else
                    i.bi.bi-star
              span(class="font-bold text-surface-900 text-sm ml-1") #{averageRating || 5}.0
              span(class="text-surface-400 text-xs font-medium") (#{reviews ? reviews.length : 0} đánh giá)
            
            if product.stock > 0
              div(class="flex items-center gap-2 bg-emerald-50 text-emerald-700 px-3 py-1.5 rounded-full border border-emerald-100 text-sm font-bold")
                div(class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse")
                | Còn #{product.stock} sản phẩm
            else
              div(class="flex items-center gap-2 bg-rose-50 text-rose-700 px-3 py-1.5 rounded-full border border-rose-100 text-sm font-bold")
                i.bi.bi-x-circle-fill
                | Hết hàng

          //- Premium Price Box
          if product.isFlashSale && product.flashSale && product.flashSale.quantityLimit
            - const fsSold = product.flashSale.soldQuantity || 0
            - const fsTotal = product.flashSale.quantityLimit
            - const fsPercent = Math.min(100, Math.floor((fsSold / fsTotal) * 100))
            div(class="bg-rose-50 border border-rose-200 rounded-2xl p-4 mb-4 flex flex-col gap-2")
              div(class="flex justify-between items-center text-sm font-bold text-rose-700")
                span Đã bán #{fsSold} / #{fsTotal}
                if fsPercent >= 100
                  span(class="text-rose-500") Hết suất Flash Sale
              div(class="relative w-full bg-rose-200 rounded-full h-3 overflow-hidden")
                div(class="absolute top-0 left-0 h-full bg-gradient-to-r from-rose-500 to-orange-500 rounded-full transition-all duration-1000" style=`width: ${fsPercent}%`)

          div(class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-brand-950 via-surface-900 to-surface-950 p-8 mb-8 text-white shadow-2xl shadow-brand-900/20")
            //- Decorative background element
            div(class="absolute -top-24 -right-24 w-64 h-64 bg-brand-500/30 blur-[60px] rounded-full")
            
            div(class="relative z-10 flex flex-col md:flex-row md:items-end justify-between gap-6")
              div
                div(class="text-surface-400 text-sm font-medium mb-1 uppercase tracking-widest") Giá bán chính thức
                div(class="flex flex-wrap items-baseline gap-2 md:gap-4")
                  div(class="text-4xl sm:text-5xl md:text-6xl font-black text-transparent bg-clip-text bg-gradient-to-r from-white to-white/70 tracking-tighter")
                    | ₫#{product.newPrice.toLocaleString('vi-VN')}
                  if product.discountPercentage > 0
                    div(class="text-lg sm:text-xl text-surface-500 line-through mb-1 sm:mb-2 font-semibold")
                      | ₫#{product.price.toLocaleString('vi-VN')}
              
              div(class="liquid-glass !bg-white/10 !border-white/10 px-5 py-3 rounded-2xl flex items-center gap-3 backdrop-blur-xl")
                div(class="w-10 h-10 rounded-full bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center shadow-lg shadow-amber-500/30")
                  i.bi.bi-coin.text-white.text-xl
                div
                  div(class="text-xs text-surface-300 font-medium") Hoàn tiền xu
                  div(class="text-sm font-bold text-amber-400") +#{Math.floor(product.newPrice * 0.01).toLocaleString('vi-VN')} Xu

          //- Shop Info (Minimal Bento)
          div(class="flex items-center justify-between p-4 rounded-3xl border border-slate-100 bg-surface-50 mb-8 transition-colors hover:bg-surface-100")
            div(class="flex items-center gap-4")
              div(class="relative")
                img(src="https://ui-avatars.com/api/?name=VanHa+Tech&background=0d9488&color=fff&size=120" alt="Shop Avatar" class="w-14 h-14 rounded-2xl shadow-sm")
                div(class="absolute -bottom-1 -right-1 w-4 h-4 bg-emerald-500 border-2 border-white rounded-full")
              div
                div(class="font-black text-surface-950 flex items-center gap-2 text-lg")
                  | NVH Mall Store
                  i.bi.bi-patch-check-fill.text-brand-500
                div(class="text-xs text-surface-500 font-medium mt-0.5") Cam kết chính hãng 100%
            
            div(class="flex gap-2")
              button(onclick=`openProductChat('${product.title.replace(/'/g, "\\'")}')` class="w-12 h-12 flex items-center justify-center rounded-2xl bg-white border border-slate-200 text-surface-700 hover:border-brand-500 hover:text-brand-600 hover:shadow-md transition-all")
                i.bi.bi-chat-dots.text-xl

          //- Action Area
          if product.stock > 0
            form.form-add-cart(action=`/cart/add/${product._id}` method="POST" formSubmit id="addCartForm" class="mt-auto")
              input(type="hidden" name="variantText" id="variantInputVal" value="")
              
              div(class="flex flex-col sm:flex-row items-center gap-4 mb-8")
                //- Quantity Selector
                div(class="w-full sm:w-auto flex items-center bg-white border-2 border-slate-100 rounded-2xl overflow-hidden shadow-sm h-14")
                  button(type="button" onclick="changeQty(-1)" class="w-14 h-full flex items-center justify-center text-surface-500 hover:bg-surface-100 hover:text-surface-900 transition-colors text-lg")
                    i.bi.bi-dash-lg
                  input(type="number" name="quantity" value="1" min="1" max=product.stock slug=product.slug id="qty-input" class="w-16 h-full text-center bg-transparent border-none focus:outline-none font-black text-surface-900 text-lg appearance-none m-0")
                  button(type="button" onclick="changeQty(1)" class="w-14 h-full flex items-center justify-center text-surface-500 hover:bg-surface-100 hover:text-surface-900 transition-colors text-lg")
                    i.bi.bi-plus-lg
                
                //- Primary Buttons
                div(class="w-full flex gap-3")
                  button.btn-action-main(type="button" action-type="cart" class="flex-1 h-14 rounded-2xl bg-brand-50 text-brand-600 font-bold border-2 border-brand-100 hover:bg-brand-100 hover:border-brand-200 transition-all flex items-center justify-center gap-2")
                    i.bi.bi-cart-plus.text-xl
                    | Thêm Vào Giỏ
                  button.btn-action-main(type="button" action-type="checkout" class="flex-1 h-14 rounded-2xl bg-gradient-to-r from-brand-600 to-brand-500 text-white font-black shadow-xl shadow-brand-500/30 hover:shadow-brand-500/50 transition-all hover:-translate-y-0.5 flex items-center justify-center")
                    | MUA NGAY

              //- Wishlist
              button.wishlist-btn-main(type="button" class=`w-full py-4 rounded-2xl font-bold flex items-center justify-center gap-2 transition-all border-2 ${isWishlisted ? 'border-rose-200 bg-rose-50 text-rose-600' : 'border-slate-100 bg-white text-surface-600 hover:border-slate-200 hover:bg-surface-50'}` onclick=`toggleWishlist('${product._id}')`)
                i.bi(class=(isWishlisted ? "bi-heart-fill text-rose-500 text-lg" : "bi-heart text-lg"))
                | #{isWishlisted ? 'Đã yêu thích sản phẩm' : 'Thêm vào danh sách yêu thích'}

    //- ---------------------------------------------------------------------
    //- BOTTOM SECTIONS (Bento Stack)
    //- ---------------------------------------------------------------------
    div(class="grid grid-cols-1 md:grid-cols-12 gap-8")
      
      //- Left Column: Description (Spans 8)
      div(class="md:col-span-8 space-y-8")
        div(class="bento-card !rounded-[2.5rem]")
          h2(class="text-3xl font-black text-surface-950 tracking-tighter mb-8 flex items-center gap-4")
            div(class="w-12 h-12 rounded-2xl bg-brand-50 text-brand-500 flex items-center justify-center")
              i.bi.bi-stars.text-xl
            | Mô tả chi tiết
          div(class="prose prose-lg prose-slate max-w-none text-surface-600 leading-relaxed marker:text-brand-500 prose-img:rounded-3xl prose-img:shadow-lg prose-headings:font-black prose-headings:tracking-tight")
            | !{product.description}

        if product.techSpecs && product.techSpecs.length > 0
          div(class="bento-card !rounded-[2.5rem]")
            h2(class="text-2xl font-black text-surface-950 tracking-tighter mb-6 flex items-center gap-4")
              div(class="w-12 h-12 rounded-2xl bg-brand-50 text-brand-500 flex items-center justify-center")
                i.bi.bi-cpu.text-xl
              | Thông số kỹ thuật
            
            div(class="bg-surface-50 border border-surface-200 rounded-3xl overflow-hidden")
              table(class="w-full text-left border-collapse text-sm")
                tbody(class="divide-y divide-surface-200")
                  each spec, index in product.techSpecs
                    tr(class=index % 2 === 0 ? "bg-white" : "bg-surface-50/50")
                      td(class="py-3.5 px-5 font-semibold text-surface-600 w-2/5 border-r border-surface-200") #{spec.name}
                      td(class="py-3.5 px-5 text-surface-900 font-medium") #{spec.value}

      //- Right Column: Info & Vouchers (Spans 4)
      div(class="md:col-span-4 space-y-6")
        
        //- Voucher Bento
        div(class="bento-card !rounded-[2.5rem] !p-6 bg-gradient-to-br from-emerald-50 to-teal-50/30 border-emerald-100")
          div(class="flex items-center gap-3 mb-4")
            div(class="w-10 h-10 rounded-xl bg-emerald-500 text-white flex items-center justify-center shadow-md shadow-emerald-500/20")
              i.bi.bi-ticket-perforated-fill
            h3(class="text-lg font-bold text-emerald-950") Ưu đãi dành cho bạn
          div(class="space-y-3")
            div(class="bg-white p-3 rounded-2xl border border-emerald-100 shadow-sm flex items-center justify-between")
              div
                div(class="text-sm font-bold text-emerald-700") GIẢM 10K
                div(class="text-[10px] text-surface-500 font-medium mt-0.5") Đơn tối thiểu 100k
              button(class="text-xs font-bold bg-emerald-50 text-emerald-600 px-3 py-1.5 rounded-lg hover:bg-emerald-100") Lưu
            div(class="bg-white p-3 rounded-2xl border border-emerald-100 shadow-sm flex items-center justify-between")
              div
                div(class="text-sm font-bold text-emerald-700") FREESHIP
                div(class="text-[10px] text-surface-500 font-medium mt-0.5") Giảm 15k phí vận chuyển
              button(class="text-xs font-bold bg-emerald-50 text-emerald-600 px-3 py-1.5 rounded-lg hover:bg-emerald-100") Lưu



    //- Reviews Section
    div(class="bento-card !rounded-[3rem] mt-8")
      div(class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-10")
        h2(class="text-3xl font-black text-surface-950 tracking-tighter flex items-center gap-4")
          div(class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-500 flex items-center justify-center")
            i.bi.bi-chat-heart-fill.text-xl
          | Đánh giá khách hàng
          span(class="text-lg text-surface-400 font-semibold") (#{product.reviewCount || reviews ? reviews.length : 0})
        
        if isLogin
          button(data-bs-toggle="modal" data-bs-target="#reviewModal" class="btn-premium btn-premium-primary")
            i.bi.bi-pencil-square.mr-2
            | Viết đánh giá
        else
          a(href="/auth/login" class="btn-premium bg-surface-100 text-surface-700 hover:bg-surface-200") 
            i.bi.bi-person-circle.mr-2
            | Đăng nhập để đánh giá

      if reviews && reviews.length > 0
        div(class="grid grid-cols-1 md:grid-cols-2 gap-6")
          each review in reviews
            div(class="p-6 rounded-[2rem] border border-slate-100 bg-surface-50/50 hover:bg-white hover:shadow-lg transition-all duration-300 group")
              div(class="flex gap-4")
                img(src="https://ui-avatars.com/api/?name=User&background=random" class="w-12 h-12 rounded-full border-2 border-white shadow-sm")
                div(class="flex-1")
                  div(class="flex items-center justify-between mb-2")
                    div(class="font-black text-surface-900") Người dùng ẩn danh
                    div(class="text-xs text-surface-400 font-medium bg-white px-2 py-1 rounded-lg border border-slate-100") #{new Date(review.createdAt).toLocaleDateString('vi-VN')}
                  
                  div(class="flex items-center gap-1 text-warning text-sm mb-3")
                    - for(let i=1; i<=5; i++)
                      if i <= review.rating
                        i.bi.bi-star-fill
                      else
                        i.bi.bi-star
                        
                  if review.variantText
                    div(class="inline-block px-2.5 py-1 text-xs font-bold text-brand-600 bg-brand-50 rounded-lg mb-3") 
                      i.bi.bi-tags-fill.mr-1
                      | #{review.variantText}
                    
                  p(class="text-surface-600 text-sm leading-relaxed mb-4 font-medium") #{review.content || review.comment}
                  
                  if review.images && review.images.length > 0
                    div(class="flex gap-2 flex-wrap")
                      each img in review.images
                        img(src=img class="w-20 h-20 rounded-2xl object-cover border-2 border-white shadow-sm group-hover:scale-105 transition-transform")
      else
        div(class="text-center py-16 bg-surface-50 rounded-[2rem] border border-slate-100 border-dashed")
          div(class="w-20 h-20 bg-white rounded-full flex items-center justify-center mx-auto mb-6 shadow-sm text-surface-300 text-4xl")
            i.bi.bi-chat-square-heart
          p(class="text-surface-500 font-bold text-lg mb-2") Chưa có đánh giá nào
          p(class="text-surface-400 text-sm") Hãy là người đầu tiên chia sẻ trải nghiệm về sản phẩm này!

    //- Q&A Section đã được ẩn theo yêu cầu

  //- ---------------------------------------------------------------------
  //- MODALS
  //- ---------------------------------------------------------------------
  
  if isLogin
    #reviewModal.modal.fade(tabindex="-1" aria-hidden="true")
      .modal-dialog.modal-dialog-centered
        div(class="modal-content border-0 rounded-[2.5rem] shadow-2xl overflow-hidden")
          .modal-header.border-b.border-slate-100.bg-white.px-8.py-6.flex.justify-between.items-center
            h5.modal-title.font-black.text-2xl.text-surface-950 Viết Đánh Giá
            button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close" class="w-8 h-8 flex items-center justify-center rounded-full bg-surface-100 hover:bg-rose-100 hover:text-rose-600 transition-colors opacity-100")
          .modal-body.p-8.bg-surface-50
            form#popupReviewForm
              input(type="hidden" name="productId" value=product._id)
              input(type="hidden" name="rating" id="ratingInput" value="5")
              
              .mb-8.bg-white.p-6.rounded-3xl.shadow-sm.text-center.border.border-slate-100
                label.block.text-sm.font-bold.text-surface-500.uppercase.tracking-widest.mb-4 Mức độ hài lòng
                .interactive-stars.text-4xl.text-warning.flex.justify-center.gap-3.cursor-pointer
                  i(class="bi bi-star-fill star-item transition-transform hover:scale-110" data-val="1")
                  i(class="bi bi-star-fill star-item transition-transform hover:scale-110" data-val="2")
                  i(class="bi bi-star-fill star-item transition-transform hover:scale-110" data-val="3")
                  i(class="bi bi-star-fill star-item transition-transform hover:scale-110" data-val="4")
                  i(class="bi bi-star-fill star-item transition-transform hover:scale-110" data-val="5")
                  
              .mb-6
                label.block.text-sm.font-bold.text-surface-700.mb-2 Nội dung đánh giá
                textarea.form-control.rounded-2xl.border-slate-200.text-sm.p-4.bg-white(name="comment" rows="4" required placeholder="Chia sẻ trải nghiệm của bạn về sản phẩm..." class="focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20")
              
              .mb-8
                label.block.text-sm.font-bold.text-surface-700.mb-2 Hình ảnh đính kèm
                input.form-control.rounded-2xl.text-sm.bg-white.border-slate-200.p-3(type="file" name="images" multiple accept="image/*")
              
              button.btn-premium.btn-premium-primary.w-full.py-4.text-lg.font-bold.rounded-2xl(type="submit") Gửi Đánh Giá Ngay

  //- Variant Modal (Redesigned)
  if variantAttributes && (variantAttributes.colors.length > 0 || variantAttributes.storages.length > 0 || variantAttributes.sizes.length > 0)
    #variantModal.modal.fade(tabindex="-1" aria-hidden="true")
      .modal-dialog.modal-dialog-centered.modal-dialog-scrollable
        div(class="modal-content border-0 rounded-[2.5rem] shadow-2xl overflow-hidden")
          .modal-header.border-b.border-slate-100.bg-white.px-8.py-6.flex.justify-between.items-center
            h5.modal-title.font-black.text-xl.text-surface-950 Tuỳ Chọn Sản Phẩm
            button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close" class="w-8 h-8 flex items-center justify-center rounded-full bg-surface-100 hover:bg-rose-100 hover:text-rose-600 transition-colors opacity-100")
          
          .modal-body.p-0.bg-surface-50
            .p-8.bg-white.flex.gap-6.border-b.border-slate-100
              div(class="relative aspect-square w-28 h-28 rounded-3xl overflow-hidden bg-surface-50 border border-slate-100")
                img#modal-img(src=product.thumbnail class="w-full h-full object-cover p-2 mix-blend-multiply")
              div.flex.flex-col.justify-center
                .text-3xl.font-black.text-brand-600.tracking-tighter ₫#{product.newPrice.toLocaleString('vi-VN')}
                .text-sm.font-bold.text-surface-500.mt-1 Kho còn: #{product.stock}
            
            .variants-section.p-8.space-y-8
              if variantAttributes.storages.length > 0
                div
                  .text-xs.font-bold.text-surface-500.uppercase.tracking-widest.mb-4 Dung Lượng
                  .flex.flex-wrap.gap-3
                    each storage in variantAttributes.storages
                      button.variant-btn(type="button" class="px-5 py-2.5 rounded-xl border-2 border-slate-200 bg-white text-sm font-bold text-surface-700 hover:border-brand-500 hover:text-brand-600 transition-all focus:outline-none") #{storage}
              
              if variantAttributes.sizes.length > 0
                div
                  .text-xs.font-bold.text-surface-500.uppercase.tracking-widest.mb-4 Kích Thước
                  .flex.flex-wrap.gap-3
                    each size in variantAttributes.sizes
                      button.variant-btn(type="button" class="px-5 py-2.5 rounded-xl border-2 border-slate-200 bg-white text-sm font-bold text-surface-700 hover:border-brand-500 hover:text-brand-600 transition-all focus:outline-none") #{size}
                      
              if variantAttributes.colors.length > 0
                div
                  .text-xs.font-bold.text-surface-500.uppercase.tracking-widest.mb-4 Màu Sắc
                  .flex.flex-wrap.gap-3
                    each color in variantAttributes.colors
                      button.variant-btn(type="button" class="px-5 py-2.5 rounded-xl border-2 border-slate-200 bg-white text-sm font-bold text-surface-700 hover:border-brand-500 hover:text-brand-600 transition-all focus:outline-none") #{color}
                      
          .modal-footer.border-t.border-slate-100.bg-white.p-8
            button#confirmVariantBtn.btn-premium.btn-premium-primary.w-full.py-4.text-lg.font-bold.rounded-2xl.shadow-xl.shadow-brand-500_30(type="button") Xác Nhận Thêm Vào Giỏ

  //- =====================================================================
  //- GỢI Ý SẢN PHẨM (Related & Recently Viewed)
  //- =====================================================================
  if (relatedProducts && relatedProducts.length > 0) || (recentlyViewedProducts && recentlyViewedProducts.length > 0)
    div(class="container mx-auto px-4 max-w-7xl mb-12")
      //- Related Products
      if relatedProducts && relatedProducts.length > 0
        div(class="mb-16")
          h2(class="text-2xl font-black text-surface-900 mb-6 flex items-center gap-3") 
            i.bi.bi-stars.text-brand-500
            | Sản phẩm liên quan
          
          div(class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 md:gap-6")
            each item in relatedProducts
              div(class="bg-white rounded-2xl p-3 border border-surface-100 shadow-sm hover:shadow-xl hover:shadow-brand-500/10 transition-all duration-300 group relative flex flex-col h-full")
                a(href=`/product/detail/${item.slug}` class="block relative aspect-square rounded-xl overflow-hidden mb-3 bg-surface-50")
                  img(src=item.thumbnail alt=item.title class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500")
                  if item.discountPercentage > 0
                    span(class="absolute top-2 left-2 bg-rose-500 text-white text-[10px] font-bold px-2 py-1 rounded-md") -#{item.discountPercentage}%
                
                div(class="flex-1 flex flex-col")
                  a(href=`/product/detail/${item.slug}`)
                    h3(class="text-sm font-bold text-surface-900 line-clamp-2 mb-2 group-hover:text-brand-600 transition-colors") #{item.title}
                  div(class="mt-auto")
                    div(class="flex flex-col")
                      span(class="text-base font-black text-brand-600") #{item.newPrice ? item.newPrice.toLocaleString('vi-VN') : item.price.toLocaleString('vi-VN')}₫
                      if item.discountPercentage > 0
                        span(class="text-xs text-surface-400 line-through") #{item.price.toLocaleString('vi-VN')}₫

      //- Recently Viewed
      if recentlyViewedProducts && recentlyViewedProducts.length > 0
        div(class="mb-12")
          h2(class="text-2xl font-black text-surface-900 mb-6 flex items-center gap-3") 
            i.bi.bi-clock-history.text-blue-500
            | Sản phẩm bạn vừa xem
          
          div(class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 md:gap-6")
            each item in recentlyViewedProducts
              div(class="bg-white rounded-2xl p-3 border border-surface-100 shadow-sm hover:shadow-xl transition-all duration-300 group relative flex flex-col h-full opacity-80 hover:opacity-100")
                a(href=`/product/detail/${item.slug}` class="block relative aspect-square rounded-xl overflow-hidden mb-3 bg-surface-50")
                  img(src=item.thumbnail alt=item.title class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500")
                
                div(class="flex-1 flex flex-col")
                  a(href=`/product/detail/${item.slug}`)
                    h3(class="text-sm font-bold text-surface-900 line-clamp-2 mb-2 group-hover:text-brand-600 transition-colors") #{item.title}
                  div(class="mt-auto")
                    span(class="text-base font-black text-brand-600") #{item.newPrice ? item.newPrice.toLocaleString('vi-VN') : item.price.toLocaleString('vi-VN')}₫

  //- ---------------------------------------------------------------------
  //- JAVASCRIPT (Preserved exactly)
  //- ---------------------------------------------------------------------
  script.
    document.addEventListener('DOMContentLoaded', function () {
      const isLogin = !{JSON.stringify(isLogin)};

      // Quantity buttons
      window.changeQty = function(delta) {
        const inputMain = document.getElementById('qty-input');
        const inputModal = document.getElementById('qty-modal-input');
        
        let max = 99;
        let val = 1;
        
        if (inputMain) {
          max = parseInt(inputMain.getAttribute('max')) || 99;
          val = parseInt(inputMain.value) + delta;
        } else if (inputModal) {
          max = parseInt(inputModal.getAttribute('max')) || 99;
          val = parseInt(inputModal.value) + delta;
        }
        
        if (val < 1) val = 1;
        if (val > max) val = max;
        
        if (inputMain) inputMain.value = val;
        if (inputModal) inputModal.value = val;
      };

      // Change Main Image
      window.changeMainImage = function(element, src) {
        document.getElementById('main-image').src = src;
        const modalImg = document.getElementById('modal-img');
        if (modalImg) modalImg.src = src;
        
        document.querySelectorAll('.thumbnail-item').forEach(el => {
          el.classList.remove('border-brand-500', 'shadow-brand-500/20');
          el.classList.add('border-transparent', 'opacity-70');
        });
        element.classList.remove('border-transparent', 'opacity-70');
        element.classList.add('border-brand-500', 'shadow-brand-500/20');
      };

      // Select Variant via thumbnail
      window.selectVariantImage = function(element, src, colorText) {
        window.changeMainImage(element, src);
        const vInput = document.getElementById('variantInputVal');
        if (vInput) vInput.value = colorText;
        
        const colorBtns = document.querySelectorAll('.variant-btn');
        colorBtns.forEach(btn => {
           if(btn.innerText.trim() === colorText) {
              btn.classList.add('border-brand-500', 'text-brand-600', 'bg-brand-50');
              btn.classList.remove('border-slate-200', 'bg-white');
              btn.classList.add('active'); // Keep standard class for logic
           } else {
              btn.classList.remove('border-brand-500', 'text-brand-600', 'bg-brand-50', 'active');
              btn.classList.add('border-slate-200', 'bg-white');
           }
        });
      };

      // Variant selection logic in Modal
      const variantBtns = document.querySelectorAll('.variant-btn');
      variantBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const siblings = this.parentElement.querySelectorAll('.variant-btn');
          siblings.forEach(s => {
            s.classList.remove('border-brand-500', 'text-brand-600', 'bg-brand-50', 'active');
            s.classList.add('border-slate-200', 'bg-white');
          });
          this.classList.add('border-brand-500', 'text-brand-600', 'bg-brand-50', 'active');
          this.classList.remove('border-slate-200', 'bg-white');
          
          const activeVariants = document.querySelectorAll('.variant-btn.active');
          const variantText = Array.from(activeVariants).map(b => b.innerText.trim()).join(', ');
          
          const vInput = document.getElementById('variantInputVal');
          if (vInput) vInput.value = variantText;
        });
      });

      // Actions
      let currentAction = '';
      const hasVariants = #{product.requireVariants !== false} && document.querySelectorAll('.variants-section .flex.flex-wrap').length > 0;
      
      const btns = document.querySelectorAll('.btn-action-main');
      btns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          if (!isLogin) {
            e.preventDefault();
            alert('Bạn cần đăng nhập để mua hàng!');
            return;
          }
          currentAction = btn.getAttribute('action-type');
          if (hasVariants) {
            const confirmBtnText = document.getElementById('confirmVariantBtn');
            if (confirmBtnText) {
              if (currentAction === 'checkout') {
                confirmBtnText.innerText = 'XÁC NHẬN MUA NGAY';
              } else {
                confirmBtnText.innerText = 'Xác Nhận Thêm Vào Giỏ';
              }
            }
            const myModal = new bootstrap.Modal(document.getElementById('variantModal'));
            myModal.show();
          } else {
            executeAction();
          }
        });
      });
      
      const confirmBtn = document.getElementById('confirmVariantBtn');
      if (confirmBtn) {
        confirmBtn.addEventListener('click', () => {
          const variantSections = document.querySelectorAll('.variants-section .flex.flex-wrap');
          const activeVariants = document.querySelectorAll('.variant-btn.active');
          if (variantSections.length > 0 && activeVariants.length < variantSections.length) {
            alert('Vui lòng chọn đầy đủ Phân loại sản phẩm (Màu sắc, Size...)!');
            return;
          }
          executeAction();
        });
      }
      
      function executeAction() {
        if (currentAction === 'cart') {
          const form = document.getElementById('addCartForm');
          const formData = new FormData(form);
          
          fetch(form.action.replace('/cart/add/', '/api/cart/add/'), {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(Object.fromEntries(formData))
          })
          .then(res => res.json())
          .then(data => {
            if (data.code === '00') {
              window.dispatchEvent(new CustomEvent('nvh:toast', { detail: { type: 'success', message: data.message } }));
              
              const deskBadge = document.getElementById('desktop-cart-badge');
              const mobBadge = document.getElementById('mobile-cart-badge');
              if (deskBadge) {
                deskBadge.textContent = data.data.cartQuantity;
                deskBadge.classList.remove('hidden');
              }
              if (mobBadge) {
                mobBadge.textContent = data.data.cartQuantity;
                mobBadge.classList.remove('hidden');
              }
              
              const myModalEl = document.getElementById('variantModal');
              if (myModalEl) {
                const modal = bootstrap.Modal.getInstance(myModalEl);
                if (modal) modal.hide();
              }
            } else {
              window.dispatchEvent(new CustomEvent('nvh:toast', { detail: { type: 'error', message: data.message } }));
            }
          })
          .catch(err => {
            window.dispatchEvent(new CustomEvent('nvh:toast', { detail: { type: 'error', message: 'Không thể kết nối đến máy chủ' } }));
          });
        } else if (currentAction === 'checkout') {
          const input = document.getElementById('qty-input');
          const quantity = input ? input.value : 1;
          const slug = input ? input.getAttribute('slug') : '';
          const variantText = document.getElementById('variantInputVal') ? document.getElementById('variantInputVal').value : '';
          window.location.href = `/order?product=${slug}&quantity=${quantity}&variant=${encodeURIComponent(variantText)}`;
        }
      }

      // Wishlist toggle
      window.toggleWishlist = function(productId) {
        if (!isLogin) {
          alert('Bạn cần đăng nhập để thêm vào yêu thích!');
          return;
        }
        const btn = document.querySelector('.wishlist-btn-main');
        fetch(`/wishlist/toggle`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId })
        })
        .then(r => r.json())
        .then(data => {
          if (data.code === '00') {
            const isW = btn.classList.toggle('border-rose-200');
            btn.classList.toggle('bg-rose-50');
            btn.classList.toggle('text-rose-600');
            btn.classList.toggle('border-slate-100');
            btn.classList.toggle('bg-white');
            btn.classList.toggle('text-surface-600');
            btn.querySelector('i').className = isW ? 'bi bi-heart-fill text-rose-500 text-lg' : 'bi bi-heart text-lg';
            
            // Cập nhật text bên trong
            if(isW) {
                btn.innerHTML = `<i class="bi bi-heart-fill text-rose-500 text-lg"></i> Đã yêu thích sản phẩm`;
            } else {
                btn.innerHTML = `<i class="bi bi-heart text-lg"></i> Thêm vào danh sách yêu thích`;
            }
          }
        });
      };

      // Interactive stars logic
      const stars = document.querySelectorAll('.interactive-stars .star-item');
      const ratingInput = document.getElementById('ratingInput');
      
      if (stars.length > 0) {
        stars.forEach(star => {
          star.addEventListener('mouseover', function() {
            const val = parseInt(this.getAttribute('data-val'));
            stars.forEach(s => {
              s.className = parseInt(s.getAttribute('data-val')) <= val ? 'bi bi-star-fill star-item transition-transform hover:scale-110' : 'bi bi-star star-item transition-transform hover:scale-110';
            });
          });
          star.parentElement.addEventListener('mouseleave', function() {
            const currentVal = parseInt(ratingInput.value);
            stars.forEach(s => {
              s.className = parseInt(s.getAttribute('data-val')) <= currentVal ? 'bi bi-star-fill star-item transition-transform hover:scale-110' : 'bi bi-star star-item transition-transform hover:scale-110';
            });
          });
          star.addEventListener('click', function() {
            const val = parseInt(this.getAttribute('data-val'));
            ratingInput.value = val;
            stars.forEach(s => {
              s.className = parseInt(s.getAttribute('data-val')) <= val ? 'bi bi-star-fill star-item transition-transform hover:scale-110' : 'bi bi-star star-item transition-transform hover:scale-110';
            });
          });
        });
      }

      // Review Form Submission
      const reviewForm = document.getElementById('popupReviewForm');
      if (reviewForm) {
        reviewForm.addEventListener('submit', function(e) {
          e.preventDefault();
          const formData = new FormData(reviewForm);
          const productId = formData.get('productId');

          fetch(`/review/add/${productId}`, {
            method: 'POST',
            body: formData
          })
          .then(res => res.json())
          .then(result => {
            if (result.code === '00') {
              alert(result.message || 'Cảm ơn bạn đã đánh giá!');
              window.location.reload();
            } else {
              alert(result.message || 'Có lỗi xảy ra!');
            }
          });
        });
      }

      // Installment
      const instMonths = document.getElementById('instMonths');
      if (instMonths) {
        instMonths.addEventListener('change', () => {
          const months = parseInt(instMonths.value);
          const price = !{product.newPrice};
          const remaining = price * 0.7;
          const monthly = Math.round(remaining / months);
          document.getElementById('instMonthly').textContent = monthly.toLocaleString('vi-VN') + '₫';
        });
      }

      // Question Form Submission
      const questionForm = document.getElementById('popupQuestionForm');
      if (questionForm) {
        questionForm.addEventListener('submit', function(e) {
          e.preventDefault();
          const productId = questionForm.querySelector('input[name="productId"]').value;
          const content = questionForm.querySelector('textarea[name="content"]').value;

          fetch('/questions/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productId, content })
          })
          .then(res => res.json())
          .then(result => {
            if (result.code === 200) {
              alert('Cảm ơn bạn đã đặt câu hỏi. Chúng tôi sẽ trả lời sớm nhất!');
              window.location.reload();
            } else {
              alert(result.message || 'Có lỗi xảy ra!');
            }
          });
        });
      }

      // Toggle Reply Forms
      const replyBtns = document.querySelectorAll('.btn-reply-question');
      replyBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const qid = btn.getAttribute('data-qid');
          const formContainer = document.getElementById(`reply-form-${qid}`);
          if (formContainer) {
            formContainer.classList.toggle('hidden');
          }
        });
      });

      // Submit Answer
      window.submitAnswer = function(e, questionId) {
        e.preventDefault();
        const form = e.target;
        const input = form.querySelector('input');
        const content = input.value.trim();

        if (!content) return;

        fetch(`/questions/answer/${questionId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content })
        })
        .then(res => res.json())
        .then(result => {
          if (result.code === 200) {
            window.location.reload();
          } else {
            alert(result.message || 'Có lỗi xảy ra!');
          }
        });
      };
    });

    function openProductChat(productTitle) {
      const chatBtn = document.getElementById('chat-toggle-btn');
      if (chatBtn) {
        const chatWindow = document.getElementById('chat-window');
        if (chatWindow && chatWindow.classList.contains('d-none')) {
          chatBtn.click();
        }
        setTimeout(() => {
          const chatInput = document.getElementById('chat-input');
          if (chatInput) {
            chatInput.value = 'Tôi cần tư vấn về sản phẩm: ' + productTitle;
            chatInput.focus();
          }
        }, 100);
      } else {
        alert('Vui lòng đăng nhập để sử dụng tính năng chat!');
      }
    }