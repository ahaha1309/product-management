extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-error(5000)
  +alert-success(5000)

  .container.my-5
    .row.justify-content-center
      .col-md-6.col-lg-5
        .card.shadow-sm.border-0.rounded-4
          .card-body.p-4.p-sm-5
            .text-center.mb-4
              h2.fw-bold QUÊN MẬT KHẨU
              p.text-muted Nhập phương thức liên lạc để khôi phục mật khẩu
            
            //- Form Email (Mặc định)
            form#form-email(action="/auth/forgot-password" method="POST")
              input(type="hidden" name="method" value="email")
              .form-group.mb-4
                label(for="email" class="form-label") Email đăng ký
                input#email.form-control.form-control-lg(
                  type="email"
                  name="email"
                  required
                  placeholder="Ví dụ: vanha@gmail.com"
                )
              .d-grid
                button.btn.btn-primary.btn-lg.rounded-3(type="submit") NHẬN MÃ QUA EMAIL
              
              .text-center.mt-3
                a(href="javascript:void(0)" onclick="toggleMethod('phone')" class="text-decoration-none") Gửi qua tin nhắn SMS (Số điện thoại)

            //- Form Phone (Ẩn mặc định)
            form#form-phone(action="/auth/forgot-password" method="POST" style="display: none;")
              input(type="hidden" name="method" value="phone")
              .form-group.mb-4
                label(for="phone" class="form-label") Số điện thoại đăng ký
                input#phone.form-control.form-control-lg(
                  type="text"
                  name="phone"
                  required
                  placeholder="Ví dụ: 0123456789"
                )
              .d-grid
                button.btn.btn-primary.btn-lg.rounded-3(type="submit") NHẬN MÃ QUA SMS
              
              .text-center.mt-3
                a(href="javascript:void(0)" onclick="toggleMethod('email')" class="text-decoration-none") Gửi qua Email

            .text-center.mt-4
              a(href="/auth/login" class="text-decoration-none text-muted")
                i.bi.bi-arrow-left.me-2
                | Quay lại Đăng nhập
  
  script.
    function toggleMethod(method) {
      if (method === 'phone') {
        document.getElementById('form-email').style.display = 'none';
        document.getElementById('email').removeAttribute('required');
        
        document.getElementById('form-phone').style.display = 'block';
        document.getElementById('phone').setAttribute('required', 'required');
      } else {
        document.getElementById('form-phone').style.display = 'none';
        document.getElementById('phone').removeAttribute('required');
        
        document.getElementById('form-email').style.display = 'block';
        document.getElementById('email').setAttribute('required', 'required');
      }
    }
