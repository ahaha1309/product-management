extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-error(5000)
  +alert-success(5000)

  div(class="container mx-auto px-4 py-16 min-h-[60vh] flex items-center justify-center")
    div(class="w-full max-w-md")
      div(class="bento-card border border-slate-100 !p-8")
        div(class="text-center mb-8")
          div(class="w-16 h-16 rounded-full bg-brand-50 text-brand-600 flex items-center justify-center mx-auto mb-4 text-2xl")
            i(class="bi bi-key")
          h2(class="text-2xl font-black text-surface-950 tracking-tight mb-2") Quên mật khẩu
          p(class="text-surface-500 text-sm") Chọn phương thức liên lạc để khôi phục mật khẩu của bạn.

        //- Form Email (Mặc định)
        form#form-email(action="/auth/forgot-password" method="POST" class="space-y-5")
          input(type="hidden" name="method" value="email")
          div
            label(for="email" class="block text-sm font-bold text-surface-700 mb-1.5") Email đăng ký
            div(class="relative")
              i(class="bi bi-envelope absolute left-4 top-1/2 -translate-y-1/2 text-surface-400")
              input#email(type="email" name="email" required placeholder="Ví dụ: vanha@gmail.com" class="w-full bg-surface-50 border border-slate-200 rounded-xl py-3 pl-11 pr-4 text-sm font-medium focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all")
          
          button(type="submit" class="btn-premium btn-premium-primary w-full py-3") Nhận mã qua Email
          
          div(class="text-center mt-4")
            a(href="javascript:void(0)" onclick="toggleMethod('phone')" class="text-sm font-semibold text-brand-600 hover:text-brand-700 transition-colors") Gửi qua tin nhắn SMS (SĐT)

        //- Form Phone (Ẩn mặc định)
        form#form-phone(action="/auth/forgot-password" method="POST" class="space-y-5 hidden")
          input(type="hidden" name="method" value="phone")
          div
            label(for="phone" class="block text-sm font-bold text-surface-700 mb-1.5") Số điện thoại đăng ký
            div(class="relative")
              i(class="bi bi-telephone absolute left-4 top-1/2 -translate-y-1/2 text-surface-400")
              input#phone(type="text" name="phone" placeholder="Ví dụ: 0123456789" class="w-full bg-surface-50 border border-slate-200 rounded-xl py-3 pl-11 pr-4 text-sm font-medium focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all")
          
          button(type="submit" class="btn-premium btn-premium-primary w-full py-3") Nhận mã qua SMS
          
          div(class="text-center mt-4")
            a(href="javascript:void(0)" onclick="toggleMethod('email')" class="text-sm font-semibold text-brand-600 hover:text-brand-700 transition-colors") Gửi qua Email

      div(class="text-center mt-6")
        a(href="/auth/login" class="text-sm font-semibold text-surface-500 hover:text-surface-900 transition-colors flex items-center justify-center gap-2")
          i(class="bi bi-arrow-left")
          | Quay lại đăng nhập

  script.
    function toggleMethod(method) {
      if (method === 'phone') {
        document.getElementById('form-email').classList.add('hidden');
        document.getElementById('email').removeAttribute('required');
        
        document.getElementById('form-phone').classList.remove('hidden');
        document.getElementById('phone').setAttribute('required', 'required');
      } else {
        document.getElementById('form-phone').classList.add('hidden');
        document.getElementById('phone').removeAttribute('required');
        
        document.getElementById('form-email').classList.remove('hidden');
        document.getElementById('email').setAttribute('required', 'required');
      }
    }
