include ../../mixins/alert.pug
doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Đăng ký | VanHa Tech
    link(rel="icon" href="/image/logo.png" type="image/x-icon")
    link(rel="stylesheet", href="/css/tailwind.css")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/geist@1.0.3/dist/fonts/geist-sans/style.css")
    link(href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet")
    style.
      body { font-family: 'Geist Sans', sans-serif; }

  body(class="bg-surface-50 min-h-screen grid grid-cols-1 md:grid-cols-2")
    
    //- Left Panel: Hero Graphic
    div(class="hidden md:flex flex-col items-center justify-center relative overflow-hidden bg-gradient-to-br from-emerald-900 via-emerald-800 to-teal-900 p-12")
      div(class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10")
      div(class="absolute w-96 h-96 bg-emerald-500/30 blur-[100px] rounded-full top-[-10%] left-[-10%]")
      div(class="absolute w-96 h-96 bg-teal-500/30 blur-[100px] rounded-full bottom-[-10%] right-[-10%]")
      
      div(class="relative z-10 w-full max-w-md text-center")
        div(class="mb-8 inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-white/10 backdrop-blur-md border border-white/20 shadow-diffusion")
          i(class="bi bi-person-plus text-4xl text-white")
        h1(class="text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight mb-4") Bắt đầu hành trình mới.
        p(class="text-emerald-100 text-lg mb-12") Đăng ký ngay để nhận voucher 100K cho đơn hàng đầu tiên và nhiều ưu đãi bất ngờ khác.
        
        div(class="space-y-4 text-left bg-white/5 backdrop-blur-md border border-white/10 p-6 rounded-3xl shadow-xl")
          div(class="flex items-center gap-4 text-white")
            div(class="w-8 h-8 rounded-full bg-emerald-500/20 flex items-center justify-center border border-emerald-400/30 text-emerald-300 font-bold") 1
            span(class="font-medium") Điền thông tin cá nhân
          div(class="flex items-center gap-4 text-white")
            div(class="w-8 h-8 rounded-full bg-emerald-500/20 flex items-center justify-center border border-emerald-400/30 text-emerald-300 font-bold") 2
            span(class="font-medium") Xác thực tài khoản
          div(class="flex items-center gap-4 text-white")
            div(class="w-8 h-8 rounded-full bg-emerald-500/20 flex items-center justify-center border border-emerald-400/30 text-emerald-300 font-bold") 3
            span(class="font-medium") Mua sắm thả ga

    //- Right Panel: Form
    div(class="flex items-center justify-center p-6 md:p-12 bg-white relative h-screen overflow-y-auto hide-scrollbar")
      a(href="/" class="absolute top-6 right-6 w-10 h-10 rounded-full bg-surface-50 flex items-center justify-center text-surface-500 hover:bg-surface-100 hover:text-brand-500 transition-colors z-20")
        i(class="bi bi-x-lg")
        
      div(class="w-full max-w-md py-12")
        div(class="text-center mb-8")
          h2(class="text-3xl font-black text-surface-950 tracking-tight mb-2") Tạo tài khoản
          p(class="text-surface-500 font-medium") Đã có tài khoản? <a href="/auth/login" class="text-brand-600 hover:text-brand-700 hover:underline">Đăng nhập</a>
        
        - if(messages && messages.error)
          div(class="mb-6 p-4 rounded-xl bg-rose-50 border border-rose-200 flex items-center gap-3 text-rose-600 font-medium text-sm animate-fade-in")
            i(class="bi bi-exclamation-circle-fill text-lg")
            span= messages.error

        form#registerForm(action="/auth/register" method="POST" novalidate class="space-y-5")
          div
            label(class="block text-sm font-bold text-surface-700 mb-1.5") Họ và tên
            div(class="relative")
              i(class="bi bi-person absolute left-4 top-1/2 -translate-y-1/2 text-surface-400")
              input#fullName(type="text" name="fullName" placeholder="VD: Nguyễn Văn A" required autocomplete="name" class="w-full bg-surface-50 border border-slate-200 rounded-xl py-3 pl-11 pr-4 text-sm font-medium focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all")

          div
            label(class="block text-sm font-bold text-surface-700 mb-1.5") Email
            div(class="relative")
              i(class="bi bi-envelope absolute left-4 top-1/2 -translate-y-1/2 text-surface-400")
              input#email(type="email" name="email" placeholder="Nhập địa chỉ email" required autocomplete="email" class="w-full bg-surface-50 border border-slate-200 rounded-xl py-3 pl-11 pr-4 text-sm font-medium focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all")

          div
            label(class="block text-sm font-bold text-surface-700 mb-1.5") Mật khẩu
            div(class="relative")
              i(class="bi bi-lock absolute left-4 top-1/2 -translate-y-1/2 text-surface-400")
              input#password(type="password" name="password" placeholder="Tối thiểu 6 ký tự" minlength="6" required class="w-full bg-surface-50 border border-slate-200 rounded-xl py-3 pl-11 pr-11 text-sm font-medium focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all")
              button#togglePw1(type="button" class="absolute right-4 top-1/2 -translate-y-1/2 text-surface-400 hover:text-brand-500 transition-colors")
                i#eye1(class="bi bi-eye")
            
            div(class="flex items-center gap-1.5 mt-2")
              div#bar1(class="h-1 flex-1 rounded-full bg-slate-200 transition-colors")
              div#bar2(class="h-1 flex-1 rounded-full bg-slate-200 transition-colors")
              div#bar3(class="h-1 flex-1 rounded-full bg-slate-200 transition-colors")
              span#strengthText(class="text-[10px] font-bold uppercase tracking-wider text-surface-400 w-16 text-right") Mức độ

          div
            label(class="block text-sm font-bold text-surface-700 mb-1.5") Xác nhận mật khẩu
            div(class="relative")
              i(class="bi bi-shield-check absolute left-4 top-1/2 -translate-y-1/2 text-surface-400")
              input#confirmPassword(type="password" name="confirmPassword" placeholder="Nhập lại mật khẩu" minlength="6" required class="w-full bg-surface-50 border border-slate-200 rounded-xl py-3 pl-11 pr-11 text-sm font-medium focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all")
              button#togglePw2(type="button" class="absolute right-4 top-1/2 -translate-y-1/2 text-surface-400 hover:text-brand-500 transition-colors")
                i#eye2(class="bi bi-eye")
            p#confirmErr(class="hidden mt-1.5 text-xs font-semibold text-rose-500 flex items-center gap-1")
              i(class="bi bi-x-circle-fill")
              | Mật khẩu không khớp

          div(class="flex items-start gap-2 pt-2")
            input#terms(type="checkbox" required class="mt-0.5 w-4 h-4 rounded border-slate-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0")
            label(for="terms" class="text-xs text-surface-600 font-medium cursor-pointer leading-relaxed") Tôi đồng ý với <a href="#" class="text-brand-600 hover:underline">Điều khoản dịch vụ</a> và <a href="#" class="text-brand-600 hover:underline">Chính sách bảo mật</a> của VanHa Tech.

          button#submitBtn(type="submit" class="btn-premium btn-premium-primary w-full py-3.5 text-base shadow-brand-500/30 group relative overflow-hidden mt-4")
            span.btn-label(class="flex items-center justify-center gap-2 relative z-10")
              | Tạo tài khoản ngay
              i(class="bi bi-arrow-right group-hover:translate-x-1 transition-transform")
            div.spinner-sm(class="hidden absolute inset-0 m-auto w-6 h-6 border-2 border-white/40 border-t-white rounded-full animate-spin z-10")

    script.
      // Toggle password 1
      document.getElementById('togglePw1').addEventListener('click', function() {
        const pw = document.getElementById('password');
        const isHidden = pw.type === 'password';
        pw.type = isHidden ? 'text' : 'password';
        document.getElementById('eye1').className = isHidden ? 'bi bi-eye-slash' : 'bi bi-eye';
      });

      // Toggle password 2
      document.getElementById('togglePw2').addEventListener('click', function() {
        const pw = document.getElementById('confirmPassword');
        const isHidden = pw.type === 'password';
        pw.type = isHidden ? 'text' : 'password';
        document.getElementById('eye2').className = isHidden ? 'bi bi-eye-slash' : 'bi bi-eye';
      });

      // Password strength
      const pwInput = document.getElementById('password');
      const bars = [document.getElementById('bar1'), document.getElementById('bar2'), document.getElementById('bar3')];
      const strengthText = document.getElementById('strengthText');

      function getStrength(pw) {
        let score = 0;
        if (pw.length >= 6) score++;
        if (pw.length >= 10) score++;
        if (/[0-9]/.test(pw) && /[a-zA-Z]/.test(pw)) score++;
        return score;
      }

      pwInput.addEventListener('input', function() {
        const score = getStrength(this.value);
        const colors = ['#e2e8f0', '#f43f5e', '#f59e0b', '#10b981'];
        const texts = ['Mức độ', 'Yếu', 'Trung bình', 'Mạnh'];
        
        bars.forEach((bar, i) => {
          bar.className = `h-1 flex-1 rounded-full transition-colors ${i < score ? '' : 'bg-slate-200'}`;
          if (i < score) {
            if(score===1) bar.style.backgroundColor = '#f43f5e';
            if(score===2) bar.style.backgroundColor = '#f59e0b';
            if(score===3) bar.style.backgroundColor = '#10b981';
          } else {
             bar.style.backgroundColor = '';
          }
        });
        
        strengthText.textContent = this.value.length > 0 ? texts[score] : 'Mức độ';
        if(score===1) strengthText.style.color = '#f43f5e';
        else if(score===2) strengthText.style.color = '#f59e0b';
        else if(score===3) strengthText.style.color = '#10b981';
        else strengthText.style.color = '#94a3b8';
      });

      // Confirm password validation
      const confirmInput = document.getElementById('confirmPassword');
      const confirmErr = document.getElementById('confirmErr');

      confirmInput.addEventListener('input', function() {
        if (this.value && this.value !== pwInput.value) {
          confirmErr.classList.remove('hidden');
          this.classList.add('border-rose-500', 'bg-rose-50');
        } else {
          confirmErr.classList.add('hidden');
          this.classList.remove('border-rose-500', 'bg-rose-50');
        }
      });

      // Form submission
      const form = document.getElementById('registerForm');
      const btn = document.getElementById('submitBtn');
      const btnLabel = btn.querySelector('.btn-label');
      const spinner = btn.querySelector('.spinner-sm');

      form.addEventListener('submit', function(e) {
        if (confirmInput.value !== pwInput.value) {
          e.preventDefault();
          confirmErr.classList.remove('hidden');
          confirmInput.classList.add('border-rose-500', 'bg-rose-50');
          return;
        }
        if (!document.getElementById('terms').checked) {
          e.preventDefault();
          alert('Vui lòng đồng ý với điều khoản dịch vụ!');
          return;
        }
        btnLabel.style.display = 'none';
        spinner.style.display = 'block';
        btn.classList.add('opacity-80', 'cursor-not-allowed');
        btn.disabled = true;
      });