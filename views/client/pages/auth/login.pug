include ../../mixins/alert.pug
doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Đăng nhập | NVH Mall
    link(rel="icon" href="/image/logo.png" type="image/x-icon")
    link(rel="stylesheet", href="/css/tailwind.css")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/geist@1.0.3/dist/fonts/geist-sans/style.css")
    link(href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet")
    style.
      body { font-family: 'Geist Sans', sans-serif; }

  body(class="bg-surface-50 min-h-screen grid grid-cols-1 md:grid-cols-2")
    
    //- Left Panel: Hero Graphic
    div(class="hidden md:flex flex-col items-center justify-center relative overflow-hidden bg-gradient-to-br from-brand-900 via-brand-800 to-blue-900 p-12")
      div(class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10")
      div(class="absolute w-96 h-96 bg-brand-500/30 blur-[100px] rounded-full top-[-10%] left-[-10%]")
      div(class="absolute w-96 h-96 bg-blue-500/30 blur-[100px] rounded-full bottom-[-10%] right-[-10%]")
      
      div(class="relative z-10 w-full max-w-md text-center")
        div(class="mb-8 inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-white/10 backdrop-blur-md border border-white/20 shadow-diffusion")
          i(class="bi bi-box-seam text-4xl text-white")
        h1(class="text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight mb-4") Chào mừng trở lại.
        p(class="text-brand-100 text-lg mb-12") Đăng nhập để truy cập ưu đãi độc quyền, theo dõi đơn hàng và tận hưởng trải nghiệm mua sắm đẳng cấp.
        
        div(class="space-y-4 text-left bg-white/5 backdrop-blur-md border border-white/10 p-6 rounded-3xl shadow-xl")
          div(class="flex items-center gap-4 text-white")
            i(class="bi bi-check-circle-fill text-brand-400 text-xl")
            span(class="font-medium") Tích điểm mọi đơn hàng
          div(class="flex items-center gap-4 text-white")
            i(class="bi bi-check-circle-fill text-brand-400 text-xl")
            span(class="font-medium") Miễn phí vận chuyển toàn quốc
          div(class="flex items-center gap-4 text-white")
            i(class="bi bi-check-circle-fill text-brand-400 text-xl")
            span(class="font-medium") Ưu tiên hỗ trợ 24/7

    //- Right Panel: Form
    div(class="flex items-center justify-center p-6 md:p-12 bg-white relative")
      a(href="/" aria-label="Quay lại trang chủ" class="absolute top-6 right-6 w-10 h-10 rounded-full bg-surface-50 flex items-center justify-center text-surface-500 hover:bg-surface-100 hover:text-brand-500 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500")
        i(class="bi bi-x-lg")
        
      div(class="w-full max-w-md")
        div(class="text-center mb-8")
          h2(class="text-3xl font-black text-surface-950 tracking-tight mb-2") Đăng nhập
          p(class="text-surface-500 font-medium") Chưa có tài khoản? <a href="/auth/register" class="text-brand-600 hover:text-brand-700 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-sm">Đăng ký ngay</a>
        
        - if(messages && messages.error)
          div(class="mb-6 p-4 rounded-xl bg-rose-50 border border-rose-200 flex items-center gap-3 text-rose-600 font-medium text-sm animate-fade-in")
            i(class="bi bi-exclamation-circle-fill text-lg")
            span= messages.error

        - if(messages && messages.success)
          div(class="mb-6 p-4 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center gap-3 text-emerald-600 font-medium text-sm animate-fade-in")
            i(class="bi bi-check-circle-fill text-lg")
            span= messages.success

        form#loginForm(action="/auth/login" method="POST" class="space-y-5")
          div
            label(class="block text-sm font-bold text-surface-700 mb-1.5") Email
            div(class="relative")
              i(class="bi bi-envelope absolute left-4 top-1/2 -translate-y-1/2 text-surface-400")
              input#email(type="email" name="email" placeholder="Nhập địa chỉ email" required class="w-full bg-surface-50 border border-slate-200 rounded-xl py-3 pl-11 pr-4 text-sm font-medium focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all")

          div
            div(class="flex items-center justify-between mb-1.5")
              label(class="block text-sm font-bold text-surface-700") Mật khẩu
              a(href="/auth/forgot-password" class="text-xs font-bold text-brand-600 hover:text-brand-700 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-sm") Quên mật khẩu?
            div(class="relative")
              i(class="bi bi-lock absolute left-4 top-1/2 -translate-y-1/2 text-surface-400")
              input#password(type="password" name="password" placeholder="Nhập mật khẩu" required class="w-full bg-surface-50 border border-slate-200 rounded-xl py-3 pl-11 pr-11 text-sm font-medium focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all")
              button#togglePw(type="button" aria-label="Hiện mật khẩu" class="absolute right-4 top-1/2 -translate-y-1/2 text-surface-400 hover:text-brand-500 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-sm")
                i#eyeIcon(class="bi bi-eye")

          div(class="flex items-center gap-2")
            input#remember(type="checkbox" name="remember" class="w-4 h-4 rounded border-slate-300 text-brand-500 focus:ring-brand-500 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500")
            label(for="remember" class="text-sm text-surface-600 font-medium cursor-pointer select-none") Ghi nhớ đăng nhập

          button#submitBtn(type="submit" class="btn-premium btn-primary w-full py-3.5 text-base shadow-brand-500/30 group relative overflow-hidden focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-brand-500 focus-visible:ring-offset-2")
            span.btn-label(class="flex items-center justify-center gap-2 relative z-10")
              | Đăng nhập
              i(class="bi bi-arrow-right group-hover:translate-x-1 transition-transform")
            div.spinner-sm(class="hidden absolute inset-0 m-auto w-6 h-6 border-2 border-white/40 border-t-white rounded-full animate-spin z-10")

        div(class="mt-8 relative")
          div(class="absolute inset-0 flex items-center")
            div(class="w-full border-t border-slate-200")
          div(class="relative flex justify-center text-sm")
            span(class="px-4 bg-white text-surface-400 font-semibold") Hoặc đăng nhập bằng

        div(class="grid grid-cols-2 gap-4 mt-6")
          a(href="/auth/google" class="flex items-center justify-center gap-3 px-4 py-3 border border-slate-200 rounded-xl hover:bg-surface-50 hover:border-slate-300 transition-all font-semibold text-surface-700 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400")
            svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18")
              path(d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4")
              path(d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853")
              path(d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05")
              path(d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335")
            | Google
          
          a(href="/auth/facebook" class="flex items-center justify-center gap-3 px-4 py-3 bg-[#1877F2] hover:bg-[#166FE5] text-white rounded-xl transition-all font-semibold text-sm shadow-sm shadow-[#1877F2]/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#1877F2] focus-visible:ring-offset-2")
            svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18")
              path(d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" fill="#ffffff")
            | Facebook

    script.
      const togglePw = document.getElementById('togglePw');
      const pwInput = document.getElementById('password');
      const eyeIcon = document.getElementById('eyeIcon');

      togglePw.addEventListener('click', () => {
        const isHidden = pwInput.type === 'password';
        pwInput.type = isHidden ? 'text' : 'password';
        eyeIcon.className = isHidden ? 'bi bi-eye-slash' : 'bi bi-eye';
      });

      const form = document.getElementById('loginForm');
      const btn = document.getElementById('submitBtn');
      const btnLabel = btn.querySelector('.btn-label');
      const spinner = btn.querySelector('.spinner-sm');

      form.addEventListener('submit', () => {
        btnLabel.style.display = 'none';
        spinner.style.display = 'block';
        btn.classList.add('opacity-80', 'cursor-not-allowed');
        btn.disabled = true;
      });