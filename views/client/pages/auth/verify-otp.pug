extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-error(5000)
  +alert-success(5000)

  div(class="container mx-auto px-4 py-16 min-h-[60vh] flex items-center justify-center")
    div(class="w-full max-w-md")
      div(class="bento-card border border-slate-100 !p-8")
        div(class="text-center mb-8")
          div(class="w-16 h-16 rounded-full bg-brand-50 text-brand-600 flex items-center justify-center mx-auto mb-4 text-2xl")
            i(class="bi bi-shield-check")
          h2(class="text-2xl font-black text-surface-950 tracking-tight mb-2") Mã xác thực OTP
          p(class="text-surface-500 text-sm leading-relaxed") Vui lòng nhập mã gồm 6 chữ số đã được gửi đến <br> <span class="font-bold text-surface-900">#{email || phone}</span>
        
        form(action="/auth/verify-otp" method="POST" class="space-y-6")
          if email
            input(type="hidden" name="email" value=email)
          if phone
            input(type="hidden" name="phone" value=phone)
          input(type="hidden" name="action" value=action)

          div
            label(for="otp" class="block text-sm font-bold text-surface-700 mb-1.5 text-center") Nhập mã OTP
            input#otp(type="text" name="otp" required placeholder="000000" maxlength="6" pattern="[0-9]{6}" class="w-full bg-surface-50 border border-slate-200 rounded-xl py-4 text-center text-3xl font-mono tracking-[0.5em] focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all")
            
          button(type="submit" class="btn-premium btn-primary w-full py-3.5 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-brand-500 focus-visible:ring-offset-2") Xác nhận mã

        div(class="text-center mt-6")
          p(class="text-sm font-medium text-surface-500 mb-3") Mã OTP có hiệu lực trong <span id="countdown" class="font-bold text-rose-500">05:00</span>
          
          form#resendForm(action="/auth/resend-otp" method="POST" class="hidden")
            if email
              input(type="hidden" name="email" value=email)
            if phone
              input(type="hidden" name="phone" value=phone)
            input(type="hidden" name="action" value=action)
            button(type="submit" class="text-sm font-bold text-brand-600 hover:text-brand-700 underline transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-sm") Gửi lại mã
          
          p#resendText(class="text-sm font-medium text-surface-400 mt-2") Bạn chưa nhận được mã? Gửi lại sau <span id="resendCountdown" class="font-bold">60</span>s
        
        div(class="text-center mt-6 pt-6 border-t border-slate-100")
          if action === 'register'
            p(class="text-sm font-medium text-surface-500") Sai thông tin? <a href="/auth/register" class="text-brand-600 hover:underline font-bold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-sm">Đăng ký lại</a>
          else if action === 'forgotPassword'
            p(class="text-sm font-medium text-surface-500") Quên thông tin? <a href="/auth/forgot-password" class="text-brand-600 hover:underline font-bold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-sm">Quay lại</a>

  script.
    // OTP Expiry Countdown (5 minutes)
    let expiryTime = 5 * 60;
    const countdownEl = document.getElementById('countdown');
    
    const expiryInterval = setInterval(() => {
      expiryTime--;
      if(expiryTime <= 0) {
        clearInterval(expiryInterval);
        countdownEl.innerText = "00:00";
        countdownEl.innerHTML += " <span class='text-xs ml-1'>(Đã hết hạn)</span>";
      } else {
        const m = Math.floor(expiryTime / 60).toString().padStart(2, '0');
        const s = (expiryTime % 60).toString().padStart(2, '0');
        countdownEl.innerText = `${m}:${s}`;
      }
    }, 1000);

    // Resend Countdown (60 seconds)
    let resendTime = 60;
    const resendCountdownEl = document.getElementById('resendCountdown');
    const resendTextEl = document.getElementById('resendText');
    const resendFormEl = document.getElementById('resendForm');
    
    const resendInterval = setInterval(() => {
      resendTime--;
      if(resendTime <= 0) {
        clearInterval(resendInterval);
        resendTextEl.classList.add('hidden');
        resendFormEl.classList.remove('hidden');
      } else {
        resendCountdownEl.innerText = resendTime;
      }
    }, 1000);
