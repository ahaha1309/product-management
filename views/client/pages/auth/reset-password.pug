extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-error(5000)
  +alert-success(5000)

  div(class="container mx-auto px-4 py-16 min-h-[60vh] flex items-center justify-center")
    div(class="w-full max-w-md")
      div(class="bento-card border border-slate-100 !p-8")
        div(class="text-center mb-8")
          div(class="w-16 h-16 rounded-full bg-brand-50 text-brand-600 flex items-center justify-center mx-auto mb-4 text-2xl")
            i(class="bi bi-shield-lock")
          h2(class="text-2xl font-black text-surface-950 tracking-tight mb-2") Đặt lại mật khẩu
          p(class="text-surface-500 text-sm") Vui lòng nhập mật khẩu mới của bạn.

        form#resetForm(action="/auth/reset-password" method="POST" class="space-y-5")
          div
            label(for="password" class="block text-sm font-bold text-surface-700 mb-1.5") Mật khẩu mới
            div(class="relative")
              i(class="bi bi-lock absolute left-4 top-1/2 -translate-y-1/2 text-surface-400")
              input#password(type="password" name="password" required minlength="8" placeholder="Nhập ít nhất 8 ký tự" class="w-full bg-surface-50 border border-slate-200 rounded-xl py-3 pl-11 pr-11 text-sm font-medium focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all")
              button#togglePw1(type="button" aria-label="Hiện mật khẩu" class="absolute right-4 top-1/2 -translate-y-1/2 text-surface-400 hover:text-brand-500 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-sm")
                i#eye1(class="bi bi-eye")
          
          div
            label(for="confirmPassword" class="block text-sm font-bold text-surface-700 mb-1.5") Xác nhận mật khẩu mới
            div(class="relative")
              i(class="bi bi-shield-check absolute left-4 top-1/2 -translate-y-1/2 text-surface-400")
              input#confirmPassword(type="password" name="confirmPassword" required minlength="8" placeholder="Nhập lại mật khẩu mới" class="w-full bg-surface-50 border border-slate-200 rounded-xl py-3 pl-11 pr-11 text-sm font-medium focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all")
              button#togglePw2(type="button" aria-label="Hiện mật khẩu xác nhận" class="absolute right-4 top-1/2 -translate-y-1/2 text-surface-400 hover:text-brand-500 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-sm")
                i#eye2(class="bi bi-eye")
            p#confirmErr(class="hidden mt-1.5 text-xs font-semibold text-rose-500 flex items-center gap-1")
              i(class="bi bi-x-circle-fill")
              | Mật khẩu không khớp
          
          button#submitBtn(type="submit" class="btn-premium btn-primary w-full py-3 mt-2 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-brand-500 focus-visible:ring-offset-2") Cập nhật mật khẩu

  script.
    // Toggle password 1
    document.getElementById('togglePw1').addEventListener('click', function() {
      const pw = document.getElementById('password');
      const isHidden = pw.type === 'password';
      pw.type = isHidden ? 'text' : 'password';
      document.getElementById('eye1').className = isHidden ? 'bi bi-eye-slash' : 'bi bi-eye';
    });

    // Toggle password 2
    document.getElementById('togglePw2').addEventListener('click', function() {
      const pw = document.getElementById('confirmPassword');
      const isHidden = pw.type === 'password';
      pw.type = isHidden ? 'text' : 'password';
      document.getElementById('eye2').className = isHidden ? 'bi bi-eye-slash' : 'bi bi-eye';
    });

    // Validate
    const pwInput = document.getElementById('password');
    const confirmInput = document.getElementById('confirmPassword');
    const confirmErr = document.getElementById('confirmErr');
    const form = document.getElementById('resetForm');

    confirmInput.addEventListener('input', function() {
      if (this.value && this.value !== pwInput.value) {
        confirmErr.classList.remove('hidden');
        this.classList.add('border-rose-500', 'bg-rose-50');
      } else {
        confirmErr.classList.add('hidden');
        this.classList.remove('border-rose-500', 'bg-rose-50');
      }
    });

    form.addEventListener('submit', function(e) {
      if (confirmInput.value !== pwInput.value) {
        e.preventDefault();
        confirmErr.classList.remove('hidden');
        confirmInput.classList.add('border-rose-500', 'bg-rose-50');
        return;
      }
    });
