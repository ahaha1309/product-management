extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-error(5000)
  +alert-success(5000)

  .container.my-5
    .row.justify-content-center
      .col-md-6.col-lg-5
        .card.shadow-sm.border-0.rounded-4
          .card-body.p-4.p-sm-5
            .text-center.mb-4
              h2.fw-bold ĐẶT LẠI MẬT KHẨU
              p.text-muted Vui lòng nhập mật khẩu mới của bạn
            form(action="/auth/reset-password" method="POST")
              .form-group.mb-3
                label(for="password" class="form-label") Mật khẩu mới
                input#password.form-control.form-control-lg(
                  type="password"
                  name="password"
                  required
                  minlength="8"
                  placeholder="Nhập mật khẩu (ít nhất 8 ký tự)"
                )
              .form-group.mb-4
                label(for="confirmPassword" class="form-label") Xác nhận mật khẩu mới
                input#confirmPassword.form-control.form-control-lg(
                  type="password"
                  name="confirmPassword"
                  required
                  minlength="8"
                  placeholder="Nhập lại mật khẩu"
                )
              .d-grid
                button.btn.btn-primary.btn-lg.rounded-3(type="submit") CẬP NHẬT MẬT KHẨU
