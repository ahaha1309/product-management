extends ../../layouts/default.pug

block main
  div(class="container mx-auto px-4 max-w-6xl py-12 mb-20")
    //- Breadcrumb
    div(class="flex items-center gap-2 text-sm font-medium text-surface-500 mb-8")
      a(href="/loyalty" class="hover:text-brand-600 transition-colors") Thành viên
      i(class="bi bi-chevron-right text-[10px]")
      span(class="text-surface-900") Dashboard Chi Tiết

    h4(class="text-2xl font-black text-surface-900 mb-6 flex items-center gap-3")
      i.bi.bi-bar-chart-fill.text-brand-500
      | Loyalty Dashboard

    //- Stats top bar
    div(class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8")
      div(class="bento-card !p-6 bg-gradient-to-br from-brand-500 to-blue-600 text-white relative overflow-hidden")
        div(class="absolute top-0 right-0 p-4 opacity-10 text-6xl") 💎
        div(class="text-3xl font-black mb-1 relative z-10") #{(loyalty.totalPoints || 0).toLocaleString('vi-VN')}
        div(class="text-sm font-medium opacity-80 relative z-10") Xu hiện tại
      
      div(class="bento-card !p-6")
        div(class="text-3xl font-black text-amber-500 mb-1") #{loyalty.currentLevel || 'BRONZE'}
        div(class="text-sm font-bold text-surface-500 uppercase tracking-wider") Hạng hiện tại
      
      div(class="bento-card !p-6")
        div(class="text-3xl font-black text-emerald-500 mb-1") #{(loyalty.transactions || []).filter(t => t.points > 0).reduce((a,b) => a+b.points, 0).toLocaleString('vi-VN')}
        div(class="text-sm font-bold text-surface-500 uppercase tracking-wider") Tổng xu đã kiếm
      
      div(class="bento-card !p-6")
        div(class="text-3xl font-black text-rose-500 mb-1") #{Math.abs((loyalty.transactions || []).filter(t => t.points < 0).reduce((a,b) => a+b.points, 0)).toLocaleString('vi-VN')}
        div(class="text-sm font-bold text-surface-500 uppercase tracking-wider") Xu đã sử dụng

    div(class="grid grid-cols-1 lg:grid-cols-3 gap-8")
      
      //- Left Col: Tiers & Rewards (Spans 2)
      div(class="lg:col-span-2 space-y-8")
        
        //- Tier progression
        div(class="bento-card")
          h6(class="text-lg font-bold text-surface-900 mb-6") Lộ Trình Thăng Hạng
          div(class="grid grid-cols-2 sm:grid-cols-4 gap-4")
            - const tiers = ['BRONZE', 'SILVER', 'GOLD', 'PLATINUM']
            - const tierData = { BRONZE: {min: 0, discount: 0, icon: '🥉'}, SILVER: {min: 100, discount: 5, icon: '🥈'}, GOLD: {min: 300, discount: 10, icon: '🥇'}, PLATINUM: {min: 500, discount: 15, icon: '💎'} }
            
            each tier in tiers
              - const td = tierData[tier]
              - const isCurrent = tier === (loyalty.currentLevel || 'BRONZE')
              
              div(class=`rounded-2xl p-4 text-center border-2 transition-all ${isCurrent ? 'border-brand-500 bg-brand-50 relative' : 'border-slate-100 bg-surface-50'}`)
                if isCurrent
                  div(class="absolute -top-3 left-1/2 -translate-x-1/2 bg-brand-500 text-white text-[10px] font-bold uppercase tracking-wider py-1 px-3 rounded-full") Hiện tại
                div(class="text-4xl mb-3") #{td.icon}
                div(class="font-black text-surface-900 mb-1") #{tier}
                div(class="text-xs font-semibold text-surface-500 mb-3") #{td.min}+ xu
                div(class="text-sm font-bold text-brand-600 bg-white rounded-lg py-1.5 border border-slate-100") #{td.discount}% giảm

        //- Available Rewards
        div(class="bento-card")
          h6(class="text-lg font-bold text-surface-900 mb-6 flex items-center gap-2")
            i.bi.bi-gift-fill.text-rose-500
            | Có thể đổi ngay
          
          if availableRewards && availableRewards.length
            div(class="grid grid-cols-1 sm:grid-cols-2 gap-4")
              each reward in availableRewards
                if reward.available
                  div(class="rounded-2xl p-5 border-2 border-brand-500 bg-brand-50")
                    div(class="flex gap-4 items-center mb-4")
                      div(class="text-4xl") #{reward.icon}
                      div
                        h6(class="font-bold text-surface-900 text-sm") #{reward.name}
                        div(class="font-black text-brand-600 mt-1") #{reward.pointsRequired} xu
                    p(class="text-xs text-surface-500 mb-4") #{reward.description}
                    button(onclick=`quickRedeem('${reward.id}', ${reward.pointsRequired})` class="btn-premium btn-premium-primary w-full py-2.5 text-sm")
                      | Đổi Ngay
          else
            div(class="text-center py-10 bg-surface-50 rounded-2xl border border-dashed border-slate-200")
              p(class="text-sm font-medium text-surface-500") Bạn chưa đủ xu để đổi bất kỳ phần thưởng nào.

      //- Right Col: FAQ
      div(class="lg:col-span-1")
        div(class="bento-card")
          h6(class="text-lg font-bold text-surface-900 mb-6 flex items-center gap-2")
            i.bi.bi-question-circle-fill.text-brand-500
            | Câu hỏi thường gặp
          
          div(class="space-y-4")
            div(class="bg-surface-50 rounded-2xl p-5 border border-slate-100")
              h3(class="font-bold text-surface-900 text-sm mb-2 flex items-start gap-2")
                i(class="bi bi-clock text-amber-500")
                | Xu có hết hạn không?
              p(class="text-sm text-surface-600 leading-relaxed") Xu tích lũy không bao giờ hết hạn. Tuy nhiên, các voucher sau khi đổi sẽ có hạn sử dụng là 30 ngày.
              
            div(class="bg-surface-50 rounded-2xl p-5 border border-slate-100")
              h3(class="font-bold text-surface-900 text-sm mb-2 flex items-start gap-2")
                i(class="bi bi-arrow-up-circle text-emerald-500")
                | Làm sao để thăng hạng?
              p(class="text-sm text-surface-600 leading-relaxed") Hạng được tính dựa trên số xu bạn tích lũy được trong suốt thời gian sử dụng. Hệ thống tự động nâng hạng ngay khi đủ xu.
              
            div(class="bg-surface-50 rounded-2xl p-5 border border-slate-100")
              h3(class="font-bold text-surface-900 text-sm mb-2 flex items-start gap-2")
                i(class="bi bi-arrow-counterclockwise text-rose-500")
                | Có thể hoàn lại xu không?
              p(class="text-sm text-surface-600 leading-relaxed") Rất tiếc, một khi đã sử dụng xu để đổi lấy phần thưởng hoặc voucher, bạn không thể hoàn tác thao tác này.

  script.
    function quickRedeem(rewardId, points) {
      if (confirm(`Dùng ${points} xu để nhận phần thưởng này?`)) {
        fetch('/loyalty/redeem', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ rewardId, pointsToRedeem: points })
        })
        .then(res => res.json())
        .then(data => {
          if (data.code === '00') {
            alert('✅ ' + data.message);
            location.reload();
          } else {
            alert('❌ ' + (data.message || 'Đổi thưởng thất bại'));
          }
        });
      }
    }
