extends ../../layouts/default.pug

block main
  .container.py-5
    .row.align-items-center.justify-content-center
      .col-lg-5
        img.img-fluid.mb-4(src="https://img.freepik.com/free-vector/customer-loyalty-concept-illustration_114360-6101.jpg" alt="Loyalty Program" style="border-radius:16px;")
      .col-lg-6.offset-lg-1
        .card.border-0.shadow-sm(style="border-radius:16px;")
          .card-body.p-5
            .text-center.mb-4
              h2.fw-bold.text-primary VanHa Rewards
              p.text-muted Chương trình Khách hàng thân thiết VanHa Tech
            
            .features-list.mb-4
              .d-flex.align-items-center.mb-3
                i.bi.bi-check-circle-fill.text-success.fs-4.me-3
                div
                  h6.fw-bold.mb-0 Tích điểm mỗi giao dịch
                  span.text-muted.small 1 điểm cho mỗi 10,000đ mua sắm
              .d-flex.align-items-center.mb-3
                i.bi.bi-check-circle-fill.text-success.fs-4.me-3
                div
                  h6.fw-bold.mb-0 Đặc quyền theo hạng thẻ
                  span.text-muted.small Giảm tới 15% cho thành viên Platinum
              .d-flex.align-items-center.mb-3
                i.bi.bi-check-circle-fill.text-success.fs-4.me-3
                div
                  h6.fw-bold.mb-0 Quà tặng sinh nhật
                  span.text-muted.small Tặng ngay 100 điểm vào tháng sinh nhật
            
            form(action="/loyalty/register" method="POST")
              button.btn.btn-primary.w-100.py-3.fw-bold(type="submit")
                i.bi.bi-star-fill.me-2
                | Tham gia miễn phí ngay
