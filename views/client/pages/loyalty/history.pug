extends ../../layouts/default.pug

block main
  div(class="container mx-auto px-4 max-w-6xl py-12 mb-20")
    //- Header
    div(class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8")
      div
        h4(class="text-2xl font-black text-surface-900 flex items-center gap-3 mb-2")
          i.bi.bi-clock-history.text-brand-500
          | Lịch Sử Tích Xu
        p(class="text-surface-500 font-medium text-sm") Toàn bộ hoạt động tích điểm và đổi thưởng của bạn
      a(href="/loyalty" class="px-5 py-2.5 rounded-xl border border-slate-200 text-sm font-bold text-surface-700 hover:bg-surface-50 transition-colors flex items-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500") 
        i(class="bi bi-arrow-left")
        | Quay lại

    //- Filter bar
    div(class="bento-card mb-8")
      div(class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center")
        div
          label(class="block text-xs font-bold text-surface-500 uppercase tracking-wider mb-2") Loại giao dịch
          select#filter-type(onchange="applyFilters()" class="w-full bg-surface-50 border border-slate-200 rounded-xl py-2.5 px-4 text-sm font-bold text-surface-700 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 cursor-pointer transition-all")
            option(value='') Tất cả giao dịch
            option(value='purchase') 🛒 Mua sắm
            option(value='review') ⭐ Viết Review
            option(value='referral') 👥 Giới thiệu
            option(value='reward_redemption') 🎁 Đổi thưởng
        
        div
          label(class="block text-xs font-bold text-surface-500 uppercase tracking-wider mb-2") Thời gian
          select#filter-date(onchange="applyFilters()" class="w-full bg-surface-50 border border-slate-200 rounded-xl py-2.5 px-4 text-sm font-bold text-surface-700 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 cursor-pointer transition-all")
            option(value='all') Tất cả thời gian
            option(value='7days') 7 ngày gần nhất
            option(value='30days') 30 ngày gần nhất
        
        div(class="flex flex-col md:items-end")
          label(class="block text-xs font-bold text-surface-500 uppercase tracking-wider mb-2") Tổng số dư
          div(class="text-2xl font-black text-brand-600") #{(loyalty.totalPoints || 0).toLocaleString('vi-VN')} <span class="text-sm font-bold text-surface-400">xu</span>

    //- Transactions
    if transactions && transactions.length > 0
      - let balance = 0
      div(class="bento-card !p-0 overflow-hidden")
        div(class="overflow-x-auto")
          table#transactions-table(class="w-full text-left border-collapse")
            thead(class="bg-surface-50 border-b border-slate-100")
              tr
                th(class="py-4 px-6 text-xs font-bold text-surface-500 uppercase tracking-wider whitespace-nowrap") Ngày giờ
                th(class="py-4 px-6 text-xs font-bold text-surface-500 uppercase tracking-wider whitespace-nowrap") Loại hoạt động
                th(class="py-4 px-6 text-xs font-bold text-surface-500 uppercase tracking-wider min-w-[200px]") Chi tiết
                th(class="py-4 px-6 text-xs font-bold text-surface-500 uppercase tracking-wider text-right whitespace-nowrap") Biến động
                th(class="py-4 px-6 text-xs font-bold text-surface-500 uppercase tracking-wider text-right whitespace-nowrap") Số dư
            
            tbody(class="divide-y divide-slate-100")
              each tx in transactions
                - balance += tx.points
                tr(data-type=tx.type data-date=tx.createdAt class="hover:bg-surface-50/50 transition-colors")
                  td(class="py-4 px-6 text-sm text-surface-500 font-medium whitespace-nowrap") #{moment(tx.createdAt).format('DD/MM/YYYY HH:mm')}
                  
                  td(class="py-4 px-6 whitespace-nowrap")
                    div(class=`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold ${tx.type === 'purchase' ? 'bg-blue-50 text-blue-600' : tx.type === 'review' ? 'bg-amber-50 text-amber-600' : tx.type === 'referral' ? 'bg-purple-50 text-purple-600' : 'bg-rose-50 text-rose-600'}`)
                      if tx.type === 'purchase'
                        | 🛒 Mua sắm
                      else if tx.type === 'review'
                        | ⭐ Review
                      else if tx.type === 'referral'
                        | 👥 Refer
                      else if tx.type === 'reward_redemption'
                        | 🎁 Đổi thưởng
                      else
                        | ✓ #{tx.type}
                        
                  td(class="py-4 px-6 text-sm font-bold text-surface-900")= tx.description
                  
                  td(class="py-4 px-6 text-right whitespace-nowrap")
                    div(class=`text-sm font-black ${tx.points > 0 ? 'text-emerald-500' : 'text-rose-500'}`)
                      | #{tx.points > 0 ? '+' : ''}#{tx.points}
                      
                  td(class="py-4 px-6 text-right text-sm font-bold text-surface-500 whitespace-nowrap") #{balance}

      //- Summary footer
      div(class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6")
        div(class="bg-emerald-50 border border-emerald-100 rounded-2xl p-5")
          div(class="text-xs font-bold text-emerald-600/70 uppercase tracking-wider mb-1") Tổng xu đã nhận
          - let earned = transactions.filter(t => t.points > 0).reduce((a,b) => a+b.points, 0)
          div(class="text-2xl font-black text-emerald-600") +#{earned.toLocaleString('vi-VN')}
        
        div(class="bg-rose-50 border border-rose-100 rounded-2xl p-5")
          div(class="text-xs font-bold text-rose-600/70 uppercase tracking-wider mb-1") Tổng xu đã dùng
          - let spent = Math.abs(transactions.filter(t => t.points < 0).reduce((a,b) => a+b.points, 0))
          div(class="text-2xl font-black text-rose-600") -#{spent.toLocaleString('vi-VN')}
        
        div(class="bg-brand-50 border border-brand-100 rounded-2xl p-5")
          div(class="text-xs font-bold text-brand-600/70 uppercase tracking-wider mb-1") Số dư hiện tại
          div(class="text-2xl font-black text-brand-600") #{(loyalty.totalPoints || 0).toLocaleString('vi-VN')}

    else
      div(class="bento-card text-center py-20")
        div(class="w-20 h-20 rounded-full bg-surface-100 flex items-center justify-center mx-auto mb-6")
          i(class="bi bi-inbox text-4xl text-surface-400")
        h5(class="text-xl font-bold text-surface-900 mb-2") Chưa có giao dịch nào
        p(class="text-surface-500 font-medium mb-6") Bắt đầu mua sắm hoặc viết đánh giá để tích lũy xu!
        a(href="/product" class="btn-premium btn-primary px-8 py-3 text-sm focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-brand-500 focus-visible:ring-offset-2")
          i(class="bi bi-bag mr-2")
          | Xem sản phẩm ngay

  script.
    function applyFilters() {
      const type = document.getElementById('filter-type').value;
      const date = document.getElementById('filter-date').value;
      const rows = document.querySelectorAll('#transactions-table tbody tr');
      const now = new Date();
      
      rows.forEach(row => {
        let show = true;
        
        if (type && row.dataset.type !== type) show = false;
        
        if (date !== 'all' && row.dataset.date) {
          const txDate = new Date(row.dataset.date);
          const diff = (now - txDate) / (1000 * 60 * 60 * 24);
          if (date === '7days' && diff > 7) show = false;
          if (date === '30days' && diff > 30) show = false;
        }
        
        row.style.display = show ? '' : 'none';
      });
    }
