extends ../../layouts/default.pug 
include ../../mixins/box-head.pug

block main
  .container.mt-4.cart-page
    h4.mb-4.fw-bold(style="color: var(--shopee-primary);") <i class="bi bi-cart3 me-2"></i> Giỏ hàng của bạn

    if (cart && cart.products && cart.products.length > 0)
      //- Headers
      .bg-white.rounded.shadow-sm.p-3.mb-3.d-none.d-md-flex.align-items-center.text-muted
        .col-1.text-center 
          input#check-all(type="checkbox" style="transform: scale(1.2);")
        .col-5 Sản phẩm
        .col-2.text-center Đơn giá
        .col-2.text-center Số lượng
        .col-1.text-center Số tiền
        .col-1.text-center Thao tác

      //- MOCKUP SHOP HEADER
      .bg-white.rounded-top.shadow-sm.p-3.border-bottom
        .fw-bold 
          span.shopee-shop-badge Chính Hãng
          | VanHa Tech Store

      //- Sản Phẩm
      .bg-white.rounded-bottom.shadow-sm.p-3.mb-4
        each item in cart.products
          .cart-item.d-flex.align-items-center.py-3.border-bottom
            //- Checkbox
            .col-1.text-center
              input.item-check(type="checkbox" slug=item.product.slug variant=(item.variantText || '') data-price='' checkbox style="transform: scale(1.2);")

            //- Hình ảnh & Tên
            .col-5.d-flex.align-items-center
              img.cart-img.rounded.me-3(src=item.product.thumbnail alt=item.product.title style="width: 80px; height: 80px; object-fit: cover; border: 1px solid #eee;")
              div
                a.text-dark.text-decoration-none.fw-bold(href=`/product/detail/${item.product.slug}` style="font-size: 14px;") #{item.product.title}
                if item.variantText
                  div.text-secondary.small.mt-1 Phân loại: #{item.variantText}
                if item.product.discountPercentage > 0
                  div.text-danger.small.mt-1 -#{item.product.discountPercentage}%
            
            //- Đơn giá
            .col-2.text-center
              if item.product.discountPercentage > 0
                div.text-muted.text-decoration-line-through.small ₫#{Number(item.product.price).toLocaleString('vi-VN')}
              div.cart-price(data-price=item.product.newPrice style="color: #222;") ₫#{Number(item.product.newPrice).toLocaleString('vi-VN')}
            
            //- Số lượng
            .col-2.d-flex.justify-content-center
              .quantity-group.d-flex
                button.btn-qty.minus(type="button") -
                input.input-qty(type="number" value=item.quantity min="1" name="quantity" data-product-id=item.product.id)
                button.btn-qty.plus(type="button") +
            
            //- Thành tiền
            .col-1.text-center.cart-item-total.fw-bold(style="color: var(--shopee-primary);")
              | ₫#{Number(item.quantity * item.product.newPrice).toLocaleString('vi-VN')}
            
            //- Nút Xóa
            .col-1.text-center
              form(action=`/cart/delete/${item.productId}?_method=PATCH` method="POST")
                button.btn-delete(type="submit" title="Xóa sản phẩm" style="background: none; border: none;")
                  i.bi.bi-trash.text-danger.fs-5

      //- STICKY FOOTER TỔNG TIỀN
      .cart-sticky-footer
        .d-flex.align-items-center
          input#check-all-footer.me-2(type="checkbox" style="transform: scale(1.2);")
          label(for="check-all-footer" style="cursor: pointer;") Chọn Tất Cả
        .d-flex.align-items-center.gap-4
          div.text-end
            span.text-muted Tổng thanh toán: 
            span.total-amount.fw-bold.fs-4(style="color: var(--shopee-primary);") ₫0
          form(action='/order' method='GET' id="checkout-form")
            input(type="hidden" name="listProduct")
            button.btn.btn-shopee-solid.px-5.py-2.fw-bold.fs-5(type="submit") Mua Hàng

    else
      //- Giỏ hàng trống
      .text-center.p-5.bg-white.rounded.shadow-sm
        img(src="https://deo.shopeemobile.com/shopee/shopee-pcmall-live-sg/cart/9bdd8040b334d31946f49e36beaf32db.png" width="150" alt="Empty Cart")
        p.mt-3.mb-4.fs-5 Giỏ hàng của bạn còn trống.
        a.btn.btn-shopee-solid.px-4.py-2(href="/product") Mua Ngay

  script(src='/js/cart.js')
  form(action='' 
       method='POST' 
       form-update-quantity
       data-path='/cart/update-quantity'
    )