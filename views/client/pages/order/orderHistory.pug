extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-success(messages.success)
  +alert-error(messages.error)

  div(class="container mx-auto px-4 max-w-5xl py-8 mb-20")
    
    div(class="mb-8")
      h1(class="text-3xl font-black text-surface-950 tracking-tight") Lịch sử đơn hàng
      p(class="text-surface-500 mt-2") Quản lý và theo dõi các đơn hàng của bạn.

    //- Status Tabs
    div(class="flex overflow-x-auto hide-scrollbar gap-2 mb-8 bg-surface-50 p-2 rounded-2xl border border-slate-100")
      a(href="/order/history" class=`shrink-0 px-6 py-2.5 rounded-xl text-sm font-semibold transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 ${!status ? 'bg-white text-brand-600 shadow-sm border border-slate-200' : 'text-surface-600 hover:bg-white/50 hover:text-surface-900'}`) Tất cả
      a(href="/order/history?status=pending" class=`shrink-0 px-6 py-2.5 rounded-xl text-sm font-semibold transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 ${status=='pending' ? 'bg-white text-brand-600 shadow-sm border border-slate-200' : 'text-surface-600 hover:bg-white/50 hover:text-surface-900'}`) Chờ xác nhận
      a(href="/order/history?status=confirm" class=`shrink-0 px-6 py-2.5 rounded-xl text-sm font-semibold transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 ${status=='confirm' ? 'bg-white text-brand-600 shadow-sm border border-slate-200' : 'text-surface-600 hover:bg-white/50 hover:text-surface-900'}`) Đang xử lý
      a(href="/order/history?status=finish" class=`shrink-0 px-6 py-2.5 rounded-xl text-sm font-semibold transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 ${status=='finish' ? 'bg-white text-brand-600 shadow-sm border border-slate-200' : 'text-surface-600 hover:bg-white/50 hover:text-surface-900'}`) Hoàn thành
      a(href="/order/history?status=canceled" class=`shrink-0 px-6 py-2.5 rounded-xl text-sm font-semibold transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 ${status=='canceled' ? 'bg-white text-brand-600 shadow-sm border border-slate-200' : 'text-surface-600 hover:bg-white/50 hover:text-surface-900'}`) Đã hủy

    if orders && orders.length > 0
      div(class="flex flex-col gap-6 orders-list")
        each order in orders
          - var statusMap = { 'pending': {label: 'Chờ xác nhận', color: 'text-amber-600', bg: 'bg-amber-50', border: 'border-amber-200'}, 'confirm': {label: 'Đang xử lý', color: 'text-blue-600', bg: 'bg-blue-50', border: 'border-blue-200'}, 'finish': {label: 'Hoàn thành', color: 'text-emerald-600', bg: 'bg-emerald-50', border: 'border-emerald-200'}, 'canceled': {label: 'Đã hủy', color: 'text-rose-600', bg: 'bg-rose-50', border: 'border-rose-200'} }
          - var statusInfo = statusMap[order.status] || {label: 'Chờ xác nhận', color: 'text-amber-600', bg: 'bg-amber-50', border: 'border-amber-200'}
          - var paymentInfo = order.paymentStatus === 'success' ? 'Đã thanh toán' : (order.paymentStatus === 'failed' ? 'Thanh toán thất bại' : 'Chờ thanh toán')
          
          div(class="bento-card !p-0 overflow-hidden shopee-card group")
            //- Header
            div(class="px-6 py-4 bg-surface-50 border-b border-slate-100 flex flex-wrap justify-between items-center gap-4 card-header")
              div(class="flex items-center gap-3 shop-info")
                div(class="w-8 h-8 rounded-full bg-white border border-slate-200 flex items-center justify-center text-brand-500 shadow-sm")
                  i.bi.bi-shop
                div
                  span(class="font-bold text-surface-900 text-sm") NVH Mall Store
                  div(class="text-xs text-surface-500") Đơn hàng: <span class="font-mono text-surface-700">#{order.orderCode}</span>
              
              span.order-status-badge(class=`px-3 py-1 rounded-full text-xs font-bold border ${statusInfo.bg} ${statusInfo.color} ${statusInfo.border}`) #{statusInfo.label}

            //- Body
            a(href=`/order/detail/${order._id}` class="block px-6 py-4 card-body focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-lg")
              each item in order.products
                div(class="flex items-start sm:items-center gap-4 py-4 border-b border-slate-100 last:border-0 last:pb-0 shopee-product")
                  img(src=item.thumbnail alt=item.title width="80" height="80" class="w-20 h-20 rounded-xl object-cover border border-slate-100 bg-white shadow-sm transition-transform group-hover:scale-105 motion-reduce:transition-none motion-reduce:transform-none")
                  div(class="flex-1")
                    h4(class="font-bold text-surface-900 text-sm leading-tight line-clamp-2") #{item.title}
                    if item.variant
                      p(class="text-xs text-surface-500 mt-1.5 inline-block bg-surface-100 px-2 py-0.5 rounded") Phân loại: #{item.variant}
                    div(class="text-sm font-medium text-surface-500 mt-2") x#{item.quantity}
                  div(class="text-right")
                    span(class="font-bold text-surface-900") #{Number(item.newPrice).toLocaleString('vi-VN')}₫

            //- Footer
            div(class="px-6 py-4 bg-surface-50/50 border-t border-slate-100 flex flex-wrap justify-between items-center gap-4 card-footer")
              div
                - var totalQty = order.products.reduce((sum, p) => sum + p.quantity, 0)
                div(class="text-sm text-surface-600 total-amount")
                  | Thành tiền (#{totalQty} sản phẩm): 
                  span(class="font-black text-brand-600 text-lg ml-1 amount-highlight") #{order.amount.toLocaleString('vi-VN')}₫
                div(class="text-xs text-surface-500 mt-1 payment-note flex items-center gap-1.5")
                  if order.paymentStatus === 'success'
                    i.bi.bi-check-circle-fill.text-emerald-500
                  else if order.paymentStatus === 'failed'
                    i.bi.bi-x-circle-fill.text-rose-500
                  else
                    i.bi.bi-clock-fill.text-amber-500
                  | #{paymentInfo}

              div(class="flex gap-3 card-actions")
                a(href=`/order/detail/${order._id}` class="px-5 py-2.5 rounded-xl border border-slate-200 text-sm font-semibold text-surface-700 hover:bg-surface-100 transition-colors btn-outline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500") Xem chi tiết
                if order.status === 'finish' || order.status === 'canceled'
                  a(href=`/order/rebuy/${order._id}` class="btn-premium btn-primary px-5 py-2.5 text-sm btn-rebuy focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-1") Mua lại
                if order.cancelRequest
                  button.btn-cancel-request(disabled class="px-5 py-2.5 rounded-xl border border-slate-200 bg-surface-100 text-surface-400 text-sm font-semibold cursor-not-allowed flex items-center gap-2")
                    i.bi.bi-hourglass-split
                    | Đang chờ duyệt hủy
                else if order.status !== 'canceled' && order.paymentStatus === 'pending' && order.status !== 'finish'
                  button.btn-cancel-order(data-id=`${order._id}` class="px-5 py-2.5 rounded-xl border border-rose-200 text-rose-600 bg-rose-50 hover:bg-rose-500 hover:text-white transition-colors text-sm font-semibold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-500 focus-visible:ring-offset-1") Hủy đơn

    else
      div(class="bento-card flex flex-col items-center justify-center py-20 text-center empty-orders")
        div(class="w-32 h-32 bg-surface-50 rounded-full flex items-center justify-center mb-6 relative")
          i.bi.bi-box-seam.text-5xl.text-surface-300
          i(class="bi bi-stars absolute top-2 right-2 text-brand-400 text-xl perpetual-pulse motion-reduce:animate-none")
        h2(class="text-xl font-bold text-surface-900 mb-2") Chưa có đơn hàng nào
        p(class="text-surface-500 mb-8 max-w-sm") Hãy khám phá và chọn mua những sản phẩm công nghệ yêu thích nhé!
        a(href="/product" class="btn-premium btn-primary px-8 py-3 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-brand-500 focus-visible:ring-offset-2")
          | Mua sắm ngay
          i.bi.bi-arrow-right.ml-2

  script(src='/js/orderHistory.js')