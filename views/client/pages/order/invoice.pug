doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title #{title} - NVH Mall
    link(href="/css/tailwind.css", rel="stylesheet")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")
    style.
      @page {
        size: A4;
        margin: 1.5cm;
      }
      body {
        font-family: 'Inter', sans-serif;
        color: #1e293b;
        background-color: #f8fafc;
      }
      .invoice-container {
        max-width: 800px;
        margin: 0 auto;
        background: #fff;
        padding: 40px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      }
      @media print {
        body { background-color: #fff; }
        .invoice-container { box-shadow: none; padding: 0; }
        .no-print { display: none !important; }
      }

  body(onload="window.print()")
    
    //- Controls (hidden when printing)
    div(class="no-print text-center py-4 bg-slate-900 text-white flex justify-center gap-4")
      button(onclick="window.print()" class="px-6 py-2 bg-brand-500 rounded-lg font-bold hover:bg-brand-600 transition-colors flex items-center gap-2")
        i.bi.bi-printer
        | In Hóa Đơn
      a(href=`/order/detail/${order._id}` class="px-6 py-2 bg-slate-700 rounded-lg font-bold hover:bg-slate-600 transition-colors")
        | Trở về

    //- Invoice Content
    div(class="invoice-container rounded-2xl my-8")
      
      //- Header
      div(class="flex justify-between items-start border-b-2 border-slate-100 pb-8 mb-8")
        div
          h1(class="text-4xl font-black text-brand-600 tracking-tight mb-2") HÓA ĐƠN
          p(class="text-slate-500 font-medium") NVH Mall E-commerce
          p(class="text-sm text-slate-400 mt-1")
            | Hà Nội, Việt Nam<br>
            | Hotline: 1900 1234
        
        div(class="text-right")
          div(class="w-16 h-16 bg-brand-50 rounded-2xl flex items-center justify-center ml-auto mb-3")
            i.bi.bi-bag-check-fill.text-3xl.text-brand-500
          h2(class="font-bold text-slate-800 text-lg") Mã Đơn: ##{order.orderCode || order._id.toString().substring(18)}
          p(class="text-sm text-slate-500 mt-1") Ngày: #{new Date(order.createdAt).toLocaleDateString('vi-VN')}

      //- Customer Info
      div(class="grid grid-cols-2 gap-8 mb-8")
        div
          p(class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2") Thông tin người đặt
          p(class="font-bold text-slate-800 text-lg") #{order.shippingAddress ? order.shippingAddress.fullName : 'Khách hàng'}
          p(class="text-slate-600 mt-1") #{order.shippingAddress ? order.shippingAddress.phone : ''}
          p(class="text-slate-600 text-sm mt-1") #{order.shippingAddress ? order.shippingAddress.address : ''}
        
        div(class="text-right")
          p(class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2") Thanh toán
          p(class="font-bold text-slate-800") #{order.paymentMethod === 'cod' ? 'Thanh toán khi nhận hàng' : 'Thanh toán qua VNPAY'}
          if order.paymentStatus === 'success'
            span(class="inline-block mt-1 px-3 py-1 bg-emerald-50 text-emerald-600 text-xs font-bold rounded-md border border-emerald-100")
              | Đã thanh toán
          else
            span(class="inline-block mt-1 px-3 py-1 bg-amber-50 text-amber-600 text-xs font-bold rounded-md border border-amber-100")
              | Chưa thanh toán

      //- Products Table
      table(class="w-full text-left border-collapse mb-8")
        thead
          tr(class="border-b-2 border-slate-800 text-slate-800")
            th(class="py-3 font-bold uppercase text-xs tracking-wider") Sản phẩm
            th(class="py-3 font-bold uppercase text-xs tracking-wider text-center") SL
            th(class="py-3 font-bold uppercase text-xs tracking-wider text-right") Đơn giá
            th(class="py-3 font-bold uppercase text-xs tracking-wider text-right") Thành tiền
        tbody
          each item in order.products
            tr(class="border-b border-slate-100")
              td(class="py-4 pr-4")
                p(class="font-semibold text-slate-800") #{item.title}
                if item.variantText
                  p(class="text-xs text-slate-500 mt-1") #{item.variantText}
              td(class="py-4 text-center font-medium text-slate-600") #{item.quantity}
              td(class="py-4 text-right font-medium text-slate-600") #{Number(item.newPrice).toLocaleString('vi-VN')}₫
              td(class="py-4 text-right font-bold text-slate-800") #{(item.quantity * item.newPrice).toLocaleString('vi-VN')}₫

      //- Summary
      div(class="flex justify-end")
        div(class="w-72 space-y-3")
          div(class="flex justify-between text-sm")
            span(class="text-slate-500") Tạm tính
            span(class="font-bold text-slate-800") #{(order.amount - 30000).toLocaleString('vi-VN')}₫
          
          div(class="flex justify-between text-sm")
            span(class="text-slate-500") Phí vận chuyển
            span(class="font-bold text-slate-800") 30.000₫
            
          if order.voucherCode
            div(class="flex justify-between text-sm text-brand-600")
              span(class="font-medium") Voucher: #{order.voucherCode}
              span(class="font-bold") Đã áp dụng
              
          div(class="pt-3 border-t-2 border-slate-800 flex justify-between items-center")
            span(class="font-bold text-slate-800 uppercase tracking-wider") TỔNG CỘNG
            span(class="text-2xl font-black text-brand-600") #{order.amount.toLocaleString('vi-VN')}₫

      //- Footer
      div(class="mt-16 pt-8 border-t border-slate-200 text-center text-slate-500 text-sm")
        p Cảm ơn quý khách đã mua sắm tại NVH Mall!
        p(class="text-xs mt-1") Đây là hóa đơn điện tử hợp lệ. Vui lòng giữ lại để bảo hành sản phẩm nếu cần.
