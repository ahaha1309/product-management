extends ../../layouts/default.pug
include ../../../admin/mixins/moment.pug

block main
  div(class="container mx-auto px-4 max-w-5xl py-12 mb-24")
    
    //- Header
    div(class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8")
      div
        h1(class="text-3xl font-black text-surface-950 tracking-tight flex items-center gap-3")
          a(href="/order/history" class="w-10 h-10 rounded-full bg-surface-100 flex items-center justify-center text-surface-500 hover:bg-brand-50 hover:text-brand-600 transition-colors")
            i.bi.bi-arrow-left.text-xl
          | Chi tiết đơn hàng
        p(class="text-surface-500 mt-2 ml-13 font-medium") 
          | Mã đơn: <span class="text-surface-900 font-bold uppercase">##{order.orderCode || order._id.toString().substring(18)}</span>
          |  • Ngày đặt: 
          +formatDateTime(order.createdAt)
      
      div(class="flex items-center gap-3")
        a(href=`/order/print/${order._id}` target="_blank" class="px-5 py-2.5 rounded-xl border border-brand-200 text-brand-600 font-bold hover:bg-brand-50 transition-colors flex items-center gap-2")
          i.bi.bi-printer
          | In hóa đơn

    //- Timeline Stepper
    - var statusMap = { 'pending': 1, 'confirm': 2, 'finish': 3, 'canceled': -1 }
    - var currentStep = statusMap[order.status || 'pending']
    
    div(class="bento-card mb-8 !p-8")
      if currentStep === -1
        div(class="text-center py-6")
          div(class="w-20 h-20 bg-rose-50 rounded-full flex items-center justify-center mx-auto mb-4 border-4 border-rose-100")
            i.bi.bi-x-lg.text-rose-500.text-3xl
          h3(class="text-2xl font-black text-rose-600 mb-2") Đơn hàng đã hủy
          p(class="text-surface-500 font-medium") Đơn hàng này đã bị hủy. Nếu bạn đã thanh toán, hệ thống sẽ tự động hoàn tiền trong 3-5 ngày làm việc.
          a(href=`/order/rebuy/${order._id}` class="inline-flex items-center gap-2 px-6 py-3 bg-rose-50 text-rose-600 rounded-xl font-bold mt-6 hover:bg-rose-100 transition-colors")
            i.bi.bi-cart-plus
            | Mua lại đơn này
      else
        div(class="relative mt-4 mb-2 max-w-3xl mx-auto")
          //- Background Line
          div(class="absolute top-6 left-0 w-full h-1.5 bg-surface-100 rounded-full")
          
          //- Active Line
          - var lineWidth = currentStep === 1 ? '10%' : (currentStep === 2 ? '50%' : '100%')
          div(class="absolute top-6 left-0 h-1.5 bg-brand-500 rounded-full transition-all duration-1000 shadow-[0_0_10px_rgba(16,185,129,0.5)]" style=`width: ${lineWidth}`)
          
          div(class="flex justify-between relative z-10")
            //- Step 1
            div(class="flex flex-col items-center gap-3")
              div(class=`w-12 h-12 rounded-full flex items-center justify-center font-black border-4 border-white transition-all duration-500 ${currentStep >= 1 ? 'bg-brand-500 text-white shadow-lg shadow-brand-500/30' : 'bg-surface-100 text-surface-400'}`)
                i.bi.bi-receipt.text-xl
              span(class=`text-sm font-bold ${currentStep >= 1 ? 'text-surface-900' : 'text-surface-400'}`) Chờ xác nhận
            
            //- Step 2
            div(class="flex flex-col items-center gap-3")
              div(class=`w-12 h-12 rounded-full flex items-center justify-center font-black border-4 border-white transition-all duration-500 ${currentStep >= 2 ? 'bg-brand-500 text-white shadow-lg shadow-brand-500/30' : 'bg-surface-100 text-surface-400'}`)
                i.bi.bi-box-seam.text-xl
              span(class=`text-sm font-bold ${currentStep >= 2 ? 'text-surface-900' : 'text-surface-400'}`) Đang giao hàng
            
            //- Step 3
            div(class="flex flex-col items-center gap-3")
              div(class=`w-12 h-12 rounded-full flex items-center justify-center font-black border-4 border-white transition-all duration-500 ${currentStep >= 3 ? 'bg-emerald-500 text-white shadow-lg shadow-emerald-500/30' : 'bg-surface-100 text-surface-400'}`)
                i.bi.bi-check-all.text-2xl
              span(class=`text-sm font-bold ${currentStep >= 3 ? 'text-surface-900' : 'text-surface-400'}`) Hoàn thành

    div(class="grid grid-cols-1 lg:grid-cols-3 gap-8")
      //- Left Column
      div(class="lg:col-span-2 space-y-8")
        
        //- Products List
        div(class="bento-card")
          h2(class="text-xl font-bold text-surface-900 mb-6 flex items-center gap-2")
            i.bi.bi-bag-check.text-brand-500
            | Danh sách sản phẩm
          
          div(class="space-y-4")
            each item in order.products
              div(class="flex items-start sm:items-center gap-4 p-4 rounded-2xl bg-surface-50 border border-slate-100")
                img(src=item.thumbnail alt=item.title class="w-20 h-20 rounded-xl object-cover border border-slate-200 bg-white")
                div(class="flex-1")
                  h4(class="font-bold text-surface-900 text-sm leading-tight mb-1")= item.title
                  if item.variantText
                    p(class="text-xs text-surface-500 font-medium mb-2") Phân loại: #{item.variantText}
                  div(class="flex items-center gap-3")
                    span(class="font-black text-brand-600") #{Number(item.newPrice).toLocaleString('vi-VN')}₫
                    span(class="text-xs font-bold text-surface-500 bg-surface-200 px-2 py-0.5 rounded-md") x#{item.quantity}
                div(class="text-right font-black text-surface-900 hidden sm:block")
                  | #{(item.newPrice * item.quantity).toLocaleString('vi-VN')}₫

        //- Shipping Info
        div(class="bento-card")
          h2(class="text-xl font-bold text-surface-900 mb-6 flex items-center gap-2")
            i.bi.bi-geo-alt.text-brand-500
            | Thông tin giao hàng
          
          div(class="bg-surface-50 rounded-2xl p-5 border border-slate-100")
            div(class="flex items-start gap-4 mb-4")
              i.bi.bi-person-circle.text-surface-400.text-xl.mt-1
              div
                div(class="text-xs text-surface-500 uppercase font-bold tracking-wider mb-1") Người nhận
                div(class="font-medium text-surface-900") 
                  | #{order.shippingAddress ? order.shippingAddress.fullName : user.fullName} 
                  | - #{order.shippingAddress ? order.shippingAddress.phone : user.phone}
            div(class="flex items-start gap-4")
              i.bi.bi-house-door.text-surface-400.text-xl.mt-1
              div
                div(class="text-xs text-surface-500 uppercase font-bold tracking-wider mb-1") Địa chỉ nhận hàng
                div(class="font-medium text-surface-900 leading-relaxed") 
                  | #{order.shippingAddress ? order.shippingAddress.address : user.address}

      //- Right Column
      div(class="space-y-8")
        
        //- Payment Summary
        div(class="bento-card")
          h2(class="text-xl font-bold text-surface-900 mb-6 flex items-center gap-2")
            i.bi.bi-credit-card.text-brand-500
            | Tóm tắt thanh toán
            
          div(class="space-y-4 mb-6")
            div(class="flex justify-between items-center text-sm")
              span(class="text-surface-500 font-medium") Tạm tính
              span(class="font-bold text-surface-900") #{(order.amount - 30000).toLocaleString('vi-VN')}₫
            
            div(class="flex justify-between items-center text-sm")
              span(class="text-surface-500 font-medium") Phí vận chuyển
              span(class="font-bold text-surface-900") 30.000₫
              
            if order.voucherCode
              div(class="flex justify-between items-center text-sm text-brand-600 bg-brand-50 p-2 -mx-2 px-2 rounded-lg")
                span(class="font-bold flex items-center gap-1")
                  i.bi.bi-ticket-perforated
                  | Mã giảm giá: #{order.voucherCode}
                span(class="font-bold") Đã áp dụng
                
          div(class="pt-4 border-t border-slate-100 flex justify-between items-center mb-6")
            span(class="text-surface-900 font-bold") Tổng tiền
            span(class="text-2xl font-black text-brand-600") #{order.amount.toLocaleString('vi-VN')}₫

          div(class="bg-surface-50 p-4 rounded-xl border border-slate-100 space-y-3 mb-6")
            div(class="flex justify-between text-sm")
              span(class="text-surface-500") Phương thức:
              span(class="font-bold text-surface-900") #{order.paymentMethod === 'cod' ? 'Thanh toán khi nhận hàng' : 'Thanh toán qua VNPAY'}
            div(class="flex justify-between text-sm")
              span(class="text-surface-500") Trạng thái:
              if order.paymentStatus === 'success'
                span(class="font-bold text-emerald-600 flex items-center gap-1")
                  i.bi.bi-check-circle-fill
                  | Đã thanh toán
              else if order.paymentStatus === 'failed'
                span(class="font-bold text-rose-600 flex items-center gap-1")
                  i.bi.bi-x-circle-fill
                  | Thanh toán thất bại
              else
                span(class="font-bold text-amber-600 flex items-center gap-1")
                  i.bi.bi-clock-fill
                  | Chưa thanh toán
                  
          if currentStep !== -1
            if order.cancelRequest
              button(disabled class="w-full py-4 rounded-xl bg-surface-100 text-surface-500 font-bold cursor-not-allowed flex justify-center items-center gap-2")
                i.bi.bi-hourglass-split
                | Đang chờ duyệt hủy
            else if currentStep === 1
              button#btnCancelOrder(type="button" data-id=order._id class="w-full py-4 rounded-xl border-2 border-rose-200 text-rose-600 font-bold hover:bg-rose-50 transition-colors flex justify-center items-center gap-2")
                i.bi.bi-x-circle
                | Hủy đơn hàng
                
  script.
    document.addEventListener('DOMContentLoaded', () => {
      const btnCancel = document.getElementById('btnCancelOrder');
      if (btnCancel) {
        btnCancel.addEventListener('click', () => {
          if (confirm('Bạn có chắc chắn muốn hủy đơn hàng này?')) {
            const orderId = btnCancel.getAttribute('data-id');
            fetch(`/order/cancel/${orderId}`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' }
            })
            .then(res => res.json())
            .then(data => {
              alert(data.message);
              window.location.reload();
            })
            .catch(err => {
              alert('Có lỗi xảy ra!');
            });
          }
        });
      }
    });