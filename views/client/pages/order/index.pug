extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  link(rel="stylesheet", href="/css/order.css")
  .checkout-page
    +alert-success(messages.success)
    
    .container
      .checkout-wrapper
        .checkout-left
          // Section 1: Thông tin giao hàng
          .checkout-section
            .section-header
              h2 1. Thông tin giao hàng
              a.edit-link(href="#") Chỉnh sửa
            
            .shipping-info
              .info-row
                span.info-label Người nhận:
                span.info-value= `${user.fullName} | ${user.phone}`
              .info-row
                span.info-label Địa chỉ giao:
                span.info-value= user.address
            
            .edit-form(style="display: none;" idUser=user._id)
              input.input-field(
                type="text",
                id="editFullName",
                value=user.fullName,
                placeholder="Họ và tên"
              )
              input.input-field(
                type="tel",
                id="editPhone",
                value=user.phone,
                placeholder="Số điện thoại"
              )
              input.input-field(
                type="text",
                id="editAddress",
                value=user.address,
                placeholder="Địa chỉ"
              )
              .form-actions
                button.btn-save(type="button") Lưu
                button.btn-cancel(type="button") Hủy

          // Section 2: Danh sách sản phẩm
          .checkout-section
            .section-header
              h2 2. Danh sách sản phẩm (#{products.length})
            
            .products-list
              each product in products
                .product-item
                  .product-image-detail
                    img(src=product.thumbnail, alt=product.title, loading="lazy")
                  
                  .product-info
                    h4= product.title
                    p.product-variant= `Phân loại: ${product.variantText || 'Mặc định'}`
                    p.product-price= `${Number(product.newPrice).toLocaleString('vi-VN')}₫`
                  
                  .product-quantity
                    span= `x${product.quantity}`
                  
                  .product-total
                    span= `${(product.newPrice * product.quantity).toLocaleString('vi-VN')}₫`
                  
                  .product-remove
                    button.btn-remove(type="button", data-product-id=product._id) ✕

          // Section 3: Voucher
          .checkout-section
            .section-header
              h2 3. Mã khuyến mãi
            
            .voucher-section
              .voucher-input-group
                input#voucherCode.input-field(
                  type="text",
                  placeholder="Nhập mã voucher",
                  value=appliedVoucher ? appliedVoucher.code : ''
                )
                button#applyVoucher.btn-apply(type="button") Áp dụng
              
              if availableVouchers && availableVouchers.length > 0
                .available-vouchers.mt-3
                  h5 Hoặc chọn mã có sẵn:
                  .voucher-list.d-flex.gap-2.flex-wrap
                    each v in availableVouchers
                      .voucher-tag(data-code=v.code, class=(appliedVoucher && appliedVoucher.code === v.code ? 'active' : ''))
                        span.fw-bold= v.code
                        span.text-muted(style="font-size: 11px; display: block;") Giảm #{v.discountPercentage}%
              
              if appliedVoucher
                .voucher-applied.mt-3
                  .voucher-info
                    span.voucher-code= appliedVoucher.code
                    span.voucher-discount= `Giảm ${appliedVoucher.discount}% (Tối đa ${appliedVoucher.maxDiscountAmount.toLocaleString('vi-VN')}đ)`
                  button.btn-remove-voucher(type="button") Xóa

          // Section 4: Phương thức thanh toán
          .checkout-section
            .section-header
              h2 4. Phương thức thanh toán
            
            .payment-methods
              each method in paymentMethods
                label.payment-method(data-method-id=method.id)
                  input(
                    type="radio",
                    name="paymentMethod",
                    value=method.id,
                    checked=method.id === 'credit_card'
                  )
                  .method-card
                    .method-icon= method.icon
                    .method-info
                      h4= method.name
                      p= method.description
                    .method-check ✓

        // Sidebar: Tổng hợp giá
        .checkout-right
          .order-summary
            .summary-header
              h3 Tóm tắt đơn hàng

            .summary-item
              span Tổng tiền hàng:
              span.price= `${subtotal.toLocaleString('vi-VN')}₫`

            if appliedVoucher
              .summary-item.discount
                span Giảm giá (#{appliedVoucher.discount}%):
                span.price= `-${discountAmount.toLocaleString('vi-VN')}₫`

            .summary-item.shipping
              span Phí vận chuyển:
              span.price= `${shippingFee.toLocaleString('vi-VN')}₫`

            .summary-divider

            .summary-item.total
              span Tổng thanh toán:
              span.price-total= `${total.toLocaleString('vi-VN')}₫`

            button#checkoutBtn.btn-checkout(type="button") Đặt hàng

            //- Toast notification
            #checkoutToast.checkout-toast(style="display:none;")
              span#toastMessage

            .payment-info
              p ✓ Bảo mật 100%
              p ✓ Miễn phí hoàn đơn
              p ✓ Hỗ trợ 24/7

  script(src='/js/order.js')