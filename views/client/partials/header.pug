include ../mixins/sub-menu.pug

//- Top Heading Bar (USP)
div(class="bg-surface-950 text-surface-50 text-[11px] font-medium tracking-wide py-2 hidden md:block")
  div(class="container mx-auto px-4 max-w-7xl flex justify-between items-center")
    div(class="flex gap-6 opacity-80")
      a(href="#" class="flex items-center gap-2 hover:text-brand-500 transition-colors")
        i.bi.bi-clock-history
        span GIAO HÀNG TRONG 2 GIỜ
      a(href="#" class="flex items-center gap-2 hover:text-brand-500 transition-colors")
        i.bi.bi-arrow-repeat
        span BẢO HÀNH ĐỔI MỚI 365 NGÀY
    div(class="flex gap-6 opacity-80")
      a(href="#" class="flex items-center gap-2 hover:text-brand-500 transition-colors")
        i.bi.bi-shield-check
        span CHÍNH HÃNG 100%
      a(href="#" class="flex items-center gap-2 hover:text-brand-500 transition-colors")
        i.bi.bi-headset
        span TƯ VẤN MIỄN PHÍ 24/7

//- Main Header
header(class="sticky top-0 z-[100] liquid-glass border-b border-slate-200/50 py-3 transition-all duration-300" id="mainHeader")
  div(class="container mx-auto px-4 max-w-7xl flex items-center justify-between gap-4")
    
    //- Logo
    div(class="flex-shrink-0")
      a(href="/" class="flex items-center gap-2 text-surface-950 font-black text-2xl tracking-tighter hover:scale-[1.02] transition-transform")
        if settingGeneral && settingGeneral.logo
          img(src=settingGeneral.logo alt="Logo" width="120" height="32" class="h-8 w-auto rounded-md")
        else
          img(src="/image/logo.png" alt="Logo" width="120" height="32" class="h-8 w-auto rounded-md")
        if settingGeneral && settingGeneral.websiteName
          span #{settingGeneral.websiteName}
        else
          span NVH
          span(class="text-brand-500") Mall
          
    //- Desktop Navigation
    nav(class="hidden lg:flex items-center gap-4 xl:gap-8 ml-4 xl:ml-8 flex-1")
      a(href="/" class="text-sm font-semibold text-surface-600 hover:text-brand-500 transition-colors whitespace-nowrap focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-md px-2 py-1") Trang chủ
      
      div(class="relative group")
        a(href="/product" class="text-sm font-semibold text-surface-600 hover:text-brand-500 transition-colors flex items-center gap-1 py-4 whitespace-nowrap focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-md px-2") 
          | Sản phẩm
          i(class="bi bi-chevron-down text-[10px] transition-transform group-hover:rotate-180")
        //- Mega Menu / Sub Menu Dropdown
        div(class="absolute top-full left-0 pt-2 z-50 w-64 custom-dropdown")
          div(class="bg-white rounded-2xl shadow-diffusion border border-slate-100 py-2")
            if(category && category.length > 0)
              +sub-menu(category, '/product')
            else
              a(href="/product" class="block px-6 py-3 text-sm font-medium text-surface-600 hover:bg-surface-50 hover:text-brand-500") Tất cả sản phẩm
            
      a(href="/articles" class="text-sm font-semibold text-surface-600 hover:text-brand-500 transition-colors whitespace-nowrap focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-md px-2 py-1") Tin tức
      a(href="/vouchers" class="text-sm font-semibold text-surface-600 hover:text-brand-500 transition-colors whitespace-nowrap focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-md px-2 py-1") Khuyến mãi
      a(href="/contact" class="text-sm font-semibold text-surface-600 hover:text-brand-500 transition-colors whitespace-nowrap focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-md px-2 py-1") Liên hệ

    //- Desktop Actions (Search, Cart, User)
    div(class="hidden lg:flex items-center gap-3 xl:gap-4 justify-end shrink-0")
      
      //- Search Bar
      form(action='/search' id="form-search" method='GET' class="relative group")
        input(type="text" aria-label="Tìm kiếm sản phẩm" placeholder="Tìm kiếm..." name="keyword" value=keyword class="w-48 xl:w-64 bg-surface-50 border border-slate-200 text-sm rounded-full px-4 py-2 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all group-hover:shadow-md")
        button(type="submit" aria-label="Tìm kiếm" class="absolute right-3 top-1/2 -translate-y-1/2 text-surface-400 hover:text-brand-500 transition-colors focus:outline-none focus:text-brand-500")
          i.bi.bi-search
          
      div(class="h-6 w-px bg-slate-200 mx-2")

      //- Wishlist
      if(user)
        a(href="/wishlist" class="relative text-surface-600 hover:text-brand-500 transition-colors hover:scale-110 p-2")
          i.bi.bi-heart.text-lg
          if(quantityWishlist !== undefined && quantityWishlist > 0)
            span(class="absolute top-0 right-0 w-4 h-4 bg-rose-500 text-white text-[10px] font-bold flex items-center justify-center rounded-full shadow-sm")= quantityWishlist

      //- Cart
      a(href="/cart" id="btn-cart" aria-label="Giỏ hàng" class="relative text-surface-600 hover:text-brand-500 transition-colors hover:scale-110 p-2 flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-brand-500/20 rounded-full")
        i.bi.bi-bag.text-lg
        span(id="desktop-cart-badge" class=`absolute top-0 right-0 w-4 h-4 bg-brand-500 text-white text-[10px] font-bold flex items-center justify-center rounded-full shadow-sm ${quantityCart ? '' : 'hidden'}`)= quantityCart || 0
            
      //- User Auth
      if (user)
        div(class="relative group ml-2")
          a(href="javascript:void(0)" class="flex items-center gap-2 py-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-full px-2")
            if user.avatar
              img(src=user.avatar alt="" width="32" height="32" class="w-8 h-8 rounded-full border border-slate-200 object-cover")
            else
              div(class="w-8 h-8 rounded-full bg-brand-100 text-brand-600 font-bold flex items-center justify-center text-xs")
                | #{user.fullName.charAt(0).toUpperCase()}
            i(class="bi bi-chevron-down text-[10px] text-surface-400 transition-transform group-hover:rotate-180")
            
          div(class="absolute top-full right-0 pt-2 z-50 min-w-[200px] custom-dropdown")
            div(class="bg-white rounded-2xl shadow-diffusion border border-slate-100 overflow-hidden py-2")
              div(class="px-4 py-3 border-b border-slate-100 mb-2 bg-surface-50")
                p(class="text-sm font-semibold text-surface-950 truncate") #{user.fullName}
                p(class="text-xs text-surface-500 truncate") #{user.email}
              a(href=`/my-account/${user._id}` class="flex items-center gap-3 px-4 py-2 text-sm font-medium text-surface-600 hover:bg-surface-50 hover:text-brand-500 transition-colors")
                i.bi.bi-person.text-lg
                | Tài khoản của tôi
              a(href="/loyalty" class="flex items-center gap-3 px-4 py-2 text-sm font-medium text-surface-600 hover:bg-surface-50 hover:text-brand-500 transition-colors")
                i.bi.bi-star.text-lg
                | Điểm thưởng
              a(href="/wishlist" class="flex items-center gap-3 px-4 py-2 text-sm font-medium text-surface-600 hover:bg-surface-50 hover:text-brand-500 transition-colors")
                i.bi.bi-heart.text-lg
                | Yêu thích
              a(href="/order/history" class="flex items-center gap-3 px-4 py-2 text-sm font-medium text-surface-600 hover:bg-surface-50 hover:text-brand-500 transition-colors")
                i.bi.bi-bag-check.text-lg
                | Đơn mua
              a(href="/my-account/vouchers" class="flex items-center gap-3 px-4 py-2 text-sm font-medium text-surface-600 hover:bg-surface-50 hover:text-brand-500 transition-colors")
                i.bi.bi-ticket-perforated.text-lg
                | Kho Voucher
              div(class="h-px bg-slate-100 my-2")
              a(href="/auth/logout" class="flex items-center gap-3 px-4 py-2 text-sm font-medium text-red-500 hover:bg-red-50 transition-colors")
                i.bi.bi-box-arrow-right.text-lg
                | Đăng xuất
      else
        a(href="/auth/login" class="btn-premium btn-primary ml-2 whitespace-nowrap") Đăng nhập

    //- Mobile Actions (Hamburger & Cart)
    div(class="flex lg:hidden items-center gap-4")
      button(type="button" id="mobileSearchToggle" aria-label="Mở tìm kiếm" class="text-surface-600 hover:text-brand-500 text-xl focus:outline-none")
        i.bi.bi-search
      a(href="/cart" aria-label="Giỏ hàng di động" class="relative text-surface-600 hover:text-brand-500 text-xl focus:outline-none")
        i.bi.bi-bag
        span(id="mobile-cart-badge" class=`absolute -top-1 -right-2 w-4 h-4 bg-brand-500 text-white text-[10px] font-bold flex items-center justify-center rounded-full shadow-sm ${quantityCart ? '' : 'hidden'}`)= quantityCart || 0
      button(type="button" id="mobileMenuToggle" aria-label="Mở menu" class="text-surface-950 text-2xl ml-2 focus:outline-none active:scale-95 transition-transform")
        i.bi.bi-list

  //- Mobile Search Dropdown
  div(class="absolute top-full left-0 w-full bg-white shadow-soft border-b border-surface-100 transition-all duration-300 origin-top scale-y-0 opacity-0" id="mobileSearchContainer")
    div(class="container mx-auto p-4")
      form(action='/search' method='GET' class="relative")
        input(type="text" placeholder="Tìm kiếm sản phẩm..." name="keyword" value=keyword class="input-premium py-3 rounded-2xl w-full")
        button(type="submit" class="absolute right-4 top-1/2 -translate-y-1/2 text-surface-400 text-lg hover:text-brand-500 transition-colors")
          i.bi.bi-search

  //- Mobile Menu Overlay
  div(id="mobileMenuOverlay" class="fixed inset-0 bg-surface-900/40 backdrop-blur-sm z-[1040] opacity-0 pointer-events-none transition-opacity duration-300")
  
  //- Mobile Menu Drawer (Pure Tailwind)
  nav(id="mobileMenuDrawer" class="fixed top-0 right-0 h-full w-[85vw] max-w-sm bg-white z-[1050] shadow-diffusion flex flex-col transform translate-x-full transition-transform duration-300 ease-in-out")
    div(class="flex items-center justify-between border-b border-surface-100 py-4 px-6")
      h5(class="text-lg font-bold flex items-center gap-2")
        img(src="/image/logo.png" alt="" width="90" height="24" class="h-6 w-auto rounded-sm")
        | NVH Mall
      button(type="button" id="mobileMenuClose" aria-label="Đóng menu" class="text-surface-500 hover:text-surface-900 focus:outline-none rounded-full p-1 hover:bg-surface-100 transition-colors")
        i.bi.bi-x-lg.text-xl
    
    div(class="flex-1 overflow-y-auto")
      //- Auth Mobile
      if user
        div(class="bg-brand-50 p-6 border-b border-brand-100/50")
          div(class="flex items-center gap-4 mb-4")
            if user.avatar
              img(src=user.avatar alt="" width="48" height="48" class="w-12 h-12 rounded-full border border-white shadow-sm object-cover")
            else
              div(class="w-12 h-12 rounded-full bg-brand-500 text-white font-bold flex items-center justify-center text-xl shadow-sm")
                | #{user.fullName.charAt(0).toUpperCase()}
            div
              p(class="font-bold text-surface-950 truncate") #{user.fullName}
              p(class="text-xs text-surface-500 truncate") #{user.email}
          div(class="grid grid-cols-2 gap-3")
            a(href=`/my-account/${user._id}` class="bg-white rounded-xl py-2.5 text-center text-sm font-medium text-surface-700 shadow-sm border border-surface-100 hover:border-brand-300 transition-colors") Tài khoản
            a(href="/order/history" class="bg-white rounded-xl py-2.5 text-center text-sm font-medium text-surface-700 shadow-sm border border-surface-100 hover:border-brand-300 transition-colors") Đơn hàng
      else
        div(class="p-6 border-b border-surface-100 flex flex-col gap-3")
          a(href="/auth/login" class="btn-premium btn-primary w-full") Đăng nhập
          a(href="/auth/register" class="btn-premium btn-secondary w-full") Đăng ký

      //- Links Mobile
      ul(class="flex flex-col py-2")
        li
          a(href="/" class="flex items-center gap-4 px-6 py-3.5 text-base font-medium text-surface-700 hover:bg-surface-50 active:bg-surface-100 transition-colors")
            i.bi.bi-house.text-xl.text-surface-400
            | Trang chủ
        li
          a(href="/product" class="flex items-center gap-4 px-6 py-3.5 text-base font-medium text-surface-700 hover:bg-surface-50 active:bg-surface-100 transition-colors")
            i.bi.bi-grid.text-xl.text-surface-400
            | Sản phẩm
        li
          a(href="/articles" class="flex items-center gap-4 px-6 py-3.5 text-base font-medium text-surface-700 hover:bg-surface-50 active:bg-surface-100 transition-colors")
            i.bi.bi-newspaper.text-xl.text-surface-400
            | Tin tức
        if user
          li
            a(href="/loyalty" class="flex items-center gap-4 px-6 py-3.5 text-base font-medium text-surface-700 hover:bg-surface-50 active:bg-surface-100 transition-colors")
              i.bi.bi-star.text-xl.text-surface-400
              | Điểm thưởng
          li
            a(href="/wishlist" class="flex items-center gap-4 px-6 py-3.5 text-base font-medium text-surface-700 hover:bg-surface-50 active:bg-surface-100 transition-colors")
              i.bi.bi-heart.text-xl.text-surface-400
              | Yêu thích
              if(quantityWishlist > 0)
                span(class="ml-auto bg-red-100 text-red-600 px-2 py-0.5 rounded-full text-xs font-bold")= quantityWishlist
        li
          a(href="/contact" class="flex items-center gap-4 px-6 py-3.5 text-base font-medium text-surface-700 hover:bg-surface-50 active:bg-surface-100 transition-colors")
            i.bi.bi-telephone.text-xl.text-surface-400
            | Liên hệ

      if user
        div(class="px-6 py-6 mt-6")
          a(href="/auth/logout" class="flex items-center justify-center gap-2 w-full py-3 bg-red-50 text-red-600 hover:bg-red-100 rounded-xl font-semibold active:scale-95 transition-all")
            i.bi.bi-box-arrow-right
            | Đăng xuất

script.
  document.addEventListener('DOMContentLoaded', function () {
    const isLogin = !{JSON.stringify(isLogin)};
    const cartBtn = document.getElementById('btn-cart');
    
    if (cartBtn) {
      cartBtn.addEventListener('click', function (e) {
        if (!isLogin) {
          e.preventDefault();
          alert('Bạn cần đăng nhập để xem giỏ hàng!');
        }
      });
    }

    // Shrink header on scroll
    const header = document.getElementById('mainHeader');
    window.addEventListener('scroll', () => {
      if(window.scrollY > 20) {
        header.classList.add('shadow-soft', 'backdrop-blur-xl', 'bg-white/80');
        header.classList.remove('liquid-glass', 'py-3');
        header.classList.add('py-2');
      } else {
        header.classList.add('liquid-glass', 'py-3');
        header.classList.remove('shadow-soft', 'backdrop-blur-xl', 'bg-white/80', 'py-2');
      }
    });

    // Mobile Search Toggle
    const searchToggle = document.getElementById('mobileSearchToggle');
    const searchContainer = document.getElementById('mobileSearchContainer');
    let searchOpen = false;
    if(searchToggle && searchContainer) {
      searchToggle.addEventListener('click', () => {
        searchOpen = !searchOpen;
        if(searchOpen) {
          searchContainer.classList.remove('scale-y-0', 'opacity-0');
          searchContainer.classList.add('scale-y-100', 'opacity-100');
        } else {
          searchContainer.classList.remove('scale-y-100', 'opacity-100');
          searchContainer.classList.add('scale-y-0', 'opacity-0');
        }
      });
    }

    // Mobile Menu Drawer
    const menuToggle = document.getElementById('mobileMenuToggle');
    const menuClose = document.getElementById('mobileMenuClose');
    const menuDrawer = document.getElementById('mobileMenuDrawer');
    const menuOverlay = document.getElementById('mobileMenuOverlay');
    
    function openMenu() {
      menuDrawer.classList.remove('translate-x-full');
      menuOverlay.classList.remove('opacity-0', 'pointer-events-none');
      document.body.style.overflow = 'hidden'; // Prevent scrolling
    }
    
    function closeMenu() {
      menuDrawer.classList.add('translate-x-full');
      menuOverlay.classList.add('opacity-0', 'pointer-events-none');
      document.body.style.overflow = '';
    }

    if(menuToggle) menuToggle.addEventListener('click', openMenu);
    if(menuClose) menuClose.addEventListener('click', closeMenu);
    if(menuOverlay) menuOverlay.addEventListener('click', closeMenu);
  });