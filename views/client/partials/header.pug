include ../mixins/sub-menu.pug

header.header 
  .container
    .row.align-items-center
      //- Logo
      .col-3
        .inner-logo 
          a(href="/")
            img(src="/image/logo.png", alt="Logo", class="logo")
      
      //- Search Bar
      .col-4 
        form(action='/search', id="form-search", method='GET')
          .input-group 
            input(
              type="text",
              placeholder="Nhập từ khóa...",
              name="keyword",
              value=keyword,
              class="form-control search-input"
            )
            button.btn.btn-primary(type="submit")
              i.bi.bi-search
              |  Tìm
      
      //- Menu
      .col-5
        .inner-menu
          ul  
            //- Cart Button
            li.cart-item
              form(action="/cart", method='GET', id='form-cart')
                button.btn-cart-icon(type="submit")
                  i.bi.bi-cart3
                  if(quantityCart)
                    .inner-quantity= quantityCart
            
            //- Home
            li
              a(href="/") 
                i.bi.bi-house-fill
                |  Trang chủ
            
            //- Products with Submenu
            li.sub-menu
              - const path='/product'
              a(href="/product")
                i.bi.bi-box-seam
                |  Sản phẩm
              if(category && category.length > 0)
                +sub-menu(category, path)
            
            //- Blog
            li
              a(href="/contact")
                i.bi.bi-file-text
                |  Bài viết
            //- Blog
            if(user)
              li
                a(href="/order/history")
                  i.bi.bi-file-text
                  |  Đơn hàng
            
            //- Auth Section
            if (user)
              li.auth-section
                a.btn.btn-auth-primary(href=`/my-account/${user._id}`)
                  i.bi.bi-person-circle
                  |  #{user.fullName}
                a.btn.btn-auth-danger(href="/auth/logout")
                  i.bi.bi-box-arrow-right
                  |  Đăng xuất
            else 
              li
                a.btn.btn-auth-primary(href="/auth/login")
                  i.bi.bi-box-arrow-in-right
                  |  Đăng nhập

  script.
    document.addEventListener('DOMContentLoaded', function () {
      const isLogin = !{JSON.stringify(isLogin)};
      const formCart = document.querySelector("#form-cart");
      const btn = document.querySelector('ul li form .btn-cart-icon');
      
      if (btn && formCart) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();

          if (!isLogin) {
            alert('Bạn cần đăng nhập để xem giỏ hàng!');
            return;
          }
          formCart.submit();
        });
      }
    });