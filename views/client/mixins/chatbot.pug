mixin chatbot()
        .chatbot-floating-btn#chatbotBtn
            i.bi.bi-chat-dots-fill
            .badge.badge-dot
                span New
        
        // Chat Modal
        #chatbotModal.chatbot-modal
            .chatbot-container
                .chatbot-header
                    h5.mb-0 
                        i.bi.bi-headset.me-2
                        | Chăm sóc khách hàng
                    button#closeChatbot(type="button" aria-label="Close" class="bg-transparent border-none text-white hover:text-gray-200 p-1 flex items-center justify-center")
                        i.bi.bi-x-lg.text-xl
                
                #chatbotMessages.chatbot-messages
                    .chat-message.bot-message
                        .message-content
                            p Xin chào! 👋 Tôi là trợ lý AI thông minh của shop. Bạn cần tôi hỗ trợ gì nào?
                
                .chatbot-input-area
                    .input-group
                        if user
                            input#chat-userid(type="hidden" value=(user.id || user._id))
                        input.form-control#chatInput(
                            type="text" 
                            placeholder="Nhập câu hỏi của bạn..." 
                            aria-label="Chat input"
                            autocomplete="off"
                        )
                        button.btn.btn-primary#sendBtn(type="button")
                            i.bi.bi-send-fill