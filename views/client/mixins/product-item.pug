mixin product-item(Item)
    div(class="snap-start shrink-0 w-[280px]")
        div(class="bg-white border border-slate-200/50 rounded-[2rem] p-4 flex flex-col h-full group hover:border-brand-500 hover:shadow-diffusion transition-all duration-500 cursor-pointer relative overflow-hidden")
            div(class="relative aspect-square w-full rounded-[1.5rem] overflow-hidden mb-4 bg-surface-50")
                a(href=`/product/detail/${Item.slug}`, title=Item.title, class="block w-full h-full") 
                    img(src=Item.thumbnail, alt=Item.title, loading="lazy", class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110")
                
                // ✅ Overlay badges
                if Item.featured === true
                    div(class="absolute top-3 left-3 bg-white/90 backdrop-blur-md px-3 py-1 rounded-full text-xs font-semibold text-brand-600 shadow-sm flex items-center") 
                        i.bi.bi-star-fill.mr-1
                        | Nổi bật
                
                if Item.discountPercentage > 0
                    div(class="absolute top-3 right-3 bg-rose-500 text-white px-2 py-1 rounded-lg text-xs font-bold shadow-md")
                        | -#{Item.discountPercentage}%
            
            div(class="flex flex-col flex-1") 
                a(href=`/product/detail/${Item.slug}`, title=Item.title, class="text-surface-900 font-semibold text-lg leading-tight line-clamp-2 mb-3 group-hover:text-brand-500 transition-colors") 
                    span= Item.title
                
                div(class="mt-auto")
                    div(class="text-xl font-bold text-surface-950")
                        | #{Number(Item.priceNew).toLocaleString('vi-VN')}₫
                    
                    if Item.price > Item.priceNew
                        div(class="text-sm text-surface-400 line-through mt-1")
                            | #{Item.price.toLocaleString('vi-VN')}₫