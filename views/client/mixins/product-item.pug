mixin product-item(Item)
    div(class="snap-start shrink-0 w-[160px] md:w-[240px] lg:w-[280px]")
        div(class="bg-white border border-surface-200/50 rounded-2xl p-4 flex flex-col h-full group hover:border-brand-500 hover:shadow-[0_10px_15px_-3px_rgba(0,0,0,0.1)] hover:-translate-y-1 transition-all duration-300 cursor-pointer relative overflow-hidden focus-within:ring-2 focus-within:ring-brand-500")
            div(class="relative aspect-square w-full rounded-xl overflow-hidden mb-4 bg-surface-50 flex items-center justify-center")
                a(href=`/product/detail/${Item.slug}`, title=Item.title, class="block w-full h-full focus-visible:outline-none") 
                    img(src=Item.thumbnail, alt=Item.title, loading="lazy", class="w-full h-full object-contain")
                
                // ✅ Overlay badges
                if Item.isFlashSale
                    div(class="absolute top-0 left-0 bg-gradient-to-r from-rose-500 to-orange-500 text-white px-3 py-1 rounded-br-2xl text-xs font-black shadow-md flex items-center gap-1 z-10")
                        i.bi.bi-lightning-fill
                        | FLASH SALE
                        
                if Item.featured === true && !Item.isFlashSale
                    div(class="absolute top-3 left-3 bg-white/90 backdrop-blur-md px-3 py-1 rounded-full text-xs font-semibold text-brand-600 shadow-sm flex items-center z-10") 
                        i.bi.bi-star-fill.mr-1
                        | Nổi bật
                
                if Item.discountPercentage > 0
                    div(class="absolute top-3 right-3 bg-rose-500 text-white px-2 py-1 rounded-lg text-xs font-bold shadow-md")
                        | -#{Item.discountPercentage}%
            
            div(class="flex flex-col flex-1") 
                a(href=`/product/detail/${Item.slug}`, title=Item.title, class="text-surface-900 font-semibold text-lg leading-tight line-clamp-2 mb-3 group-hover:text-brand-500 transition-colors") 
                    span= Item.title
                
                div(class="mt-auto")
                    div(class="text-xl font-bold text-surface-950")
                        | #{Number(Item.priceNew).toLocaleString('vi-VN')}₫
                    
                    if Item.price > Item.priceNew
                        div(class="text-sm text-surface-400 line-through mt-1 mb-2")
                            | #{Item.price.toLocaleString('vi-VN')}₫
                    
                    if Item.isFlashSale && Item.flashSale && Item.flashSale.quantityLimit
                        - const fsSold = Item.flashSale.soldQuantity || 0
                        - const fsTotal = Item.flashSale.quantityLimit
                        - const fsPercent = Math.min(100, Math.floor((fsSold / fsTotal) * 100))
                        div(class="relative w-full bg-rose-100 rounded-full h-3.5 overflow-hidden flex items-center mt-2")
                            div(class="absolute top-0 left-0 h-full bg-gradient-to-r from-rose-400 to-rose-600 rounded-full transition-all duration-1000" style=`width: ${fsPercent}%`)
                            div(class="absolute w-full text-center text-[9px] font-bold text-white z-10 drop-shadow-md")
                                if fsPercent >= 100
                                    | Đã bán hết
                                else
                                    | Đã bán #{fsSold}