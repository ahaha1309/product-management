mixin sub-menu(categories, path = '')
  ul(class="flex flex-col")
    each item in categories
      li(class="relative group")
        a(href=`${path}/c/${item.slug}` class="flex items-center justify-between px-6 py-3 text-sm font-medium text-surface-600 hover:bg-surface-50 hover:text-brand-500 transition-colors border-b border-slate-50 last:border-0")
          span #{item.title}
          if (item.children && item.children.length > 0)
            i(class="bi bi-chevron-right text-[10px] text-surface-400")
        
        if (item.children && item.children.length > 0)
          div(class="absolute top-0 left-full pl-2 z-50 w-56 custom-dropdown")
            div(class="bg-white rounded-xl shadow-diffusion border border-slate-100 py-2")
              +sub-menu(item.children, path)