# ===============================
# NODE & DEPENDENCIES
# ===============================
node_modules/

# (Tuỳ chọn: Nếu bạn muốn dùng yarn thì bỏ comment bên dưới)
# yarn.lock
# yarn-error.log

# ===============================
# ENVIRONMENT VARIABLES & SECRETS
# ===============================
.env
.env.*
config/service-account.json

# ===============================
# USER UPLOADS & DYNAMIC DATA
# ===============================
# Bỏ qua tất cả file trong thư mục uploads (tránh đẩy ảnh rác lên git)
public/uploads/*
# Nhưng giữ lại thư mục uploads bằng cách thêm file .gitkeep vào thư mục đó
!public/uploads/.gitkeep

# ===============================
# LOGS & CACHE
# ===============================
logs/
*.log
npm-debug.log*
yarn-debug.log*
.npm/
.eslintcache
.cache/

# ===============================
# RUNTIME & BUILD OUTPUT
# ===============================
pids/
*.pid
*.seed
*.pid.lock
dist/
build/
coverage/

# ===============================
# IDE & OS JUNK FILES
# ===============================
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
.AppleDouble
.LSOverride

# ===============================
# TEMP SCRIPTS & AI AGENTS DATA
# ===============================
tmp/
temp/
.agent/
.agents/
replace.js
skills-lock.json